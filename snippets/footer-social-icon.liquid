{%- comment -%}
  Renders an inline SVG icon for a social platform.
  Accepts:
    - name: 'facebook' | 'instagram' | 'tiktok' | 'youtube' | 'twitter' | 'pinterest' | 'linkedin'
{%- endcomment -%}
{%- case name -%}
  {%- when 'facebook' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M13.5 21v-7.5h2.55l.4-3h-2.95V8.62c0-.87.24-1.46 1.49-1.46H16.6V4.48c-.27-.04-1.2-.12-2.28-.12-2.25 0-3.8 1.38-3.8 3.9V10.5H7.96v3h2.56V21h2.98Z"/>
    </svg>
  {%- when 'instagram' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false" width="20" height="20">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M16.5 3h-2.7v12.1a2.55 2.55 0 1 1-2.55-2.55c.18 0 .35.02.52.06v-2.7a5.25 5.25 0 1 0 4.73 5.22V8.45a6.4 6.4 0 0 0 3.5 1.04V6.78A3.93 3.93 0 0 1 16.5 3Z"/>
    </svg>
  {%- when 'youtube' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.3 5 12 5 12 5s-6.3 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.7 19 12 19 12 19s6.3 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 14.8V9.2l5 2.8-5 2.8Z"/>
    </svg>
  {%- when 'twitter' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M17.6 3h3.1l-6.77 7.74L22 21h-6.23l-4.88-6.4L5.3 21H2.18l7.25-8.28L2 3h6.4l4.4 5.83L17.6 3Zm-1.09 16.1h1.72L7.57 4.8H5.74l10.77 14.3Z"/>
    </svg>
  {%- when 'pinterest' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M12 3a9 9 0 0 0-3.28 17.38c-.08-.74-.15-1.87.03-2.68.16-.73 1.05-4.65 1.05-4.65s-.27-.54-.27-1.33c0-1.25.73-2.18 1.63-2.18.77 0 1.14.58 1.14 1.27 0 .77-.49 1.93-.75 3-.22.9.45 1.63 1.33 1.63 1.6 0 2.83-1.69 2.83-4.12 0-2.16-1.55-3.66-3.77-3.66-2.57 0-4.08 1.93-4.08 3.92 0 .78.3 1.61.67 2.07.07.09.08.16.06.25l-.25 1c-.04.16-.13.2-.3.12-1.1-.51-1.79-2.12-1.79-3.41 0-2.77 2.01-5.32 5.8-5.32 3.05 0 5.42 2.17 5.42 5.07 0 3.03-1.91 5.47-4.56 5.47-.89 0-1.73-.46-2.02-1l-.55 2.1c-.2.77-.74 1.74-1.1 2.33A9 9 0 1 0 12 3Z"/>
    </svg>
  {%- when 'linkedin' -%}
    <svg class="footer__social-svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="20" height="20">
      <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.3 8.5h3.32V21H3.3V8.5Zm5.5 0h3.18v1.7h.05c.44-.82 1.51-1.7 3.11-1.7 3.33 0 3.95 2.13 3.95 4.9V21h-3.31v-6.16c0-1.47-.03-3.36-2.07-3.36s-2.4 1.6-2.4 3.26V21H8.8V8.5Z"/>
    </svg>
{%- endcase -%}
