{% doc %}
  Landing-page closing call-to-action panel with an ambient animated
  gradient backdrop built from the accent color. Self-contained palette.
{% enddoc %}

<section class="lp-cta" style="--lp-heading-scale: {{ block.settings.heading_scale | default: 100 | divided_by: 100.0 }}; --lp-text-scale: {{ block.settings.text_scale | default: 100 | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
  <div class="lp-cta__inner">
    <div class="lp-cta__panel">
      <div class="lp-cta__glow" aria-hidden="true"></div>
      <div class="lp-cta__content">
        {%- if block.settings.eyebrow != blank -%}
          <span class="lp-cta__eyebrow">{{ block.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="lp-cta__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="lp-cta__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
          <div class="lp-cta__actions">
            {%- if block.settings.primary_label != blank -%}
              <a class="lp-cta__btn lp-cta__btn--primary" href="{{ block.settings.primary_url | default: '#' }}">
                {{ block.settings.primary_label | escape }}
                <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
            {%- if block.settings.secondary_label != blank -%}
              <a class="lp-cta__btn lp-cta__btn--secondary" href="{{ block.settings.secondary_url | default: '#' }}">
                {{ block.settings.secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .lp-cta {
    background: var(--lp-bg, var(--color-background, #fff));
    color: var(--lp-text, var(--color-foreground, #1f2328));
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .lp-cta__inner {
    max-width: var(--lp-maxw, var(--page-width, 90rem));
    margin-inline: auto;
    padding-inline: var(--lp-pad-x, var(--page-margin, 20px));
  }
  .lp-cta__panel {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    background: var(--lp-accent, #4a7cff);
    color: var(--lp-on-accent, #fff);
    isolation: isolate;
    text-align: center;
  }
  .lp-cta__glow {
    position: absolute;
    inset: -40%;
    z-index: -1;
    background:
      conic-gradient(from 0deg,
        color-mix(in srgb, #fff 0%, transparent),
        color-mix(in srgb, #fff 28%, transparent),
        color-mix(in srgb, #000 22%, transparent),
        color-mix(in srgb, #fff 24%, transparent),
        color-mix(in srgb, #fff 0%, transparent));
    filter: blur(60px);
    opacity: 0.55;
    animation: lp-cta-spin 18s linear infinite;
  }

  .lp-cta__content { position: relative; max-width: 46rem; margin-inline: auto; }
  .lp-cta__eyebrow {
    display: inline-block;
    font-size: calc(0.8rem * var(--lp-text-scale, 1));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
    margin-bottom: 0.75rem;
  }
  .lp-cta__heading {
    margin: 0;
    font-size: calc(clamp(1.8rem, 5vw, 3.25rem) * var(--lp-heading-scale, 1));
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lp-cta__text {
    margin: 1rem auto 0;
    max-width: 38rem;
    font-size: calc(clamp(1rem, 1.8vw, 1.2rem) * var(--lp-text-scale, 1));
    line-height: 1.55;
    opacity: 0.92;
  }
  .lp-cta__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
  .lp-cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.95rem 1.7rem;
    border-radius: 0;
    font-weight: 700;
    font-size: calc(1rem * var(--lp-text-scale, 1));
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .lp-cta__btn span { transition: transform 0.15s ease; }
  .lp-cta__btn--primary {
    background: var(--lp-on-accent, #fff);
    color: var(--lp-accent, #4a7cff);
  }
  .lp-cta__btn--primary:hover { transform: translateY(-2px); }
  .lp-cta__btn--primary:hover span { transform: translateX(3px); }
  .lp-cta__btn--secondary {
    background: transparent;
    color: var(--lp-on-accent, #fff);
    border-color: color-mix(in srgb, var(--lp-on-accent, #fff) 55%, transparent);
  }
  .lp-cta__btn--secondary:hover { border-color: var(--lp-on-accent, #fff); }

  @keyframes lp-cta-spin {
    to { transform: rotate(1turn); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-cta__glow { animation: none; }
    .lp-cta__btn, .lp-cta__btn span { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bereit für planbares Wachstum?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Lass uns in einem kostenlosen Audit herausfinden, wo dein größter Hebel liegt."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Kostenloses Audit anfragen"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Erstgespräch buchen"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "LP · CTA",
      "category": "Landing"
    }
  ]
}
{% endschema %}
