{% doc %}
  NetImpulse services deck. A vertical sticky stack: each ni-deck-card
  child sticks near the top while the next one scrolls up and layers over
  it. Full-bleed background with a soft radial wash and a closing note.
{% enddoc %}

<ni-deck class="ni-deck" {{ block.shopify_attributes }}>
  <div class="ni-deck__shell">
    <header class="ni-deck__head ni-reveal">
      <div>
        {%- if block.settings.kicker != blank -%}
          <span class="ni-deck__kicker">{{ block.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="ni-deck__title">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if block.settings.text != blank -%}
        <p class="ni-deck__text">{{ block.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="ni-deck__stack">
      {% content_for 'blocks' %}
    </div>

    {%- if block.settings.note != blank -%}
      <p class="ni-deck__note ni-reveal">{{ block.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</ni-deck>

{% stylesheet %}
  .ni-deck {
    --ni-bg: var(--lp-bg, #f8f6f1);
    --ni-paper: var(--lp-surface, #fffdf8);
    --ni-text: var(--lp-text, #050505);
    --ni-muted: var(--lp-muted, #6b665e);
    --ni-sand: #ebe3d4;
    --ni-line: var(--lp-line, rgba(5, 5, 5, 0.12));

    display: block;
    position: relative;
    background: var(--ni-bg);
    color: var(--ni-text);
    padding-block: clamp(84px, 10vw, 150px) clamp(40px, 8vw, 110px);
  }
  .ni-deck::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 10% 8%, color-mix(in srgb, var(--ni-sand) 55%, transparent), transparent 34rem),
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--ni-paper) 80%, transparent), transparent 28rem);
  }
  .ni-deck__shell {
    position: relative;
    width: min(var(--lp-maxw, 1440px), calc(100% - 54px));
    margin-inline: auto;
  }

  .ni-deck__head {
    display: flex;
    justify-content: space-between;
    gap: 34px;
    align-items: flex-end;
    margin-bottom: 44px;
  }
  .ni-deck__kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ni-muted);
    font-size: 0.92rem;
    margin-bottom: 16px;
  }
  .ni-deck__kicker::before { content: ""; width: 30px; height: 1px; background: var(--ni-text); }
  .ni-deck__title {
    margin: 0;
    max-width: 820px;
    font-size: clamp(2.9rem, 5.7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.078em;
  }
  .ni-deck__text { margin: 0; max-width: 460px; color: var(--ni-muted); font-size: 1.06rem; line-height: 1.62; }

  .ni-deck__stack { position: relative; margin-top: 58px; padding-bottom: 14vh; }
  .ni-deck__stack > .shopify-block { display: contents; }

  .ni-deck__note {
    margin-top: 24px;
    max-width: 700px;
    color: var(--ni-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .ni-deck.is-ready .ni-reveal { opacity: 0; transform: translateY(60px); transition: opacity 800ms ease, transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ni-deck.is-ready .ni-reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1120px) {
    .ni-deck__head { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 820px) {
    .ni-deck__shell { width: min(100% - 28px, var(--lp-maxw, 1440px)); }
    .ni-deck__stack { margin-top: 34px; padding-bottom: 4vh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-deck.is-ready .ni-reveal { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  class NiDeck extends HTMLElement {
    connectedCallback() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = this.querySelectorAll('.ni-reveal');
      if (reduce || !('IntersectionObserver' in window) || items.length === 0) return;
      this.classList.add('is-ready');
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            this.observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      items.forEach((el) => this.observer.observe(el));
    }
    disconnectedCallback() { if (this.observer) this.observer.disconnect(); }
  }
  if (!customElements.get('ni-deck')) customElements.define('ni-deck', NiDeck);
{% endjavascript %}

