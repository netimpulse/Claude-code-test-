{% doc %}
  NetImpulse company introduction. A section header plus a two-column
  body: a stack of editorial cards (ni-intro-card child blocks) on the
  left and an image panel with copy on the right.
{% enddoc %}

<ni-intro class="ni-intro" {{ block.shopify_attributes }}>
  <div class="ni-intro__shell">
    <header class="ni-intro__head ni-reveal">
      <div>
        {%- if block.settings.kicker != blank -%}
          <span class="ni-intro__kicker">{{ block.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="ni-intro__title">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if block.settings.text != blank -%}
        <p class="ni-intro__text">{{ block.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="ni-intro__grid">
      <div class="ni-intro__cards">
        {% content_for 'blocks' %}
      </div>

      <article class="ni-intro__panel ni-reveal">
        <div class="ni-intro__panel-media">
          {%- if block.settings.panel_image != blank -%}
            {%- assign p_alt = block.settings.panel_image.alt | default: block.settings.panel_heading | escape -%}
            {{
              block.settings.panel_image
              | image_url: width: 1300
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 1120px) 52vw, 100vw',
                widths: '500, 800, 1100, 1300',
                alt: p_alt,
                class: 'ni-intro__panel-img'
            }}
          {%- else -%}
            <div class="ni-intro__panel-img ni-intro__panel-img--ph" aria-hidden="true"></div>
          {%- endif -%}
        </div>
        <div class="ni-intro__panel-copy">
          {%- if block.settings.panel_heading != blank -%}
            <h3>{{ block.settings.panel_heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.panel_text != blank -%}
            <p>{{ block.settings.panel_text | escape }}</p>
          {%- endif -%}
        </div>
      </article>
    </div>
  </div>
</ni-intro>

{% stylesheet %}
  .ni-intro {
    --ni-bg: var(--lp-bg, #f8f6f1);
    --ni-paper: var(--lp-surface, #fffdf8);
    --ni-text: var(--lp-text, #050505);
    --ni-muted: var(--lp-muted, #6b665e);
    --ni-sand: #ebe3d4;
    --ni-paper-2: #f1eadf;
    --ni-line: var(--lp-line, rgba(5, 5, 5, 0.12));
    --ni-line-strong: var(--lp-line-strong, rgba(5, 5, 5, 0.22));
    --ni-shadow: 0 26px 70px rgba(33, 28, 20, 0.11);

    display: block;
    background: var(--ni-bg);
    color: var(--ni-text);
    padding-block: clamp(74px, 9vw, 140px);
  }
  .ni-intro__shell {
    width: min(var(--lp-maxw, 1440px), calc(100% - 54px));
    margin-inline: auto;
  }

  .ni-intro__head {
    display: flex;
    justify-content: space-between;
    gap: 34px;
    align-items: flex-end;
    margin-bottom: 44px;
  }
  .ni-intro__kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ni-muted);
    font-size: 0.92rem;
    margin-bottom: 16px;
  }
  .ni-intro__kicker::before { content: ""; width: 30px; height: 1px; background: var(--ni-text); }
  .ni-intro__title {
    margin: 0;
    max-width: 820px;
    font-size: clamp(2.9rem, 5.7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.078em;
  }
  .ni-intro__text {
    margin: 0;
    max-width: 460px;
    color: var(--ni-muted);
    font-size: 1.06rem;
    line-height: 1.62;
  }

  .ni-intro__grid {
    display: grid;
    grid-template-columns: 0.96fr 1.04fr;
    gap: 32px;
    align-items: center;
  }
  .ni-intro__cards { display: grid; grid-template-columns: 1fr; gap: 22px; }
  .ni-intro__cards > .shopify-block { display: contents; }

  .ni-intro__panel {
    background: var(--ni-paper-2);
    border: 1px solid var(--ni-line);
    min-height: 700px;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    box-shadow: var(--ni-shadow);
  }
  .ni-intro__panel-media { position: relative; min-height: 430px; }
  .ni-intro__panel-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ni-intro__panel-img--ph {
    background:
      linear-gradient(180deg, rgba(248, 246, 241, 0.05), rgba(248, 246, 241, 0.28)),
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ni-text) 5%, transparent) 0 16px, transparent 16px 32px),
      var(--ni-sand);
  }
  .ni-intro__panel-copy { padding: clamp(28px, 4vw, 54px); }
  .ni-intro__panel-copy h3 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 3.7vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: -0.07em;
  }
  .ni-intro__panel-copy p { margin: 0; color: var(--ni-muted); font-size: 1.06rem; line-height: 1.62; max-width: 620px; }

  .ni-intro.is-ready .ni-reveal { opacity: 0; transform: translateY(60px); transition: opacity 800ms ease, transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ni-intro.is-ready .ni-reveal.is-visible { opacity: 1; transform: none; }

  @media (max-width: 1120px) {
    .ni-intro__grid { grid-template-columns: 1fr; }
    .ni-intro__head { flex-direction: column; align-items: flex-start; }
    .ni-intro__panel { min-height: auto; }
  }
  @media (max-width: 820px) {
    .ni-intro__shell { width: min(100% - 28px, var(--lp-maxw, 1440px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-intro.is-ready .ni-reveal { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  class NiIntro extends HTMLElement {
    connectedCallback() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = this.querySelectorAll('.ni-reveal');
      if (reduce || !('IntersectionObserver' in window) || items.length === 0) return;
      this.classList.add('is-ready');
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            this.observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      items.forEach((el) => this.observer.observe(el));
    }
    disconnectedCallback() { if (this.observer) this.observer.disconnect(); }
  }
  if (!customElements.get('ni-intro')) customElements.define('ni-intro', NiIntro);
{% endjavascript %}

{% schema %}
{
  "name": "NI · Intro",
  "blocks": [{ "type": "ni-intro-card" }],
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Unternehmensvorstellung"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ein Studio für digitale Auftritte mit System."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Wir verbinden Online-Marketing, Webdesign und Shopify-Entwicklung, damit aus einzelnen Maßnahmen ein klarer digitaler Auftritt entsteht."
    },
    {
      "type": "header",
      "content": "Image panel"
    },
    { "type": "image_picker", "id": "panel_image", "label": "Panel image" },
    { "type": "textarea", "id": "panel_heading", "label": "Panel heading", "default": "Von der ersten Idee bis zur laufenden Optimierung." },
    { "type": "textarea", "id": "panel_text", "label": "Panel text", "default": "Ob Relaunch, SEO-Aufbau, Google Ads oder Shopify-Theme: Wir bauen digitale Grundlagen, die nicht nur beim Launch gut aussehen, sondern im Alltag messbar weiterarbeiten." }
  ],
  "presets": [
    {
      "name": "NI · Intro",
      "category": "Landing",
      "blocks": [
        {
          "type": "ni-intro-card",
          "settings": { "width": "full", "icon": "net", "title": "Strategie statt Einzelmaßnahmen", "text": "Wir starten nicht mit einem beliebigen Kanal, sondern mit der Frage, wo Sichtbarkeit, Vertrauen und Conversion aktuell am meisten Wirkung erzeugen." }
        },
        {
          "type": "ni-intro-card",
          "settings": { "width": "inset-1", "icon": "chart", "title": "Design, das nicht nur dekoriert", "text": "Jede Seite soll schneller erklären, hochwertiger wirken und Besucher gezielter führen – ohne überladene Effekte oder generische Marketing-Optik." }
        },
        {
          "type": "ni-intro-card",
          "settings": { "width": "inset-2", "icon": "window", "title": "Shopify als skalierbares System", "text": "Wir denken Websites und Shops so, dass Inhalte gepflegt, Kampagnen erweitert und neue Sections oder Themes sauber ergänzt werden können." }
        }
      ]
    }
  ]
}
{% endschema %}
