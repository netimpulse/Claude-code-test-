{% doc %}
  A single service card inside NI · Deck. Sticks near the top of the
  viewport while scrolling so the next card layers over it. The tone
  option sets its paper/dark background.
{% enddoc %}

{%- liquid
  assign tone = block.settings.tone | default: 'light'
  assign url = block.settings.link_url
-%}

<article class="ni-deck-card ni-deck-card--{{ tone }}" {{ block.shopify_attributes }}>
  <div class="ni-deck-card__copy">
    <div class="ni-deck-card__topline">
      <span>{{ block.settings.number | escape }}</span>
      <span>{{ block.settings.label | escape }}</span>
    </div>
    <div class="ni-deck-card__lede">
      {%- if block.settings.title != blank -%}
        <h3 class="ni-deck-card__title">{{ block.settings.title | escape }}</h3>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <p class="ni-deck-card__text">{{ block.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <div class="ni-deck-card__actions">
      <div class="ni-deck-card__tags">
        {%- if block.settings.tag_1 != blank -%}<span>{{ block.settings.tag_1 | escape }}</span>{%- endif -%}
        {%- if block.settings.tag_2 != blank -%}<span>{{ block.settings.tag_2 | escape }}</span>{%- endif -%}
        {%- if block.settings.tag_3 != blank -%}<span>{{ block.settings.tag_3 | escape }}</span>{%- endif -%}
      </div>
      {%- if url != blank -%}
        <a class="ni-deck-card__link" href="{{ url }}" aria-label="{{ block.settings.title | escape }}">→</a>
      {%- endif -%}
    </div>
  </div>

  <div class="ni-deck-card__visual" aria-hidden="true">
    <div class="ni-device">
      <div class="ni-device__bar">
        <div class="ni-device__dots"><span></span><span></span><span></span></div>
        {%- if block.settings.device_label != blank -%}
          <div class="ni-device__label">{{ block.settings.device_label | escape }}</div>
        {%- endif -%}
      </div>
      <div class="ni-device__lines"><span></span><span></span><span></span><span></span></div>
      <div class="ni-device__metrics"><span></span><span></span><span></span></div>
    </div>
  </div>
</article>

{% stylesheet %}
  .ni-deck-card {
    position: sticky;
    top: 24px;
    min-height: min(74vh, 720px);
    margin-bottom: 24vh;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: stretch;
    border: 1px solid var(--lp-line, rgba(5, 5, 5, 0.12));
    border-radius: 46px;
    background: var(--lp-surface, #fffdf8);
    color: var(--lp-text, #050505);
    box-shadow: 0 34px 90px rgba(33, 28, 20, 0.16);
    overflow: hidden;
  }
  .ni-deck-card:last-child { margin-bottom: 0; }

  .ni-deck-card--sand { background: #f0e7d8; }
  .ni-deck-card--sand-deep { background: #e3d6c4; }
  .ni-deck-card--cream { background: #fffaf0; }
  .ni-deck-card--dark { background: #181817; color: #fffdf8; border-color: rgba(255, 253, 248, 0.16); }

  .ni-deck-card__copy {
    padding: clamp(34px, 5vw, 76px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: inherit;
  }
  .ni-deck-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    opacity: 0.64;
    font-size: 0.9rem;
  }
  .ni-deck-card__title {
    margin: 70px 0 26px;
    max-width: 760px;
    font-size: clamp(3rem, 6.5vw, 7.6rem);
    line-height: 0.88;
    letter-spacing: -0.086em;
  }
  .ni-deck-card__text {
    margin: 0;
    max-width: 610px;
    opacity: 0.72;
    font-size: clamp(1.02rem, 1.2vw, 1.18rem);
    line-height: 1.66;
  }
  .ni-deck-card__actions {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
  }
  .ni-deck-card__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .ni-deck-card__tags span {
    border: 1px solid currentColor;
    opacity: 0.66;
    border-radius: 999px;
    padding: 8px 12px;
    font-size: 0.78rem;
    font-weight: 740;
  }
  .ni-deck-card__link {
    flex: 0 0 auto;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 1px solid currentColor;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: 180ms ease;
  }
  .ni-deck-card:hover .ni-deck-card__link {
    transform: translate(7px, -7px);
    background: currentColor;
    color: var(--lp-bg, #f8f6f1);
  }
  .ni-deck-card--dark:hover .ni-deck-card__link { color: #181817; }

  .ni-deck-card__visual {
    position: relative;
    min-height: inherit;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-left: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    background: linear-gradient(135deg, color-mix(in srgb, var(--lp-surface, #fffdf8) 28%, transparent), transparent);
  }
  .ni-deck-card__visual::before,
  .ni-deck-card__visual::after {
    content: "";
    position: absolute;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .ni-deck-card__visual::before { width: min(38vw, 520px); height: min(38vw, 520px); opacity: 0.1; }
  .ni-deck-card__visual::after { width: min(24vw, 330px); height: min(24vw, 330px); opacity: 0.08; }

  .ni-device {
    position: relative;
    z-index: 1;
    width: min(420px, 72%);
    aspect-ratio: 1.08 / 1;
    padding: 26px;
    border: 1px solid currentColor;
    background: color-mix(in srgb, var(--lp-surface, #fffdf8) 46%, transparent);
    box-shadow: 0 28px 70px rgba(33, 28, 20, 0.12);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 18px;
  }
  .ni-device__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; opacity: 0.65; }
  .ni-device__dots { display: flex; gap: 6px; }
  .ni-device__dots span { width: 8px; height: 8px; border-radius: 50%; background: currentColor; opacity: 0.4; }
  .ni-device__label { font-size: 0.76rem; font-weight: 760; letter-spacing: 0.04em; text-transform: uppercase; }
  .ni-device__lines { display: grid; align-content: center; gap: 13px; }
  .ni-device__lines span { height: 13px; background: currentColor; opacity: 0.78; }
  .ni-device__lines span:nth-child(1) { width: 78%; height: 24px; }
  .ni-device__lines span:nth-child(2) { width: 54%; opacity: 0.3; }
  .ni-device__lines span:nth-child(3) { width: 88%; opacity: 0.22; }
  .ni-device__lines span:nth-child(4) { width: 64%; opacity: 0.22; }
  .ni-device__metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .ni-device__metrics span { min-height: 58px; border: 1px solid currentColor; opacity: 0.25; }

  @media (max-width: 820px) {
    .ni-deck-card {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
      min-height: auto;
      margin-bottom: 20px;
      border-radius: 28px;
    }
    .ni-deck-card__copy { min-height: auto; padding: 30px; }
    .ni-deck-card__title { margin-top: 46px; font-size: clamp(3rem, 14vw, 4.8rem); }
    .ni-deck-card__actions { flex-direction: column; align-items: flex-start; }
    .ni-deck-card__visual { min-height: 320px; border-left: none; border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent); }
    .ni-device { width: min(340px, 82%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-deck-card__link { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NI · Deck card",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "light", "label": "Light (paper)" },
        { "value": "sand", "label": "Sand" },
        { "value": "sand-deep", "label": "Sand deep" },
        { "value": "dark", "label": "Dark" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "light"
    },
    { "type": "text", "id": "number", "label": "Number", "default": "01" },
    { "type": "text", "id": "label", "label": "Label", "default": "SEO" },
    { "type": "text", "id": "title", "label": "Title", "default": "Gefunden werden" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Eine kurze Beschreibung dieser Leistung." },
    {
      "type": "header",
      "content": "Tags"
    },
    { "type": "text", "id": "tag_1", "label": "Tag 1", "default": "Strategie" },
    { "type": "text", "id": "tag_2", "label": "Tag 2" },
    { "type": "text", "id": "tag_3", "label": "Tag 3" },
    {
      "type": "header",
      "content": "Visual & link"
    },
    { "type": "text", "id": "device_label", "label": "Device label", "default": "Dashboard" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [
    {
      "name": "NI · Deck card",
      "category": "Landing"
    }
  ]
}
{% endschema %}
