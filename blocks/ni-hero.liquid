{% doc %}
  NetImpulse landing hero — editorial split layout with an oversized
  headline, label line, dual CTA and a media panel with a live caption
  and a floating "book a call" tag.

  Uses the shared --lp-* palette (from the Landingpage section / color
  scheme) with the warm sand design tokens as fallbacks, so it also
  works standalone.
{% enddoc %}

<ni-hero class="ni-hero" {{ block.shopify_attributes }}>
  <div class="ni-hero__shell">
    <div class="ni-hero__content ni-reveal">
      {%- if block.settings.label != blank -%}
        <span class="ni-hero__label">{{ block.settings.label | escape }}</span>
      {%- endif -%}
      {%- if block.settings.heading != blank -%}
        <h1 class="ni-hero__title">{{ block.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if block.settings.body != blank -%}
        <p class="ni-hero__copy">{{ block.settings.body | escape }}</p>
      {%- endif -%}
      {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
        <div class="ni-hero__actions">
          {%- if block.settings.primary_label != blank -%}
            <a class="ni-btn ni-btn--primary" href="{{ block.settings.primary_url | default: '#' }}">{{ block.settings.primary_label | escape }}</a>
          {%- endif -%}
          {%- if block.settings.secondary_label != blank -%}
            <a class="ni-btn ni-btn--ghost" href="{{ block.settings.secondary_url | default: '#' }}">{{ block.settings.secondary_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ni-hero__media ni-reveal">
      <div class="ni-hero__photo">
        {%- if block.settings.image != blank -%}
          {%- assign img_alt = block.settings.image.alt | default: block.settings.heading | escape -%}
          {{
            block.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 1120px) 52vw, 100vw',
              widths: '600, 900, 1200, 1500',
              alt: img_alt,
              class: 'ni-hero__img'
          }}
        {%- else -%}
          <div class="ni-hero__img ni-hero__img--ph" aria-hidden="true"></div>
        {%- endif -%}

        {%- if block.settings.caption_title != blank or block.settings.caption_text != blank -%}
          <div class="ni-hero__caption">
            <span class="ni-pulse" aria-hidden="true"></span>
            <div>
              {%- if block.settings.caption_title != blank -%}<b>{{ block.settings.caption_title | escape }}</b>{%- endif -%}
              {%- if block.settings.caption_text != blank -%}<span>{{ block.settings.caption_text | escape }}</span>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if block.settings.book_label != blank -%}
        <a class="ni-hero__book" href="{{ block.settings.book_url | default: '#' }}">
          <span class="ni-cal" aria-hidden="true"></span>
          {{ block.settings.book_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</ni-hero>

{% stylesheet %}
  .ni-hero {
    --ni-bg: var(--lp-bg, #f8f6f1);
    --ni-paper: var(--lp-surface, #fffdf8);
    --ni-text: var(--lp-text, #050505);
    --ni-soft: color-mix(in srgb, var(--lp-text, #050505) 86%, #f8f6f1);
    --ni-muted: var(--lp-muted, #6b665e);
    --ni-sand: #ebe3d4;
    --ni-line: var(--lp-line, rgba(5, 5, 5, 0.12));
    --ni-line-strong: var(--lp-line-strong, rgba(5, 5, 5, 0.22));
    --ni-shadow: 0 26px 70px rgba(33, 28, 20, 0.11);

    display: block;
    position: relative;
    background: var(--ni-bg);
    color: var(--ni-text);
    overflow: hidden;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3.5rem, 7vw, 6rem);
  }
  .ni-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 8% 10%, color-mix(in srgb, var(--ni-sand) 60%, transparent), transparent 26rem),
      radial-gradient(circle at 92% 18%, color-mix(in srgb, var(--ni-paper) 80%, transparent), transparent 30rem);
  }

  .ni-hero__shell {
    position: relative;
    width: min(var(--lp-maxw, 1440px), calc(100% - 54px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 0.96fr 1.04fr;
    gap: clamp(44px, 7vw, 120px);
    align-items: center;
    min-height: min(86vh, 880px);
  }

  .ni-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    color: var(--ni-soft);
    font-size: 0.96rem;
  }
  .ni-hero__label::before { content: ""; width: 28px; height: 1px; background: var(--ni-text); }

  .ni-hero__title {
    margin: 0;
    max-width: 780px;
    font-size: clamp(3.4rem, 7.4vw, 8.9rem);
    line-height: 0.98;
    letter-spacing: -0.082em;
    font-weight: 860;
  }
  .ni-hero__copy {
    margin: clamp(28px, 4vw, 46px) 0 0;
    max-width: 620px;
    font-size: clamp(1.15rem, 1.75vw, 1.82rem);
    line-height: 1.55;
    color: var(--ni-soft);
    letter-spacing: -0.03em;
  }
  .ni-hero__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: clamp(30px, 4vw, 44px);
  }

  .ni-btn {
    border: 1px solid transparent;
    border-radius: 0;
    min-height: 58px;
    padding: 0 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 760;
    cursor: pointer;
    transition: 180ms ease;
  }
  .ni-btn--primary {
    background: var(--ni-sand);
    color: var(--ni-text);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }
  .ni-btn--primary:hover { background: var(--ni-text); color: var(--ni-paper); transform: translateY(-2px); }
  .ni-btn--ghost {
    border-color: var(--ni-line-strong);
    background: color-mix(in srgb, var(--ni-paper) 55%, transparent);
  }
  .ni-btn--ghost:hover { background: var(--ni-paper); transform: translateY(-2px); }

  .ni-hero__media { position: relative; align-self: stretch; display: flex; align-items: center; }
  .ni-hero__photo {
    position: relative;
    width: 100%;
    height: min(74vh, 620px);
    min-height: 420px;
    overflow: hidden;
    box-shadow: var(--ni-shadow);
  }
  .ni-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ni-hero__img--ph {
    background:
      linear-gradient(90deg, rgba(5, 5, 5, 0.16), rgba(5, 5, 5, 0.01)),
      repeating-linear-gradient(45deg, color-mix(in srgb, var(--ni-text) 6%, transparent) 0 14px, transparent 14px 28px),
      var(--ni-sand);
  }

  .ni-hero__caption {
    position: absolute;
    left: 28px;
    bottom: 28px;
    max-width: 330px;
    padding: 16px 18px;
    background: color-mix(in srgb, var(--ni-paper) 82%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .ni-hero__caption b { display: block; letter-spacing: -0.03em; margin-bottom: 3px; }
  .ni-hero__caption span { color: var(--ni-muted); font-size: 0.86rem; line-height: 1.38; }

  .ni-pulse {
    position: relative;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border: 1px solid var(--ni-text);
    border-radius: 50%;
  }
  .ni-pulse::before {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ni-text);
  }
  .ni-pulse::after {
    content: "";
    position: absolute;
    inset: -9px;
    border-radius: 50%;
    border: 1px solid rgba(5, 5, 5, 0.17);
    animation: ni-pulse-ring 2.2s ease-out infinite;
  }

  .ni-hero__book {
    position: absolute;
    right: -26px;
    bottom: -38px;
    min-width: 238px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: var(--ni-sand);
    color: var(--ni-text);
    font-weight: 760;
    font-size: 1.05rem;
    box-shadow: 0 14px 36px rgba(5, 5, 5, 0.12);
    transition: 180ms ease;
  }
  .ni-hero__book:hover { transform: translateY(-2px); }
  .ni-cal {
    position: relative;
    width: 27px;
    height: 27px;
    border: 3px solid var(--ni-text);
    border-radius: 3px;
  }
  .ni-cal::before, .ni-cal::after {
    content: "";
    position: absolute;
    top: -8px;
    width: 3px;
    height: 9px;
    background: var(--ni-text);
  }
  .ni-cal::before { left: 5px; }
  .ni-cal::after { right: 5px; }

  .ni-hero.is-ready .ni-reveal { opacity: 0; transform: translateY(60px); transition: opacity 800ms ease, transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .ni-hero.is-ready .ni-reveal.is-visible { opacity: 1; transform: none; }

  @keyframes ni-pulse-ring {
    0% { transform: scale(0.7); opacity: 0; }
    45% { opacity: 1; }
    100% { transform: scale(1.12); opacity: 0; }
  }

  @media (max-width: 1120px) {
    .ni-hero__shell { grid-template-columns: 1fr; min-height: auto; }
    .ni-hero__book { right: 20px; }
  }
  @media (max-width: 820px) {
    .ni-hero__shell { width: min(100% - 28px, var(--lp-maxw, 1440px)); gap: 42px; }
    .ni-btn { width: 100%; }
    .ni-hero__photo { min-height: 360px; height: 440px; }
    .ni-hero__book { position: relative; right: auto; bottom: auto; margin: -22px 0 0 auto; width: 100%; }
    .ni-hero__caption { left: 16px; right: 16px; bottom: 16px; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-pulse::after { animation: none; }
    .ni-btn, .ni-hero__book { transition: none; }
    .ni-hero.is-ready .ni-reveal { opacity: 1; transform: none; transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  class NiHero extends HTMLElement {
    connectedCallback() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = this.querySelectorAll('.ni-reveal');
      if (reduce || !('IntersectionObserver' in window) || items.length === 0) return;

      this.classList.add('is-ready');
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            this.observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      items.forEach((el) => this.observer.observe(el));
    }
    disconnectedCallback() {
      if (this.observer) this.observer.disconnect();
    }
  }
  if (!customElements.get('ni-hero')) customElements.define('ni-hero', NiHero);
{% endjavascript %}

{% schema %}
{
  "name": "NI · Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label line",
      "default": "Online Marketing Studio"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Headline",
      "default": "Marketing, das sichtbar verkauft"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "NetImpulse entwickelt Websites, Kampagnen und Shopify-Erlebnisse für Unternehmen, die online klarer auftreten, besser gefunden werden und professioneller verkaufen wollen."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Kostenloses Erstgespräch" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Theme Store ansehen" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    {
      "type": "header",
      "content": "Media"
    },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "caption_title", "label": "Caption title", "default": "NetImpulse Prinzip" },
    { "type": "text", "id": "caption_text", "label": "Caption text", "default": "Strategie, Gestaltung und Umsetzung arbeiten als ein System." },
    { "type": "text", "id": "book_label", "label": "Floating tag label", "default": "Termin buchen" },
    { "type": "url", "id": "book_url", "label": "Floating tag link" }
  ],
  "presets": [
    {
      "name": "NI · Hero",
      "category": "Landing"
    }
  ]
}
{% endschema %}
