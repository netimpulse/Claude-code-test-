{% doc %}
  A single editorial intro card with an orbit icon, used inside NI · Intro.
  The width option staggers the card and sets its paper tone, echoing the
  original layout rhythm.
{% enddoc %}

{%- liquid
  assign width = block.settings.width | default: 'full'
  assign icon = block.settings.icon | default: 'net'
-%}

<article class="ni-intro-card ni-intro-card--{{ width }} ni-reveal" {{ block.shopify_attributes }}>
  <div class="ni-intro-card__icon" aria-hidden="true">
    <span class="ni-orbit ni-orbit--a"></span>
    <span class="ni-orbit ni-orbit--b"></span>
    {%- case icon -%}
      {%- when 'chart' -%}
        <svg viewBox="0 0 48 48"><path d="M8 34h32M12 28l8-8 7 6 10-13M8 40h32"/></svg>
      {%- when 'window' -%}
        <svg viewBox="0 0 48 48"><path d="M10 13h28v22H10zM16 20h16M16 27h10M34 35l5 6"/></svg>
      {%- else -%}
        <svg viewBox="0 0 48 48"><path d="M24 6v36M6 24h36M12 12l24 24M36 12 12 36"/></svg>
    {%- endcase -%}
  </div>
  {%- if block.settings.title != blank -%}
    <h3 class="ni-intro-card__title">{{ block.settings.title | escape }}</h3>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <p class="ni-intro-card__text">{{ block.settings.text | escape }}</p>
  {%- endif -%}
</article>

{% stylesheet %}
  .ni-intro-card {
    position: relative;
    min-height: 220px;
    padding: 34px 34px 28px;
    background: var(--lp-surface, #fffdf8);
    border: 1px solid var(--lp-line, rgba(5, 5, 5, 0.12));
    box-shadow: 0 26px 70px rgba(33, 28, 20, 0.11);
    overflow: hidden;
    transition: transform 220ms ease;
  }
  .ni-intro-card:hover { transform: translateY(-5px); }
  .ni-intro-card--inset-1 { width: 88%; margin-left: auto; background: #ebe3d4; }
  .ni-intro-card--inset-2 { width: 78%; background: #fdfbf6; }

  .ni-intro-card__icon {
    position: relative;
    width: 78px;
    height: 78px;
    margin-bottom: 28px;
    border-radius: 50%;
    border: 1px solid var(--lp-line-strong, rgba(5, 5, 5, 0.22));
    background: var(--lp-bg, #f8f6f1);
    display: grid;
    place-items: center;
  }
  .ni-intro-card__icon svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--lp-text, #050505);
    stroke-width: 1.8;
  }
  .ni-orbit {
    position: absolute;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--lp-text, #050505);
    opacity: 0.86;
  }
  .ni-orbit--a { top: 5px; right: 10px; }
  .ni-orbit--b { bottom: 8px; left: 9px; }
  .ni-intro-card:hover .ni-orbit--a { animation: ni-orbit-pulse 1.45s ease-in-out infinite; }
  .ni-intro-card:hover .ni-orbit--b { animation: ni-orbit-pulse 1.45s ease-in-out infinite 0.22s; }

  .ni-intro-card__title {
    margin: 0 0 14px;
    font-size: clamp(1.6rem, 2.3vw, 2.4rem);
    line-height: 1.02;
    letter-spacing: -0.062em;
  }
  .ni-intro-card__text { margin: 0; max-width: 470px; color: var(--lp-muted, #6b665e); line-height: 1.58; }

  @keyframes ni-orbit-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(5, 5, 5, 0.14); }
    50% { transform: scale(1.42); box-shadow: 0 0 0 12px rgba(5, 5, 5, 0); }
  }

  @media (max-width: 820px) {
    .ni-intro-card--inset-1, .ni-intro-card--inset-2 { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ni-intro-card { transition: none; }
    .ni-intro-card:hover .ni-orbit--a, .ni-intro-card:hover .ni-orbit--b { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NI · Intro card",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Width & tone",
      "options": [
        { "value": "full", "label": "Full (paper)" },
        { "value": "inset-1", "label": "Inset right (sand)" },
        { "value": "inset-2", "label": "Inset left (cream)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "net", "label": "Net" },
        { "value": "chart", "label": "Chart" },
        { "value": "window", "label": "Window" }
      ],
      "default": "net"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Strategie statt Einzelmaßnahmen" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Eine kurze Beschreibung dieser Stärke." }
  ],
  "presets": [
    {
      "name": "NI · Intro card",
      "category": "Landing"
    }
  ]
}
{% endschema %}
