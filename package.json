{
  "name": "shopify-theme-template",
  "version": "0.1.0",
  "private": true,
  "description": "Template fuer neue Shopify-Theme-Repos mit integriertem Visual-QA-Workflow (Shopify CLI + Playwright).",
  "scripts": {
    "theme:check": "shopify theme check",
    "theme:push:dev": "shopify theme push -e development --unpublished",
    "theme:push:redesign": "shopify theme push -e redesign --nodelete",
    "theme:push:prod": "shopify theme push -e production",
    "qa:visual": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "qa:full": "npm run i18n:check && npm run theme:check && npm run qa:visual",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.48.0"
  }
}
