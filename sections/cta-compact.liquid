{% comment %}
  CTA compact (SYS §6 "CTA", dark teal surface via scheme-3176…)
  ----------------------------------------------------------------
  1px line with the eyebrow on top. Left (columns 1–7): h2 with serif
  accent (accent-heading) and lead. Right (9–12, bottom-aligned): primary
  block button to the contact page plus a short note underneath.
  No form (user decision E8 = A); the form pattern lives in contact-form.

  Colours come from the colour scheme tokens (--color-*); on the teal
  scheme the primary button is light teal with ink text. accent_color is
  optional and only tints the eyebrow dot when set.
  Padding: min(setting, --section-y) – the setting acts as an upper bound.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color

  assign button_url = section.settings.button_url
  if button_url == blank
    assign button_url = pages['kontakt'].url
  endif
  if button_url == blank
    assign button_url = routes.root_url
  endif

  assign fallback_note = 'cta_compact.button_note' | t
  assign button_note = section.settings.button_note | default: fallback_note
-%}

{{ 'section-cta-compact.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .cta-compact {
    {%- if accent != blank %}--ctac-accent: {{ accent }};{% endif %}
    --ctac-padding-top: {{ section.settings.padding_top }}px;
    --ctac-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<section
  class="cta-compact full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="ctac-heading-{{ section.id }}"{% endif %}
>
  <div class="cta-compact__inner">
    <div class="cta-compact__rule">
      {%- if section.settings.kicker != blank -%}
        <p class="cta-compact__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
    </div>

    <div class="cta-compact__grid">
      <div class="cta-compact__text">
        {%- if section.settings.heading != blank -%}
          <h2 id="ctac-heading-{{ section.id }}" class="cta-compact__heading">
            {%- render 'accent-heading', text: section.settings.heading -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank and section.settings.show_intro -%}
          <p class="cta-compact__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="cta-compact__actions">
          <a class="btn btn--primary btn--block cta-compact__btn" href="{{ button_url }}">
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="btn__arrow" aria-hidden="true">&rarr;</span>
          </a>
          {%- if button_note != blank -%}
            <p class="cta-compact__note">{{ button_note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA compact",
  "tag": "section",
  "class": "shopify-section--cta-compact",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Kontakt"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bereit für planbares *Wachstum?*"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Begleittext",
      "default": "Lass uns in einem kostenlosen Audit deinen größten Hebel finden – Strategie, Design und Performance aus einer Hand."
    },
    { "type": "checkbox", "id": "show_intro", "label": "Begleittext anzeigen", "default": true },
    { "type": "header", "content": "Button" },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Jetzt anfragen"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button-Link",
      "info": "Leer: Kontaktseite (/pages/kontakt)."
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Hinweis unter dem Button",
      "info": "Leer: Standardtext der Sprache („Kostenlos und unverbindlich.“)."
    },
    { "type": "header", "content": "Darstellung" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-3176272d-e560-4898-86e2-ed9090bb1264"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Akzentfarbe"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding oben",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding unten",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    { "type": "header", "content": "Typografie" },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "presets": [
    {
      "name": "CTA compact",
      "category": "Call to action",
      "settings": {
        "kicker": "Kontakt",
        "heading": "Bereit für planbares *Wachstum?*",
        "intro": "Lass uns in einem kostenlosen Audit deinen größten Hebel finden — Strategie, Design und Performance aus einer Hand.",
        "button_label": "Jetzt anfragen"
      }
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
