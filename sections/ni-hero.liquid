{% comment %}
  NI Hero — two-column hero of the home page (design system "Variante D").
  Content (eyebrow, h1 with serif accent, lead, buttons) on the left,
  photo with a figcaption on the right. No reveal, fade or looping
  animation here: h1 and photo are the LCP candidates.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign scheme_class = ''
  if scheme != blank
    assign scheme_class = 'color-' | append: scheme.id
  endif
  assign accent = section.settings.accent_color
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --lp-pad-top: {{ section.settings.padding_top }}px;
    --lp-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- if accent != blank %}--lp-accent: {{ accent }};{% endif %}
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
    {%- if section.settings.primary_btn_bg != blank %}--ni-btn-primary-bg: {{ section.settings.primary_btn_bg }};{% endif %}
    {%- if section.settings.primary_btn_text != blank %}--ni-btn-primary-text: {{ section.settings.primary_btn_text }};{% endif %}
    {%- if section.settings.primary_btn_border != blank %}--ni-btn-primary-border: {{ section.settings.primary_btn_border }};{% endif %}
    {%- if section.settings.primary_btn_bg_hover != blank %}--ni-btn-primary-bg-hover: {{ section.settings.primary_btn_bg_hover }};{% endif %}
    {%- if section.settings.primary_btn_text_hover != blank %}--ni-btn-primary-text-hover: {{ section.settings.primary_btn_text_hover }};{% endif %}
    {%- if section.settings.secondary_btn_bg != blank %}--ni-btn-secondary-bg: {{ section.settings.secondary_btn_bg }};{% endif %}
    {%- if section.settings.secondary_btn_text != blank %}--ni-btn-secondary-text: {{ section.settings.secondary_btn_text }};{% endif %}
    {%- if section.settings.secondary_btn_border != blank %}--ni-btn-secondary-border: {{ section.settings.secondary_btn_border }};{% endif %}
  }
{% endstyle %}

<ni-hero class="ni-hero full-width {{ scheme_class }}" {{ section.shopify_attributes }}>
  <div class="ni-hero__shell">
    <div class="ni-hero__content">
      {%- if section.settings.label != blank -%}
        <p class="ni-hero__label eyebrow">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="ni-hero__title">{% render 'accent-heading', text: section.settings.heading %}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="ni-hero__copy">{{ section.settings.body | escape }}</p>
      {%- endif -%}
      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="ni-hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="btn btn--primary ni-btn ni-btn--primary" href="{{ section.settings.primary_url | default: '#' }}">
              {{- section.settings.primary_label | escape -}}
              <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="btn btn--secondary ni-btn ni-btn--ghost" href="{{ section.settings.secondary_url | default: '#' }}">
              {{- section.settings.secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.book_label != blank -%}
        <a class="text-link ni-hero__book" href="{{ section.settings.book_url | default: '#' }}">
          {{- section.settings.book_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <figure class="ni-hero__media">
      <div class="ni-hero__photo">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign heading_plain = section.settings.heading | remove: '*'
            assign img_alt = section.settings.image.alt | default: heading_plain | escape
          -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 1101px) 40vw, 100vw',
              widths: '600, 900, 1200, 1500',
              alt: img_alt,
              class: 'ni-hero__img'
          }}
        {%- else -%}
          <div class="ni-hero__img ni-hero__img--ph" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      {%- if section.settings.caption_title != blank or section.settings.caption_text != blank -%}
        <figcaption class="ni-hero__figcaption">
          {%- if section.settings.caption_title != blank -%}
            <strong>{{ section.settings.caption_title | escape }}</strong>
          {%- endif -%}
          {%- if section.settings.caption_title != blank and section.settings.caption_text != blank %} {% endif -%}
          {%- if section.settings.caption_text != blank -%}
            <span>{{ section.settings.caption_text | escape }}</span>
          {%- endif -%}
        </figcaption>
      {%- endif -%}
    </figure>
  </div>
</ni-hero>

{{ 'section-ni-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ni-reveal.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "NI Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label line", "default": "Online-Marketing-Studio" },
    { "type": "textarea", "id": "heading", "label": "Headline", "info": "Setze ein Wort in *Sternchen*, um es als Serif-Akzent hervorzuheben.", "default": "Marketing, das *sichtbar* verkauft" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "NetImpulse entwickelt Websites, Kampagnen und Shopify-Erlebnisse für Unternehmen, die online klarer auftreten, besser gefunden werden und professioneller verkaufen wollen." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Kostenloses Erstgespräch" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Theme Store ansehen" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "caption_title", "label": "Caption title", "default": "NetImpulse-Prinzip" },
    { "type": "text", "id": "caption_text", "label": "Caption text", "default": "Strategie, Gestaltung und Umsetzung arbeiten als ein System." },
    { "type": "text", "id": "book_label", "label": "Text link label", "info": "Optionaler Text-Link unter den Buttons." },
    { "type": "url", "id": "book_url", "label": "Text link" },
    { "type": "header", "content": "Button colors", "info": "Leer lassen, um die Farben des Color Schemes zu verwenden." },
    { "type": "color", "id": "primary_btn_bg", "label": "Primary button background" },
    { "type": "color", "id": "primary_btn_text", "label": "Primary button text" },
    { "type": "color", "id": "primary_btn_border", "label": "Primary button border" },
    { "type": "color", "id": "primary_btn_bg_hover", "label": "Primary button background (hover)" },
    { "type": "color", "id": "primary_btn_text_hover", "label": "Primary button text (hover)" },
    { "type": "color", "id": "secondary_btn_bg", "label": "Secondary button background" },
    { "type": "color", "id": "secondary_btn_text", "label": "Secondary button text" },
    { "type": "color", "id": "secondary_btn_border", "label": "Secondary button border" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-sand" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Farbe des Eyebrow-Punkts. Leer lassen, um den Design-Akzent zu verwenden." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_scale", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    { "name": "NI Hero", "category": "Landing" }
  ]
}
{% endschema %}
