{% comment %}
  NI Intro — studio introduction on the black surface (SYS §6 "Intro").
  Eyebrow, h2 with serif accent and lead; three principles with large
  index numbers (section blocks); photo 4:3 with an h3 panel. The block
  settings "width" and "icon" stay in the schema but no longer render.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign scheme_class = ''
  if scheme != blank
    assign scheme_class = 'color-' | append: scheme.id
  endif
  assign accent = section.settings.accent_color
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --lp-pad-top: {{ section.settings.padding_top }}px;
    --lp-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- if accent != blank %}--lp-accent: {{ accent }};{% endif %}
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<ni-intro class="ni-intro full-width {{ scheme_class }}" {{ section.shopify_attributes }}>
  <div class="ni-intro__shell">
    <header class="ni-intro__head">
      {%- if section.settings.kicker != blank -%}
        <p class="ni-intro__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ni-intro__title">{% render 'accent-heading', text: section.settings.heading %}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank and section.settings.show_intro -%}
        <p class="ni-intro__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ol class="ni-intro__principles">
        {%- for block in section.blocks -%}
          <li class="ni-intro-card" {{ block.shopify_attributes }}>
            <span class="ni-intro-card__num" aria-hidden="true">
              {%- if forloop.index < 10 -%}0{%- endif -%}
              {{- forloop.index -}}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="ni-intro-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ni-intro-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- else -%}
      <p class="ni-intro__empty">{{ 'ni_intro.add_cards' | t }}</p>
    {%- endif -%}

    <div class="ni-intro__panel">
      <div class="ni-intro__panel-media">
        {%- if section.settings.panel_image != blank -%}
          {%- liquid
            assign panel_heading_plain = section.settings.panel_heading | remove: '*'
            assign p_alt = section.settings.panel_image.alt | default: panel_heading_plain | escape
          -%}
          {{
            section.settings.panel_image
            | image_url: width: 1300
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 861px) 50vw, 100vw',
              widths: '500, 800, 1100, 1300',
              alt: p_alt,
              class: 'ni-intro__panel-img'
          }}
        {%- else -%}
          <div class="ni-intro__panel-img ni-intro__panel-img--ph" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <div class="ni-intro__panel-copy">
        {%- if section.settings.panel_heading != blank -%}
          <h3>{{ section.settings.panel_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.panel_text != blank -%}
          <p>{{ section.settings.panel_text | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</ni-intro>

{{ 'section-ni-intro.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "NI Intro",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Unternehmensvorstellung" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Setze ein Wort in *Sternchen*, um es als Serif-Akzent hervorzuheben.", "default": "Ein Studio für digitale Auftritte *mit System.*" },
    { "type": "textarea", "id": "text", "label": "Intro text", "default": "Wir verbinden Online-Marketing, Webdesign und Shopify-Entwicklung, damit aus einzelnen Maßnahmen ein klarer digitaler Auftritt entsteht." },
    { "type": "checkbox", "id": "show_intro", "label": "Begleittext anzeigen", "default": true },
    { "type": "header", "content": "Image panel" },
    { "type": "image_picker", "id": "panel_image", "label": "Panel image" },
    { "type": "textarea", "id": "panel_heading", "label": "Panel heading", "default": "Von der ersten Idee bis zur laufenden Optimierung." },
    { "type": "textarea", "id": "panel_text", "label": "Panel text", "default": "Ob Relaunch, SEO-Aufbau, Google Ads oder Shopify-Theme: Wir bauen digitale Grundlagen, die nicht nur beim Launch gut aussehen, sondern im Alltag messbar weiterarbeiten." },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "info": "Farbe der Kennziffern. Leer lassen, um den Akzent des Color Schemes zu verwenden." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_scale", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "width",
          "label": "Width & tone",
          "info": "Wirkt im aktuellen Layout nicht mehr.",
          "options": [
            { "value": "full", "label": "Full (paper)" },
            { "value": "inset-1", "label": "Inset right (sand)" },
            { "value": "inset-2", "label": "Inset left (cream)" }
          ],
          "default": "full"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Wird im aktuellen Layout nicht angezeigt.",
          "options": [
            { "value": "net", "label": "Net" },
            { "value": "chart", "label": "Chart" },
            { "value": "window", "label": "Window" }
          ],
          "default": "net"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Strategie statt Einzelmaßnahmen" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Eine kurze Beschreibung dieser Stärke." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NI Intro",
      "category": "Landing",
      "blocks": [
        { "type": "card", "settings": { "width": "full", "icon": "net", "title": "Strategie statt Einzelmaßnahmen", "text": "Wir starten nicht mit einem beliebigen Kanal, sondern mit der Frage, wo Sichtbarkeit, Vertrauen und Conversion aktuell am meisten Wirkung erzeugen." } },
        { "type": "card", "settings": { "width": "inset-1", "icon": "chart", "title": "Design, das nicht nur dekoriert", "text": "Jede Seite soll schneller erklären, hochwertiger wirken und Besucher gezielter führen – ohne überladene Effekte oder generische Marketing-Optik." } },
        { "type": "card", "settings": { "width": "inset-2", "icon": "window", "title": "Shopify als skalierbares System", "text": "Wir denken Websites und Shops so, dass Inhalte gepflegt, Kampagnen erweitert und neue Sections oder Themes sauber ergänzt werden können." } }
      ]
    }
  ]
}
{% endschema %}
