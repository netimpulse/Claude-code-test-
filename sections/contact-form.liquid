{% comment %}
  Contact form (SYS §5/§6: Formular- und Fehlerzustands-Muster)
  ----------------------------------------------------------------
  Heading (accent-heading, *Wort*-Konvention) + Untertitel, darunter
  links die Kontaktinfos (ohne Kasten), rechts das Formular.
  Form nutzt {% form 'contact' %} -> Submissions gehen an die in der
  Shop-Konfig hinterlegte E-Mail.

  Farben kommen aus den Schema-Tokens (.color-<scheme>, Default
  scheme-sand). accent_color ist optional und färbt nur dekorative
  Linien (--cf-accent existiert nur, wenn das Setting gefüllt ist).

  Field-Blocks: text, email, tel, textarea, select (Dropdown).
  Fehler je Feld: 2px --color-error, aria-invalid + aria-describedby
  auf einen Text mit „Fehler“-Label (contact.error_prefix).
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign anchor_id = 'ContactForm-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign sub_tag = 'h3'
  if heading_tag == 'h1'
    assign sub_tag = 'h2'
  endif
  assign fallback_info_label = 'contact.info_label' | t
  assign fallback_success = 'contact.success' | t
  assign fallback_submit = 'contact.submit' | t
  assign error_prefix = 'contact.error_prefix' | t
-%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .contact-form {
    {%- if accent != blank %}--cf-accent: {{ accent }};{% endif %}
    --cf-padding-top: calc({{ section.settings.padding_top }}px * var(--ui-scale, 1));
    --cf-padding-bottom: calc({{ section.settings.padding_bottom }}px * var(--ui-scale, 1));
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<section
  class="contact-form full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="cf-heading-{{ section.id }}"{% endif %}
>
  <div class="contact-form__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="contact-form__header">
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} id="cf-heading-{{ section.id }}" class="contact-form__heading contact-form__heading--{{ heading_tag }}">
            {%- render 'accent-heading', text: section.settings.heading -%}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="contact-form__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="contact-form__grid">
      <aside class="contact-form__info-col" aria-label="{{ section.settings.info_heading | default: fallback_info_label | escape }}">
        {%- if section.settings.info_heading != blank -%}
          <{{ sub_tag }} class="contact-form__info-heading label-caps">{{ section.settings.info_heading | escape }}</{{ sub_tag }}>
        {%- endif -%}

        <ul class="contact-form__info-list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'info' -%}
              <li class="contact-form__info-item" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <span class="contact-form__info-label label-caps">{{ block.settings.label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <div class="contact-form__info-content">{{ block.settings.content }}</div>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </aside>

      <div class="contact-form__form-col">
        {%- form 'contact', class: 'contact-form__form', id: anchor_id -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-form__success" role="status">
              {{ section.settings.success_message | default: fallback_success | escape }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-form__errors" role="alert">
              <p class="contact-form__errors-title">
                <span class="label-caps">{{ error_prefix | escape }}</span>
                {{ 'general.errors_title' | t | escape }}
              </p>
              <ul class="contact-form__errors-list">
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] | escape }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__fields">
            {%- for block in section.blocks -%}
              {%- if block.type == 'field' -%}
                {%- liquid
                  assign field_id = 'CFField-' | append: section.id | append: '-' | append: block.id
                  assign error_id = field_id | append: '-error'
                  assign field_name = block.settings.name | default: 'field'
                  assign input_name = 'contact[' | append: field_name | append: ']'
                  assign required = block.settings.required
                  assign width = block.settings.width | default: 'full'
                  assign invalid = false
                  if form.errors and form.errors contains field_name
                    assign invalid = true
                  endif
                -%}

                <div class="contact-form__field contact-form__field--{{ width }}{% if block.settings.type == 'textarea' %} contact-form__field--block{% endif %}{% if invalid %} is-invalid{% endif %}" {{ block.shopify_attributes }}>
                  <label class="contact-form__label" for="{{ field_id }}">
                    {{- block.settings.label | escape -}}
                    {%- if required -%}<span class="contact-form__required" aria-hidden="true">*</span>{%- endif -%}
                  </label>

                  {%- case block.settings.type -%}
                    {%- when 'textarea' -%}
                      <textarea
                        id="{{ field_id }}"
                        name="{{ input_name }}"
                        class="contact-form__input contact-form__textarea"
                        rows="5"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        {% if required %}required aria-required="true"{% endif %}
                        {% if invalid %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
                      >{% if field_name == 'body' and form.body != blank %}{{ form.body | escape }}{% endif %}</textarea>

                    {%- when 'select' -%}
                      {%- assign options = block.settings.options | newline_to_br | split: '<br />' -%}
                      <select
                        id="{{ field_id }}"
                        name="{{ input_name }}"
                        class="contact-form__input contact-form__select"
                        {% if required %}required aria-required="true"{% endif %}
                        {% if invalid %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
                      >
                        {%- if block.settings.placeholder != blank -%}
                          <option value="" disabled selected>{{ block.settings.placeholder | escape }}</option>
                        {%- endif -%}
                        {%- for option in options -%}
                          {%- assign opt = option | strip_html | strip -%}
                          {%- if opt != blank -%}
                            <option value="{{ opt | escape }}">{{ opt | escape }}</option>
                          {%- endif -%}
                        {%- endfor -%}
                      </select>

                    {%- else -%}
                      {%- liquid
                        assign input_type = block.settings.type | default: 'text'
                        assign autocomplete = ''
                        if input_type == 'email'
                          assign autocomplete = 'email'
                        endif
                        if input_type == 'tel'
                          assign autocomplete = 'tel'
                        endif
                        if field_name == 'name'
                          assign autocomplete = 'name'
                        endif
                        if field_name == 'company'
                          assign autocomplete = 'organization'
                        endif
                        assign prefill = ''
                        if field_name == 'email'
                          assign prefill = form.email
                        endif
                      -%}
                      <input
                        type="{{ input_type }}"
                        id="{{ field_id }}"
                        name="{{ input_name }}"
                        class="contact-form__input"
                        placeholder="{{ block.settings.placeholder | escape }}"
                        {% if prefill != blank %}value="{{ prefill | escape }}"{% endif %}
                        {% if autocomplete != blank %}autocomplete="{{ autocomplete }}"{% endif %}
                        {% if required %}required aria-required="true"{% endif %}
                        {% if invalid %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
                      >
                  {%- endcase -%}

                  {%- if invalid -%}
                    <p class="contact-form__error" id="{{ error_id }}">
                      <span class="label-caps">{{ error_prefix | escape }}</span>
                      {{ form.errors.translated_fields[field_name] | capitalize | escape }} {{ form.errors.messages[field_name] | escape }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="contact-form__actions">
            <button type="submit" class="btn btn--primary btn--block contact-form__submit">
              <span>{{ section.settings.submit_label | default: fallback_submit | escape }}</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "shopify-section--contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "info": "Ein Wort in *Sternchen* wird als Serif-Akzent gesetzt.", "default": "Lass uns reden." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Überschrift-Ebene",
      "info": "H1, wenn das Formular der Hauptinhalt der Seite ist (z. B. Kontaktseite).",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    { "type": "textarea", "id": "subheading", "label": "Untertitel", "default": "Erzähl uns von deinem Projekt – wir melden uns innerhalb von 48 Stunden mit klaren nächsten Schritten." },
    { "type": "header", "content": "Formular" },
    { "type": "text", "id": "submit_label", "label": "Button-Text", "default": "Nachricht senden" },
    { "type": "text", "id": "success_message", "label": "Erfolgsmeldung", "default": "Danke! Wir melden uns innerhalb von 48 Stunden." },
    { "type": "header", "content": "Info-Spalte" },
    { "type": "text", "id": "info_heading", "label": "Info-Überschrift", "default": "Kontakt" },
    { "type": "header", "content": "Darstellung" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-sand" },
    { "type": "color", "id": "accent_color", "label": "Akzentfarbe (Linien)", "info": "Leer = Designsystem. Färbt nur dekorative Linien, nie den Button." },
    { "type": "range", "id": "padding_top", "label": "Padding oben", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding unten", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Typografie" },
    { "type": "range", "id": "heading_scale", "label": "Heading size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_scale", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Formular-Feld",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "Feld-Typ",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "email", "label": "E-Mail" },
            { "value": "tel", "label": "Telefon" },
            { "value": "textarea", "label": "Mehrzeiliger Text" },
            { "value": "select", "label": "Dropdown" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Name" },
        {
          "type": "text",
          "id": "name",
          "label": "Feld-Name (intern)",
          "info": "Wird als contact[<name>] versendet. Nur lowercase + underscore. Pflicht für E-Mail: \"email\".",
          "default": "name"
        },
        { "type": "text", "id": "placeholder", "label": "Platzhalter", "default": "Dein Name" },
        { "type": "checkbox", "id": "required", "label": "Pflichtfeld", "default": false },
        {
          "type": "select",
          "id": "width",
          "label": "Spaltenbreite",
          "options": [
            { "value": "full", "label": "Voll" },
            { "value": "half", "label": "Halb" }
          ],
          "default": "full"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Dropdown-Optionen",
          "info": "Nur für Feld-Typ \"Dropdown\". Eine Option pro Zeile.",
          "default": "Option 1\nOption 2\nOption 3"
        }
      ]
    },
    {
      "type": "info",
      "name": "Info-Eintrag",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Adresse" },
        { "type": "richtext", "id": "content", "label": "Inhalt", "default": "<p>NetImpulse<br>Musterstraße 1<br>12345 Musterstadt</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "category": "Contact",
      "blocks": [
        { "type": "field", "settings": { "type": "text", "label": "Name", "name": "name", "placeholder": "Dein Name", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "email", "label": "E-Mail", "name": "email", "placeholder": "deine@email.de", "required": true, "width": "half" } },
        { "type": "field", "settings": { "type": "tel", "label": "Telefon", "name": "phone", "placeholder": "+49 …", "required": false, "width": "half" } },
        { "type": "field", "settings": { "type": "text", "label": "Unternehmen", "name": "company", "placeholder": "Dein Unternehmen", "required": false, "width": "half" } },
        { "type": "field", "settings": { "type": "select", "label": "Worum geht's?", "name": "topic", "placeholder": "Bitte wählen …", "required": false, "width": "full", "options": "Strategie & Beratung\nWebdesign & UX\nSEO & Performance\nShopify-Theme\nSonstiges" } },
        { "type": "field", "settings": { "type": "textarea", "label": "Nachricht", "name": "body", "placeholder": "Erzähl uns von deinem Projekt …", "required": true, "width": "full" } },
        { "type": "info", "settings": { "label": "Adresse", "content": "<p>NetImpulse<br>Musterstraße 1<br>12345 Musterstadt</p>" } },
        { "type": "info", "settings": { "label": "Telefon", "content": "<p>+49 (0) 1234 567890</p>" } },
        { "type": "info", "settings": { "label": "E-Mail", "content": "<p>hallo@netimpulse.de</p>" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
