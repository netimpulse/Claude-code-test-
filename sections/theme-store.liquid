{% comment %}
  Theme Store (design system, variant B with head + featured slab from C)
  ----------------------------------------------------------------
  - Compact head: eyebrow, h1 with serif accent (*word*), lead on the right.
  - Featured slab (dark): product, type, title, text, tags, price, button,
    large preview on the right. Hidden while `featured_product` is empty.
  - Feature band from `feature` blocks (hairlines, icon + text).
  - Sticky filter bar: category pills with count (from `category` blocks,
    plus the built-in "All" entry), result count, search field.
  - Two-column grid with large 4:3 previews and round arrows; cards without
    an image show the initial in Newsreader italic + "preview coming soon".
    Optional `cta` block: dark teal tile as the last grid item.
  - Empty state ("no results") and "did you mean …" hint.

  Filtering and search happen client-side (assets/theme-store.js):
  - Liquid renders every product once with data-cats listing every
    collection handle it belongs to (dedupe by product id).
  - ?cat=<handle> + history.pushState, no reload.
  - Search filters the grid directly with typo tolerance; Shopify's
    predictive search (locale-prefixed) adds matches on vendor/tags/body.

  Legacy settings kept for compatibility (not rendered any more):
  heading_font, body_font, card_radius. The design system fonts apply.
{% endcomment %}

{%- liquid
  assign render_limit = 50
  assign scheme = section.settings.color_scheme
  assign fallback_all_label = 'theme_store.all_label' | t
  assign all_label = section.settings.all_label | default: fallback_all_label
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign featured = section.settings.featured_product

  assign seen_ids = ''
  assign total_count = 0
  assign feature_count = 0
  assign cta_block = nil
  for block in section.blocks
    case block.type
      when 'category'
        if block.settings.collection != blank
          for p in block.settings.collection.products limit: render_limit
            assign marker = '|' | append: p.id | append: '|'
            unless seen_ids contains marker
              assign seen_ids = seen_ids | append: marker
              assign total_count = total_count | plus: 1
            endunless
          endfor
        endif
      when 'feature'
        if block.settings.text != blank
          assign feature_count = feature_count | plus: 1
        endif
      when 'cta'
        if cta_block == nil
          assign cta_block = block
        endif
    endcase
  endfor

  if cta_block
    assign cta_url = cta_block.settings.button_url
    if cta_url == blank
      assign cta_url = pages['kontakt'].url | default: routes.root_url
    endif
  endif

  assign search_placeholder = section.settings.search_placeholder
  if search_placeholder == blank
    assign search_placeholder = 'theme_store.search_label' | t
  endif
  assign categories_label = section.settings.categories_heading
  if categories_label == blank
    assign categories_label = 'theme_store.categories_label' | t
  endif
  assign features_label = section.settings.features_heading
  if features_label == blank
    assign features_label = 'theme_store.features_label' | t
  endif
-%}

{{ 'section-theme-store.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .theme-store {
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<section
  class="theme-store full-width{% if scheme != blank %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="theme-store"
  aria-labelledby="ts-title-{{ section.id }}"
  data-i18n-count-one="{{ 'theme_store.count_one' | t: n: '__N__' | escape }}"
  data-i18n-count-other="{{ 'theme_store.count_other' | t: n: '__N__' | escape }}"
  data-i18n-results-one="{{ 'theme_store.results_one' | t: n: '__N__' | escape }}"
  data-i18n-results-other="{{ 'theme_store.results_other' | t: n: '__N__' | escape }}"
  data-i18n-similar-one="{{ 'theme_store.similar_one' | t: n: '__N__' | escape }}"
  data-i18n-similar-other="{{ 'theme_store.similar_other' | t: n: '__N__' | escape }}"
  data-i18n-for-query="{{ 'theme_store.for_query' | t: query: '__QUERY__' | escape }}"
  data-i18n-in-category="{{ 'theme_store.in_category' | t: category: '__CATEGORY__' | escape }}"
  data-i18n-no-exact="{{ 'theme_store.no_exact' | t: query: '__QUERY__' | escape }}"
  data-i18n-did-you-mean="{{ 'theme_store.did_you_mean' | t | escape }}"
  data-i18n-empty-query="{{ 'theme_store.empty_query' | t: query: '__QUERY__' | escape }}"
  data-i18n-empty-category="{{ 'theme_store.empty' | t | escape }}"
>
  <div class="theme-store__wrap">
    {%- comment -%} Compact head {%- endcomment -%}
    <header class="theme-store__head">
      <div class="theme-store__head-text">
        {%- if section.settings.kicker != blank -%}
          <p class="theme-store__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <{{ heading_tag }} id="ts-title-{{ section.id }}" class="theme-store__heading">
          {%- if section.settings.heading != blank -%}
            {%- render 'accent-heading', text: section.settings.heading -%}
          {%- else -%}
            {{- all_label | escape -}}
          {%- endif -%}
        </{{ heading_tag }}>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="theme-store__lead">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </header>

    {%- comment -%} Featured slab (dark) {%- endcomment -%}
    {%- if featured != blank -%}
      {%- liquid
        assign f_tags_src = section.settings.featured_tags
        if f_tags_src == blank
          assign f_tags_src = featured.tags | join: ','
        endif
        assign f_tags = f_tags_src | split: ','
        assign f_initial = featured.title | strip | slice: 0, 1 | upcase
      -%}
      <article class="theme-store__feature" aria-labelledby="ts-feature-{{ section.id }}">
        <div class="theme-store__feature-main">
          <div class="theme-store__feature-top">
            {%- if section.settings.featured_label != blank -%}
              <span class="eyebrow">{{ section.settings.featured_label | escape }}</span>
            {%- endif -%}
            {%- if featured.type != blank -%}
              <span class="label-caps theme-store__feature-type">{{ featured.type | escape }}</span>
            {%- endif -%}
          </div>
          <h2 id="ts-feature-{{ section.id }}" class="theme-store__feature-title">{{ featured.title | escape }}</h2>
          {%- if section.settings.featured_text != blank -%}
            <div class="theme-store__feature-text">{{ section.settings.featured_text }}</div>
          {%- endif -%}
          {%- if f_tags_src != blank -%}
            <ul class="theme-store__tags" aria-label="{{ 'theme_store.tags_label' | t }}">
              {%- for tag in f_tags -%}
                {%- assign tag_clean = tag | strip -%}
                {%- if tag_clean != blank -%}
                  <li>{{ tag_clean | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="theme-store__feature-foot">
            <p class="theme-store__feature-price">
              <small>{{ 'theme_store.price_once' | t }}</small>
              {{- featured.price | money -}}
            </p>
            <a class="btn btn--primary theme-store__feature-btn" href="{{ featured.url }}">
              <span>{{ 'theme_store.view_theme' | t: title: featured.title }}</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
        <div class="theme-store__feature-visual" aria-hidden="true">
          {%- if featured.featured_image -%}
            {{
              featured.featured_image
              | image_url: width: 1600, height: 1200, crop: 'center'
              | image_tag:
                loading: 'eager',
                widths: '600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 1101px) 45vw, 92vw',
                alt: '',
                class: 'theme-store__feature-img'
            }}
          {%- else -%}
            <div class="theme-store__noimg">
              <span class="theme-store__noimg-bar"><i></i><i></i><i></i></span>
              <span class="theme-store__noimg-initial">{{ f_initial | escape }}</span>
              <span class="theme-store__noimg-tag label-caps">{{ 'theme_store.preview_soon' | t }}</span>
            </div>
          {%- endif -%}
        </div>
      </article>
    {%- endif -%}

    {%- comment -%} Feature band {%- endcomment -%}
    {%- if feature_count > 0 -%}
      <div class="theme-store__feats-wrap">
        <h2 class="visually-hidden">{{ features_label | escape }}</h2>
        <ul class="theme-store__feats" style="--ts-feats: {{ feature_count | at_most: 4 }};">
          {%- for block in section.blocks -%}
            {%- if block.type != 'feature' or block.settings.text == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign icon = block.settings.icon | default: 'auto'
              if icon == 'auto'
                assign key = block.settings.text | downcase
                if key contains 'mobil'
                  assign icon = 'mobile'
                elsif key contains 'seo' or key contains 'such'
                  assign icon = 'seo'
                elsif key contains 'editor'
                  assign icon = 'editor'
                elsif key contains 'schnell' or key contains 'fast' or key contains 'lade' or key contains 'speed'
                  assign icon = 'speed'
                else
                  assign icon = 'check'
                endif
              endif
            -%}
            <li class="theme-store__feat" {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                {%- case icon -%}
                  {%- when 'mobile' -%}
                    <rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 17.5h2"/>
                  {%- when 'seo' -%}
                    <circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5M8 10.5l2 2 3.5-4"/>
                  {%- when 'editor' -%}
                    <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16M12 9h6M12 13h4"/>
                  {%- when 'speed' -%}
                    <path d="M13 3 5 14h6l-1 7 8-11h-6l1-7Z"/>
                  {%- else -%}
                    <circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.5 2.5L16 9.5"/>
                {%- endcase -%}
              </svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Sticky filter bar {%- endcomment -%}
  <div class="theme-store__bar">
    <div class="theme-store__wrap theme-store__bar-inner">
      <nav class="theme-store__cats" aria-label="{{ categories_label | escape }}">
        <ul class="theme-store__pills">
          <li>
            <a href="{{ request.path }}" class="theme-store__pill is-active" data-ts-cat="all" data-ts-cat-label="{{ all_label | escape }}" aria-current="true">
              <span class="theme-store__pill-name">{{ all_label | escape }}</span>
              <span class="theme-store__pill-count" data-ts-cat-count>{{ total_count }}</span>
            </a>
          </li>
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' and block.settings.collection != blank -%}
              {%- assign c = block.settings.collection -%}
              {%- assign c_label = block.settings.label | default: c.title -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ request.path }}?cat={{ c.handle | url_encode }}" class="theme-store__pill" data-ts-cat="{{ c.handle | escape }}" data-ts-cat-label="{{ c_label | escape }}" aria-current="false">
                  <span class="theme-store__pill-name">{{ c_label | escape }}</span>
                  <span class="theme-store__pill-count" data-ts-cat-count>{{ c.products_count | at_most: render_limit }}</span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      <p class="theme-store__count" data-ts-count aria-live="polite">
        {%- if total_count == 1 -%}
          {{- 'theme_store.count_one' | t: n: total_count -}}
        {%- else -%}
          {{- 'theme_store.count_other' | t: n: total_count -}}
        {%- endif -%}
      </p>

      <form class="theme-store__search" role="search" action="{{ routes.search_url }}" method="get" data-ts-search-form>
        <label for="ts-search-{{ section.id }}" class="visually-hidden">{{ 'theme_store.search_label' | t }}</label>
        <div class="theme-store__search-field">
          <svg class="theme-store__search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5 5"/>
          </svg>
          <input
            id="ts-search-{{ section.id }}"
            class="theme-store__search-input"
            type="search"
            name="q"
            autocomplete="off"
            spellcheck="false"
            placeholder="{{ search_placeholder | escape }}"
            data-ts-search-input
            aria-controls="ts-grid-{{ section.id }}"
          >
          <input type="hidden" name="type" value="product">
          <button type="button" class="theme-store__search-clear" data-ts-search-clear aria-label="{{ 'theme_store.clear_search' | t }}" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  {%- comment -%} Results {%- endcomment -%}
  <div class="theme-store__wrap theme-store__body">
    <h2 class="visually-hidden">{{ all_label | escape }}</h2>
    <p class="theme-store__hint" data-ts-hint aria-live="polite" hidden></p>

    {%- assign rendered_ids = '' -%}
    <ul id="ts-grid-{{ section.id }}" class="theme-store__grid" data-ts-product-grid aria-label="{{ all_label | escape }}">
      {%- assign cat_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'category' or block.settings.collection == blank -%}{%- continue -%}{%- endif -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign coll_label = block.settings.label | default: coll.title -%}
        {%- assign tone = cat_index | modulo: 2 -%}
        {%- assign cat_index = cat_index | plus: 1 -%}
        {%- for product in coll.products limit: render_limit -%}
          {%- assign marker = '|' | append: product.id | append: '|' -%}
          {%- if rendered_ids contains marker -%}{%- continue -%}{%- endif -%}
          {%- assign rendered_ids = rendered_ids | append: marker -%}

          {%- comment -%} Every collection (within this section) the product belongs to {%- endcomment -%}
          {%- assign cats = '' -%}
          {%- for b2 in section.blocks -%}
            {%- if b2.type == 'category' and b2.settings.collection != blank -%}
              {%- for p2 in b2.settings.collection.products limit: render_limit -%}
                {%- if p2.id == product.id -%}
                  {%- assign cats = cats | append: b2.settings.collection.handle | append: ' ' -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign card_cat = product.type | default: coll_label -%}
          {%- assign initial = product.title | strip | slice: 0, 1 | upcase -%}

          <li
            class="theme-store__card"
            data-ts-product
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle | escape }}"
            data-cats="{{ cats | strip | escape }}"
            data-title="{{ product.title | escape }}"
          >
            <a class="theme-store__card-link" href="{{ product.url }}">
              <div class="theme-store__media">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 1200, height: 900, crop: 'center'
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 861px) 46vw, 92vw',
                      alt: '',
                      class: 'theme-store__img'
                  }}
                {%- else -%}
                  <div class="theme-store__noimg theme-store__noimg--tone-{{ tone }}" aria-hidden="true">
                    <span class="theme-store__noimg-bar"><i></i><i></i><i></i></span>
                    <span class="theme-store__noimg-initial">{{ initial | escape }}</span>
                    <span class="theme-store__noimg-tag label-caps">{{ 'theme_store.preview_soon' | t }}</span>
                  </div>
                {%- endif -%}
                <span class="theme-store__go" aria-hidden="true">&rarr;</span>
              </div>
              <div class="theme-store__card-body">
                <h3 class="theme-store__product-title">{{ product.title | escape }}</h3>
                <p class="theme-store__price">{{ product.price | money }}</p>
                {%- if card_cat != blank -%}
                  <p class="theme-store__card-cat">{{ card_cat | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      {%- endfor -%}

      {%- if cta_block -%}
        <li class="theme-store__cta" data-ts-extra {{ cta_block.shopify_attributes }}>
          <div class="theme-store__cta-tile">
            {%- if cta_block.settings.label != blank -%}
              <p class="eyebrow theme-store__cta-label">{{ cta_block.settings.label | escape }}</p>
            {%- endif -%}
            <div>
              {%- if cta_block.settings.heading != blank -%}
                <h3 class="theme-store__cta-heading">{{ cta_block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if cta_block.settings.text != blank -%}
                <p class="theme-store__cta-text">{{ cta_block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            {%- if cta_block.settings.button_label != blank -%}
              <a class="btn btn--primary theme-store__cta-btn" href="{{ cta_url }}">
                <span>{{ cta_block.settings.button_label | escape }}</span>
                <span class="btn__arrow" aria-hidden="true">&rarr;</span>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endif -%}
    </ul>

    <div class="theme-store__empty" data-ts-empty {% if total_count > 0 %}hidden{% endif %}>
      <p class="eyebrow">{{ 'theme_store.no_matches' | t }}</p>
      <h2 class="theme-store__empty-title" data-ts-empty-title>{{ 'theme_store.empty' | t }}</h2>
      <p class="theme-store__empty-text">{{ 'theme_store.empty_text' | t }}</p>
      <div class="theme-store__empty-actions">
        <button class="btn btn--primary btn--sm" type="button" data-ts-reset-q hidden>{{ 'theme_store.reset_search' | t }}</button>
        <button class="btn btn--secondary btn--sm" type="button" data-ts-show-all>{{ 'theme_store.show_all' | t }}</button>
      </div>
      {%- if cta_block and cta_block.settings.button_label != blank -%}
        <p class="theme-store__empty-note">
          {%- if cta_block.settings.heading != blank -%}{{ cta_block.settings.heading | escape }} {% endif -%}
          <a class="text-link" href="{{ cta_url }}">{{ cta_block.settings.button_label | escape }} <span aria-hidden="true">&rarr;</span></a>
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} Inline JSON catalog for the typo-tolerant search {%- endcomment -%}
<script type="application/json" data-ts-catalog="{{ section.id }}">
  [
    {%- assign first_p = true -%}
    {%- assign catalog_seen = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' and block.settings.collection != blank -%}
        {%- assign coll = block.settings.collection -%}
        {%- assign coll_label = block.settings.label | default: coll.title -%}
        {%- for p in coll.products limit: render_limit -%}
          {%- assign marker = '|' | append: p.id | append: '|' -%}
          {%- unless catalog_seen contains marker -%}
            {%- assign catalog_seen = catalog_seen | append: marker -%}
            {%- unless first_p -%},{%- endunless -%}
            {%- assign first_p = false -%}
            {
              "id": {{ p.id | json }},
              "handle": {{ p.handle | json }},
              "title": {{ p.title | json }},
              "type": {{ p.type | default: '' | json }},
              "category": {{ coll_label | json }},
              "vendor": {{ p.vendor | json }},
              "tags": {{ p.tags | json }}
            }
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
  ]
</script>

<script src="{{ 'theme-store.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:theme_store.name",
  "tag": "section",
  "class": "shopify-section--theme-store",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Theme Store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:theme_store.heading_label",
      "info": "Ein Wort in *Sternchen* bekommt den Serif-Akzent, z. B. \"Fertige Themes, *eigene* Handschrift.\"",
      "default": "Fertige Themes, *eigene* Handschrift."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Überschrift-Ebene",
      "info": "H1, wenn der Theme Store der Hauptinhalt der Seite ist und es sonst kein H1 gibt.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:theme_store.subheading_label",
      "default": "Entwickelt für wachsende Onlineshops: schnell, suchmaschinenfreundlich und im Theme-Editor frei anpassbar."
    },
    {
      "type": "header",
      "content": "Empfohlenes Theme",
      "info": "Leer lassen, um die Tafel auszublenden."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produkt"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Eyebrow",
      "default": "Empfohlen"
    },
    {
      "type": "richtext",
      "id": "featured_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "featured_tags",
      "label": "Schwerpunkte",
      "info": "Durch Kommas getrennt. Leer = Produkt-Tags."
    },
    {
      "type": "header",
      "content": "Filter und Suche"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:theme_store.search_placeholder_label",
      "default": "Theme suchen, z. B. Quartz"
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "t:theme_store.categories_heading_label",
      "info": "Name der Kategorie-Navigation für Screenreader.",
      "default": "Kategorien"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "t:theme_store.all_label",
      "default": "All themes"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "t:theme_store.features_heading_label",
      "info": "Überschrift des Feature-Bands für Screenreader.",
      "default": "Features"
    },
    {
      "type": "header",
      "content": "t:theme_store.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:theme_store.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:theme_store.typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
