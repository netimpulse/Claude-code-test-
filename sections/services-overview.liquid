{% comment %}
  Interactive Services Overview
  ----------------------------------------------------------------
  Centered heading at the top, tabs below, the orbit on its own in
  the middle and the active service's description flowing below.
  Clicking any tab or node rotates the chosen service into the
  bottom slot of the ring and reveals its description.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign autoplay = section.settings.enable_autoplay
  assign block_count = section.blocks.size
-%}

{{ 'section-services-overview.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .services-overview {
    --so-accent: {{ accent }};
    --so-accent-soft: {{ accent | color_modify: 'alpha', 0.13 }};
    --so-accent-glow: {{ accent | color_modify: 'alpha', 0.32 }};
    --so-padding-top: {{ section.settings.padding_top }}px;
    --so-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if scheme.settings.background != blank -%}
      --so-bg: {{ scheme.settings.background }};
      --so-text: {{ scheme.settings.text }};
      --so-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
      --so-line: {{ scheme.settings.text | color_modify: 'alpha', 0.14 }};
      --so-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.24 }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="services-overview full-width color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="services-heading-{{ section.id }}"
>
  <div class="services-overview__inner">
    {%- if section.settings.heading != blank -%}
      <h2 id="services-heading-{{ section.id }}" class="services-overview__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <services-overview
        class="services-overview__stage-wrap"
        data-autoplay="{{ autoplay }}"
        data-autoplay-ms="{{ section.settings.autoplay_interval | times: 1000 }}"
        data-total="{{ block_count }}"
      >
        <nav class="services-overview__tabs" role="tablist" aria-label="{{ 'services_overview.tabs_label' | t | default: 'Choose a service' }}">
          {%- for block in section.blocks -%}
            {%- assign tab_label = block.settings.tab_label | default: block.settings.title -%}
            <button
              type="button"
              class="services-overview__tab"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="services-overview__tab-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="services-overview__tab-label">{{ tab_label | escape }}</span>
            </button>
          {%- endfor -%}
        </nav>

        <div class="services-overview__orbit-column">
          <div class="services-overview__orbit" data-orbit>
            <svg class="services-overview__orbit-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <line class="services-overview__connector" data-connector x1="50" y1="50" x2="50" y2="50"></line>
              <circle class="services-overview__pulse" cx="50" cy="50" r="5"></circle>
            </svg>

            <div class="services-overview__ring services-overview__ring--inner" aria-hidden="true"></div>

            <div class="services-overview__core" aria-hidden="true">
              <svg class="services-overview__core-progress" viewBox="0 0 100 100" focusable="false">
                <circle data-progress cx="50" cy="50" r="48"></circle>
              </svg>
              <div class="services-overview__core-inner">
                {%- if section.settings.core_mark != blank -%}
                  <div class="services-overview__core-mark">{{ section.settings.core_mark | escape }}</div>
                {%- endif -%}
                {%- if section.settings.core_label != blank -%}
                  <div class="services-overview__core-label">{{ section.settings.core_label | escape }}</div>
                {%- endif -%}
              </div>
            </div>

            {%- for block in section.blocks -%}
              <button
                type="button"
                class="services-overview__node"
                data-node
                data-index="{{ forloop.index0 }}"
                data-short="{{ block.settings.tab_label | default: block.settings.title | escape }}"
                aria-label="{{ block.settings.title | escape }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="services-overview__node-icon">
                  {%- render 'services-overview-icon', name: block.settings.icon -%}
                </span>
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="services-overview__details" aria-live="polite">
          {%- for block in section.blocks -%}
            {%- assign kicker = block.settings.kicker -%}
            {%- if kicker == blank -%}
              {%- assign kicker = forloop.index | prepend: '0' | slice: -2, 2 | append: ' · ' | append: block.settings.title -%}
            {%- endif -%}
            <article
              class="services-overview__panel{% if forloop.first %} is-active{% endif %}"
              data-panel
              data-index="{{ forloop.index0 }}"
              role="tabpanel"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="services-overview__kicker">{{ kicker | escape }}</div>
              <h3 class="services-overview__panel-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <div class="services-overview__panel-text">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- assign has_benefits = false -%}
              {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
                {%- assign has_benefits = true -%}
              {%- endif -%}
              {%- if has_benefits -%}
                <ul class="services-overview__benefits">
                  {%- if block.settings.benefit_1 != blank -%}<li>{{ block.settings.benefit_1 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_2 != blank -%}<li>{{ block.settings.benefit_2 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_3 != blank -%}<li>{{ block.settings.benefit_3 | escape }}</li>{%- endif -%}
                </ul>
              {%- endif -%}

              {%- assign primary_label = block.settings.primary_label | default: section.settings.primary_label -%}
              {%- assign primary_url = block.settings.primary_url | default: section.settings.primary_url -%}
              {%- assign secondary_label = section.settings.secondary_label -%}
              {%- assign secondary_url = section.settings.secondary_url -%}
              {%- if primary_label != blank or secondary_label != blank -%}
                <div class="services-overview__actions">
                  {%- if primary_label != blank -%}
                    <a class="services-overview__btn services-overview__btn--primary" href="{{ primary_url | default: '#' }}">
                      {{ primary_label | escape }}
                      <span aria-hidden="true">→</span>
                    </a>
                  {%- endif -%}
                  {%- if secondary_label != blank -%}
                    <a class="services-overview__btn services-overview__btn--secondary" href="{{ secondary_url | default: '#' }}">
                      {{ secondary_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <p class="services-overview__sr-live" data-live aria-live="polite"></p>
      </services-overview>
    {%- else -%}
      <p class="services-overview__placeholder">
        {{ 'services_overview.add_services' | t | default: 'Add services blocks to get started.' }}
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'services-overview.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:services_overview.name",
  "tag": "section",
  "class": "shopify-section--services-overview",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:services_overview.heading_label",
      "default": "Unsere Leistungen"
    },
    {
      "type": "header",
      "content": "t:services_overview.core_header"
    },
    {
      "type": "text",
      "id": "core_mark",
      "label": "t:services_overview.core_mark_label",
      "default": "NI"
    },
    {
      "type": "text",
      "id": "core_label",
      "label": "t:services_overview.core_label_label",
      "default": "Digitales Wachstum als System"
    },
    {
      "type": "header",
      "content": "t:services_overview.actions_header"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:services_overview.primary_label_label",
      "default": "Mehr zur Leistung"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "t:services_overview.primary_url_label"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:services_overview.secondary_label_label",
      "default": "Projekt anfragen"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "t:services_overview.secondary_url_label"
    },
    {
      "type": "header",
      "content": "t:services_overview.behavior_header"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:services_overview.autoplay_label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "t:services_overview.autoplay_interval_label",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 7
    },
    {
      "type": "header",
      "content": "t:services_overview.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:services_overview.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:services_overview.accent_color_label",
      "default": "#df6c3d"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:services_overview.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:services_overview.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "t:services_overview.block_service",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:services_overview.icon_label",
          "options": [
            { "value": "compass", "label": "t:services_overview.icon_compass" },
            { "value": "layout", "label": "t:services_overview.icon_layout" },
            { "value": "bag", "label": "t:services_overview.icon_bag" },
            { "value": "search", "label": "t:services_overview.icon_search" },
            { "value": "chart", "label": "t:services_overview.icon_chart" },
            { "value": "quote", "label": "t:services_overview.icon_quote" },
            { "value": "spark", "label": "t:services_overview.icon_spark" },
            { "value": "globe", "label": "t:services_overview.icon_globe" }
          ],
          "default": "compass"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "t:services_overview.tab_label",
          "info": "t:services_overview.tab_label_info"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:services_overview.kicker_label",
          "info": "t:services_overview.kicker_label_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:services_overview.title_label",
          "default": "Strategie & Beratung"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:services_overview.description_label",
          "default": "<p>Wir bringen Klarheit in Angebot, Zielgruppe und Kommunikation – damit Website, SEO, Ads und Design gemeinsam auf Wachstum einzahlen.</p>"
        },
        {
          "type": "header",
          "content": "t:services_overview.benefits_header"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "t:services_overview.benefit_label",
          "default": "Digitale Positionierung und Angebotsstruktur"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "t:services_overview.benefit_label",
          "default": "Customer Journey und Conversion-Potenziale"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "t:services_overview.benefit_label",
          "default": "Klare Prioritäten statt beliebiger Einzelmaßnahmen"
        },
        {
          "type": "header",
          "content": "t:services_overview.cta_override_header"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "t:services_overview.primary_label_label",
          "info": "t:services_overview.cta_override_info"
        },
        {
          "type": "url",
          "id": "primary_url",
          "label": "t:services_overview.primary_url_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:services_overview.name",
      "category": "t:general.section",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "compass",
            "tab_label": "Strategie",
            "kicker": "01 · Strategie",
            "title": "Strategie & Beratung",
            "benefit_1": "Digitale Positionierung und Angebotsstruktur",
            "benefit_2": "Customer Journey und Conversion-Potenziale",
            "benefit_3": "Klare Prioritäten statt beliebiger Einzelmaßnahmen"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "layout",
            "tab_label": "Webdesign",
            "kicker": "02 · Design",
            "title": "Webdesign & UX",
            "benefit_1": "Individuelle Seitenarchitektur statt Standard-Layout",
            "benefit_2": "Klare Nutzerführung auf Desktop und Mobile",
            "benefit_3": "Designsystem für konsistente Markenwirkung"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "bag",
            "tab_label": "Shopify",
            "kicker": "03 · Entwicklung",
            "title": "Shopify & Entwicklung",
            "benefit_1": "Custom Sections und flexible Theme-Editor-Steuerung",
            "benefit_2": "Saubere technische Umsetzung mit Fokus auf Performance",
            "benefit_3": "Strukturen, die später ohne Chaos erweitert werden können"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "search",
            "tab_label": "SEO / GEO",
            "kicker": "04 · Sichtbarkeit",
            "title": "SEO & GEO",
            "benefit_1": "Technisches SEO und saubere Informationsarchitektur",
            "benefit_2": "Content-Strukturen für relevante Suchintentionen",
            "benefit_3": "GEO-orientierte Aufbereitung von Expertise und Entitäten"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "chart",
            "tab_label": "Google Ads",
            "kicker": "05 · Performance",
            "title": "Google Ads & Performance",
            "benefit_1": "Such-, Shopping- und Performance-Strukturen mit Zielbezug",
            "benefit_2": "Budgetsteuerung nach Wirtschaftlichkeit",
