{% comment %}
  Landingpage
  ----------------------------------------------------------------
  A composable landing-page container. It does not render content of
  its own — it provides the shared palette (from the chosen color
  scheme + an accent override) as CSS custom properties and stacks
  any landing-page theme blocks (lp-*) vertically, edge to edge.

  Each lp-* block is fully self-contained (own padding, own inner
  max-width, own background) and reads the --lp-* variables defined
  here. Because the blocks accept `@theme`, they can also be used on
  their own in any other section; outside this section the --lp-*
  variables fall back to the global theme tokens.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  if accent == blank
    assign accent = scheme.settings.accent
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .landingpage {
    --lp-pad-top: {{ section.settings.padding_top }}px;
    --lp-pad-bottom: {{ section.settings.padding_bottom }}px;
    --lp-maxw: {{ settings.max_page_width | default: '90rem' }};
    --lp-pad-x: var(--page-margin, 20px);
    --lp-accent: {{ accent }};
    --lp-accent-soft: {{ accent | color_modify: 'alpha', 0.12 }};
    --lp-accent-glow: {{ accent | color_modify: 'alpha', 0.30 }};
    {%- if scheme.settings.background != blank -%}
      --lp-bg: {{ scheme.settings.background }};
      --lp-surface: {{ scheme.settings.background_card | default: scheme.settings.background }};
      --lp-text: {{ scheme.settings.text }};
      --lp-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
      --lp-on-accent: {{ scheme.settings.on_primary_button | default: '#ffffff' }};
      --lp-line: {{ scheme.settings.text | color_modify: 'alpha', 0.12 }};
      --lp-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.22 }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
  }
{% endstyle %}

<div
  class="landingpage full-width color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="landingpage"
>
  {%- if section.blocks.size > 0 -%}
    {% content_for 'blocks' %}
  {%- else -%}
    <p class="landingpage__placeholder">
      {{ 'landingpage.empty' | t | default: 'Add landing-page blocks (Hero, Bento, Metrics, Case, Testimonial, Themes, CTA) to build your page.' }}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .landingpage {
    background: var(--lp-bg, var(--color-background, #fff));
    color: var(--lp-text, var(--color-foreground, #1f2328));
    padding-block: var(--lp-pad-top, 0) var(--lp-pad-bottom, 0);
    display: flow-root;
  }

  .landingpage__placeholder {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--page-margin, 20px);
    text-align: center;
    color: color-mix(in srgb, var(--lp-text, #1f2328) 60%, transparent);
    border: 1px dashed var(--lp-line, color-mix(in srgb, currentcolor 18%, transparent));
    border-radius: 16px;
  }
{% endstylesheet %}

