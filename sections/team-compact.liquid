{% comment %}
  Team compact (SYS §6 "Team", sand surface via scheme-1)
  ----------------------------------------------------------------
  Head: eyebrow, h2 with serif accent (accent-heading, columns 1–7)
  and intro text on the right (8–12). Below: portraits 3:4 per member
  block; without a photo a black tile with the initial in Newsreader
  italic and the tag "photo pending". Secondary button underneath.
  Mobile: two columns, an odd last portrait spans the row at 16:10.

  Colours come from the colour scheme tokens (--color-*). accent_color
  is optional and only tints the eyebrow dot and the monogram when set.
  Padding: min(setting, --section-y) – the setting acts as an upper bound.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign block_count = section.blocks.size
-%}

{{ 'section-team-compact.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .team-compact {
    {%- if accent != blank %}--tc-accent: {{ accent }};{% endif %}
    --tc-padding-top: {{ section.settings.padding_top }}px;
    --tc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<section
  class="team-compact full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="tc-heading-{{ section.id }}"{% endif %}
>
  <div class="team-compact__inner">
    <div class="team-compact__head">
      {%- if section.settings.kicker != blank -%}
        <p class="team-compact__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="tc-heading-{{ section.id }}" class="team-compact__heading">
          {%- render 'accent-heading', text: section.settings.heading -%}
        </h2>
      {%- endif -%}
      {%- if section.settings.intro != blank and section.settings.show_intro -%}
        <p class="team-compact__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    {%- if block_count > 0 -%}
      <ul class="team-compact__people" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign member_name = block.settings.name | strip
            assign auto_initial = member_name | upcase | slice: 0, 1
            assign initial = block.settings.initials | strip | default: auto_initial
            assign has_photo = false
            if block.settings.photo != blank
              assign has_photo = true
            endif
          -%}
          <li class="team-compact__member{% unless has_photo %} team-compact__member--empty{% endunless %}" {{ block.shopify_attributes }}>
            <figure class="team-compact__person">
              <div class="team-compact__photo">
                {%- if has_photo -%}
                  {%- assign photo_alt = block.settings.photo.alt | default: member_name -%}
                  {{
                    block.settings.photo
                    | image_url: width: 960
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 480, 640, 800, 960',
                      sizes: '(min-width: 1440px) 440px, (min-width: 861px) 31vw, 92vw',
                      alt: photo_alt,
                      class: 'team-compact__img'
                  }}
                {%- else -%}
                  {%- if initial != blank -%}
                    <span class="team-compact__initial" aria-hidden="true">{{ initial | escape }}</span>
                  {%- endif -%}
                  <span class="team-compact__tag">{{ 'team_compact.photo_pending' | t }}</span>
                {%- endif -%}
              </div>
              {%- if member_name != blank -%}
                <figcaption class="team-compact__name">{{ member_name | escape }}</figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="team-compact__placeholder">{{ 'team_compact.add_members' | t }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="team-compact__foot">
        <a class="btn btn--secondary team-compact__cta" href="{{ section.settings.cta_url | default: '#' }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:team_compact.name",
  "tag": "section",
  "class": "shopify-section--team-compact",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:team_compact.kicker_label",
      "default": "Team"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:team_compact.heading_label",
      "default": "Direkt. Klar. *Ohne Umwege.*"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:team_compact.intro_label",
      "default": "Bei NetImpulse arbeiten Strategie, Design, Marketing und Shopify-Umsetzung nah zusammen. So entstehen Websites, Kampagnen und Themes, die sich wie ein gemeinsames System anfühlen."
    },
    { "type": "checkbox", "id": "show_intro", "label": "Begleittext anzeigen", "default": true },
    {
      "type": "header",
      "content": "t:team_compact.cta_header"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:team_compact.cta_label_label",
      "default": "Team kennenlernen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:team_compact.cta_url_label"
    },
    {
      "type": "header",
      "content": "t:team_compact.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:team_compact.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:team_compact.accent_color_label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:team_compact.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:team_compact.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:team_compact.block_member",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:team_compact.member_name_label",
          "default": "Niklas"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "t:team_compact.member_initials_label",
          "info": "t:team_compact.member_initials_info"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "t:team_compact.member_photo_label",
          "info": "t:team_compact.member_photo_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:team_compact.name",
      "category": "t:general.section",
      "blocks": [
        { "type": "member", "settings": { "name": "Niklas" } },
        { "type": "member", "settings": { "name": "Tom" } },
        { "type": "member", "settings": { "name": "Lara" } }
      ]
    }
  ]
}
{% endschema %}
