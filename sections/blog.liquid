{% comment %}
  Blog — article index (SYS: light scheme, cards on the design system)
  ----------------------------------------------------------------
  Editorial header (eyebrow + h1 with optional *accent* + lead) and a
  responsive grid of article cards: photo (--r-lg), category label,
  title, excerpt and meta. Cards are surfaces with a 1px --color-line,
  no shadow, no gradient. Pagination as pill links.

  Colours come from the colour scheme tokens (--color-*); without a
  scheme the :root tokens (= scheme-sand) apply.
  Date: an empty date_format uses the locale-aware `format: 'date'`.
  Exactly one h1: without the header the blog title is a hidden h1.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{{ 'section-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme
  assign cols_tablet = s.columns | at_most: 2
  assign blog_heading = s.heading | default: blog.title
  assign label_prev = 'blog.pagination_previous' | t
  assign label_next = 'blog.pagination_next' | t
-%}

{% style %}
  #shopify-section-{{ section.id }} .blog {
    --blog-pt: {{ s.padding_top }}px;
    --blog-pb: {{ s.padding_bottom }}px;
    --blog-cols: {{ s.columns }};
    --blog-cols-tablet: {{ cols_tablet }};
    --blog-gap: {{ s.grid_gap }}px;
    --blog-radius: {{ s.card_radius }}px;
    --blog-ratio: {{ s.image_ratio }};
  }
{% endstyle %}

<section
  class="blog full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  aria-labelledby="BlogTitle-{{ section.id }}"
>
  <div class="blog__inner">
    {%- if s.show_header -%}
      <header class="blog__header">
        {%- if s.kicker != blank -%}
          <p class="blog__kicker eyebrow">{{ s.kicker | escape }}</p>
        {%- endif -%}
        <h1 id="BlogTitle-{{ section.id }}" class="blog__title">
          {%- render 'accent-heading', text: blog_heading -%}
        </h1>
        {%- if s.intro != blank -%}
          <div class="blog__intro rte">{{ s.intro }}</div>
        {%- endif -%}
      </header>
    {%- else -%}
      <h1 id="BlogTitle-{{ section.id }}" class="visually-hidden">{{ blog_heading | remove: '*' | escape }}</h1>
    {%- endif -%}

    {%- if blog.articles_count > 0 -%}
      {%- paginate blog.articles by s.posts_per_page -%}
        <ul class="blog__grid" role="list">
          {%- for article in blog.articles -%}
            {%- liquid
              assign cat = ''
              if article.tags.size > 0
                assign cat = article.tags.first
              endif
              if s.date_format != blank
                assign card_date = article.published_at | date: s.date_format
              else
                assign card_date = article.published_at | date: format: 'date'
              endif
            -%}
            <li class="blog__item">
              <article class="blog-card">
                <a class="blog-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                  {%- if article.image != blank -%}
                    {%- assign card_alt = article.image.alt | default: article.title -%}
                    {{
                      article.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 400, 600, 800, 1000, 1200',
                        sizes: '(min-width: 1101px) 30vw, (min-width: 861px) 45vw, 100vw',
                        class: 'blog-card__img',
                        alt: card_alt
                    }}
                  {%- else -%}
                    <span class="blog-card__placeholder"></span>
                  {%- endif -%}
                </a>
                <div class="blog-card__body">
                  {%- if s.show_category and cat != blank -%}
                    <p class="blog-card__category label-caps">{{ cat | escape }}</p>
                  {%- endif -%}
                  <h2 class="blog-card__title">
                    <a href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h2>
                  {%- if s.show_excerpt and article.excerpt_or_content != blank -%}
                    <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
                  {%- endif -%}
                  <p class="blog-card__meta">
                    {%- if s.show_author and article.author != blank -%}
                      <span class="blog-card__author">{{ article.author | escape }}</span>
                      <span class="blog-card__sep" aria-hidden="true">&middot;</span>
                    {%- endif -%}
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ card_date }}</time>
                    {%- if blog.comments_enabled? and article.comments_count > 0 -%}
                      <span class="blog-card__sep" aria-hidden="true">&middot;</span>
                      <span>{{ 'blog.comments_with_count' | t: count: article.comments_count }}</span>
                    {%- endif -%}
                  </p>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="blog__pagination" aria-label="{{ 'blog.pagination' | t }}">
            {{ paginate | default_pagination: previous: label_prev, next: label_next }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="blog__empty">{{ 'blog.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:blog.name",
  "tag": "section",
  "class": "shopify-section--blog",
  "settings": [
    {
      "type": "header",
      "content": "t:blog.header_header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "t:blog.show_header_label",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:blog.kicker_label",
      "default": "Blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:blog.heading_label",
      "info": "t:blog.heading_info"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:blog.intro_label"
    },
    {
      "type": "header",
      "content": "t:blog.layout_header"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:blog.columns_label",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:blog.grid_gap_label",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:blog.card_radius_label",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:blog.image_ratio_label",
      "options": [
        { "value": "16 / 9", "label": "t:blog.ratio_16_9" },
        { "value": "3 / 2", "label": "t:blog.ratio_3_2" },
        { "value": "4 / 3", "label": "t:blog.ratio_4_3" },
        { "value": "1 / 1", "label": "t:blog.ratio_1_1" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "header",
      "content": "t:blog.cards_header"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:blog.show_category_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:blog.show_excerpt_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:blog.show_author_label",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:blog.posts_per_page_label",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "t:blog.date_format_label",
      "info": "t:blog.date_format_info"
    },
    {
      "type": "header",
      "content": "t:blog.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:blog.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:blog.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:blog.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
