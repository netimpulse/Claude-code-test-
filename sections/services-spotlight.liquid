{% comment %}
  Services Spotlight
  ----------------------------------------------------------------
  Calmer sibling of services-overview. Same orbit metaphor, but:
    - no duplicate tab row above the orbit
    - every node carries a permanent label beneath it
    - the center is functional text (the active service title)
      instead of a brand-mark disc
    - clear hierarchy: the active node is bigger and coloured,
      the others are smaller and dimmed
    - no autoplay; users decide when content shifts
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign block_count = section.blocks.size
-%}

{{ 'section-services-spotlight.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .services-spotlight {
    --ssp-accent: {{ accent }};
    --ssp-accent-soft: {{ accent | color_modify: 'alpha', 0.13 }};
    --ssp-accent-glow: {{ accent | color_modify: 'alpha', 0.32 }};
    --ssp-padding-top: {{ section.settings.padding_top }}px;
    --ssp-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if scheme.settings.background != blank -%}
      --ssp-bg: {{ scheme.settings.background }};
      --ssp-text: {{ scheme.settings.text }};
      --ssp-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
      --ssp-line: {{ scheme.settings.text | color_modify: 'alpha', 0.14 }};
      --ssp-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.24 }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="services-spotlight full-width color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="ssp-heading-{{ section.id }}"{% endif %}
>
  <div class="services-spotlight__inner">
    {%- if section.settings.heading != blank -%}
      <h2 id="ssp-heading-{{ section.id }}" class="services-spotlight__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <services-spotlight class="services-spotlight__stage" data-total="{{ block_count }}">
        <div class="services-spotlight__orbit" data-orbit>
          <div class="services-spotlight__ring services-spotlight__ring--outer" aria-hidden="true"></div>
          <div class="services-spotlight__ring services-spotlight__ring--inner" aria-hidden="true"></div>

          <svg class="services-spotlight__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line class="services-spotlight__connector" data-connector x1="50" y1="50" x2="50" y2="50"></line>
          </svg>

          <div class="services-spotlight__center" aria-live="polite">
            {%- if section.settings.center_eyebrow != blank -%}
              <div class="services-spotlight__center-eyebrow">{{ section.settings.center_eyebrow | escape }}</div>
            {%- endif -%}
            <div class="services-spotlight__center-title" data-center-title>
              {{ section.blocks[0].settings.title | escape }}
            </div>
          </div>

          {%- for block in section.blocks -%}
            {%- assign label = block.settings.label | default: block.settings.title -%}
            <button
              type="button"
              class="services-spotlight__node{% if forloop.first %} is-active{% endif %}"
              data-node
              data-index="{{ forloop.index0 }}"
              aria-label="{{ block.settings.title | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="services-spotlight__node-icon" aria-hidden="true">
                {%- render 'services-overview-icon', name: block.settings.icon -%}
              </span>
              <span class="services-spotlight__node-label">{{ label | escape }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="services-spotlight__details" aria-live="polite">
          {%- for block in section.blocks -%}
            <article
              class="services-spotlight__panel{% if forloop.first %} is-active{% endif %}"
              data-panel
              data-index="{{ forloop.index0 }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.description != blank -%}
                <div class="services-spotlight__text">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- assign has_benefits = false -%}
              {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
                {%- assign has_benefits = true -%}
              {%- endif -%}
              {%- if has_benefits -%}
                <ul class="services-spotlight__benefits">
                  {%- if block.settings.benefit_1 != blank -%}<li>{{ block.settings.benefit_1 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_2 != blank -%}<li>{{ block.settings.benefit_2 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_3 != blank -%}<li>{{ block.settings.benefit_3 | escape }}</li>{%- endif -%}
                </ul>
              {%- endif -%}

              {%- assign primary_label = block.settings.primary_label | default: section.settings.primary_label -%}
              {%- assign primary_url = block.settings.primary_url | default: section.settings.primary_url -%}
              {%- assign secondary_label = section.settings.secondary_label -%}
              {%- assign secondary_url = section.settings.secondary_url -%}
              {%- if primary_label != blank or secondary_label != blank -%}
                <div class="services-spotlight__actions">
                  {%- if primary_label != blank -%}
                    <a class="services-spotlight__btn services-spotlight__btn--primary" href="{{ primary_url | default: '#' }}">
                      {{ primary_label | escape }}
                      <span aria-hidden="true">→</span>
                    </a>
                  {%- endif -%}
                  {%- if secondary_label != blank -%}
                    <a class="services-spotlight__btn services-spotlight__btn--secondary" href="{{ secondary_url | default: '#' }}">
                      {{ secondary_label | escape }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <p class="services-spotlight__sr-live" data-live aria-live="polite"></p>
      </services-spotlight>
    {%- else -%}
      <p class="services-spotlight__placeholder">
        {{ 'services_spotlight.add_services' | t | default: 'Add services blocks to get started.' }}
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'services-spotlight.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:services_spotlight.name",
  "tag": "section",
  "class": "shopify-section--services-spotlight",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:services_spotlight.heading_label",
      "default": "Unsere Leistungen"
    },
    {
      "type": "text",
      "id": "center_eyebrow",
      "label": "t:services_spotlight.center_eyebrow_label",
      "default": "Im Fokus"
    },
    {
      "type": "header",
      "content": "t:services_spotlight.actions_header"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:services_spotlight.primary_label_label",
      "default": "Mehr zur Leistung"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "t:services_spotlight.primary_url_label"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:services_spotlight.secondary_label_label",
      "default": "Projekt anfragen"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "t:services_spotlight.secondary_url_label"
    },
    {
      "type": "header",
      "content": "t:services_spotlight.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:services_spotlight.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:services_spotlight.accent_color_label",
      "default": "#df6c3d"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:services_spotlight.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:services_spotlight.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "t:services_spotlight.block_service",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:services_spotlight.icon_label",
          "options": [
            { "value": "compass", "label": "t:services_overview.icon_compass" },
            { "value": "layout", "label": "t:services_overview.icon_layout" },
            { "value": "bag", "label": "t:services_overview.icon_bag" },
            { "value": "search", "label": "t:services_overview.icon_search" },
            { "value": "chart", "label": "t:services_overview.icon_chart" },
            { "value": "quote", "label": "t:services_overview.icon_quote" },
            { "value": "spark", "label": "t:services_overview.icon_spark" },
            { "value": "globe", "label": "t:services_overview.icon_globe" }
          ],
          "default": "compass"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:services_spotlight.label_label",
          "info": "t:services_spotlight.label_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:services_spotlight.title_label",
          "default": "Strategie & Beratung"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:services_spotlight.description_label",
          "default": "<p>Wir bringen Klarheit in Angebot, Zielgruppe und Kommunikation – damit Website, SEO, Ads und Design gemeinsam auf Wachstum einzahlen.</p>"
        },
        {
          "type": "header",
          "content": "t:services_spotlight.benefits_header"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "t:services_spotlight.benefit_label",
          "default": "Digitale Positionierung und Angebotsstruktur"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "t:services_spotlight.benefit_label",
          "default": "Customer Journey und Conversion-Potenziale"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "t:services_spotlight.benefit_label",
          "default": "Klare Prioritäten statt beliebiger Einzelmaßnahmen"
        },
        {
          "type": "header",
          "content": "t:services_spotlight.cta_override_header"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "t:services_spotlight.primary_label_label",
          "info": "t:services_spotlight.cta_override_info"
        },
        {
          "type": "url",
          "id": "primary_url",
          "label": "t:services_spotlight.primary_url_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:services_spotlight.name",
      "category": "t:general.section",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "compass",
            "label": "Strategie",
            "title": "Strategie & Beratung",
            "benefit_1": "Digitale Positionierung und Angebotsstruktur",
            "benefit_2": "Customer Journey und Conversion-Potenziale",
            "benefit_3": "Klare Prioritäten statt beliebiger Einzelmaßnahmen"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "layout",
            "label": "Webdesign",
            "title": "Webdesign & UX",
            "benefit_1": "Individuelle Seitenarchitektur statt Standard-Layout",
            "benefit_2": "Klare Nutzerführung auf Desktop und Mobile",
            "benefit_3": "Designsystem für konsistente Markenwirkung"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "bag",
            "label": "Shopify",
            "title": "Shopify & Entwicklung",
            "benefit_1": "Custom Sections und flexible Theme-Editor-Steuerung",
            "benefit_2": "Saubere technische Umsetzung mit Fokus auf Performance",
            "benefit_3": "Strukturen, die später ohne Chaos erweitert werden können"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "search",
            "label": "SEO / GEO",
            "title": "SEO & GEO",
            "benefit_1": "Technisches SEO und saubere Informationsarchitektur",
            "benefit_2": "Content-Strukturen für relevante Suchintentionen",
            "benefit_3": "GEO-orientierte Aufbereitung von Expertise und Entitäten"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "chart",
            "label": "Google Ads",
            "title": "Google Ads & Performance",
            "benefit_1": "Such-, Shopping- und Performance-Strukturen mit Zielbezug",
            "benefit_2": "Budgetsteuerung nach Wirtschaftlichkeit",
            "benefit_3": "Kontinuierliche Auswertung und Verbesserung"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "quote",
            "label": "Content",
            "title": "Content & Storytelling",
            "benefit_1": "Präzise Botschaften statt austauschbarer Werbetexte",
            "benefit_2": "Leistungsseiten mit klarer Argumentationslinie",
            "benefit_3": "Content, der Design und Conversion unterstützt"
          }
        }
      ]
    }
  ]
}
{% endschema %}
