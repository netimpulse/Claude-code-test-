{% comment %}
  Theme Store Deck
  ----------------------------------------------------------------
  A teaser for the theme store. Products from a chosen collection
  render as cards in a horizontal scroller (drag / wheel / arrows);
  title, price, category and tags come straight from each product.
  A fixed "store" call-to-action card sits to the right and does
  NOT scroll with the themes.

  - Heading + optional highlighted accent word and subheading.
  - Themes come from a Shopify collection (price, image, type and
    tags are pulled from the product — nothing to retype).
  - Optional custom card background, independent of the section bg.
  - Cards lift on hover.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign source = section.settings.collection
  assign limit = section.settings.products_to_show
  assign heading = section.settings.heading
  assign highlight = section.settings.heading_highlight
  assign subheading = section.settings.subheading
  assign card_bg = section.settings.card_background
  assign show_tags = section.settings.show_tags
  assign max_tags = section.settings.max_tags

  assign heading_html = heading | escape
  if highlight != blank and heading contains highlight
    assign hl = highlight | escape
    assign accent_span = '<span class="tsd__heading-accent">' | append: hl | append: '</span>'
    assign heading_html = heading_html | replace: hl, accent_span
  endif

  assign card_class = 'tsd__card'
  if card_bg != blank
    assign card_class = 'tsd__card tsd__card--filled'
  endif
-%}

{{ 'section-theme-store-deck.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
    {%- endif -%}
    {%- if scheme.settings.text != blank -%}
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .tsd {
    --tsd-pad-top: {{ section.settings.padding_top }}px;
    --tsd-pad-bottom: {{ section.settings.padding_bottom }}px;
    {%- if card_bg != blank -%}--tsd-card-bg: {{ card_bg }};{%- endif -%}
    {%- if section.settings.cta_background != blank -%}--tsd-cta-bg: {{ section.settings.cta_background }};{%- endif -%}
    {%- if section.settings.cta_text != blank -%}--tsd-cta-text: {{ section.settings.cta_text }};{%- endif -%}
  }
{% endstyle %}

<theme-store-deck
  class="tsd full-width color-scheme color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="theme-store-deck"
>
  <div class="tsd__inner">
    <header class="tsd__header">
      <div class="tsd__intro">
        {%- if heading != blank -%}
          <h2 class="tsd__heading">{{ heading_html }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tsd__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="tsd__nav">
        <button type="button" class="tsd__nav-btn" data-tsd-prev aria-label="{{ 'theme_store_deck.prev' | t | default: 'Vorheriges' }}">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="tsd__nav-btn" data-tsd-next aria-label="{{ 'theme_store_deck.next' | t | default: 'Nächstes' }}">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>

    <div class="tsd__layout">
      <div class="tsd__scroller" data-tsd-track>
        {%- if source != blank and source.products.size > 0 -%}
          {%- for product in source.products limit: limit -%}
            <a class="{{ card_class }}" href="{{ product.url }}">
              <div class="tsd__preview" aria-hidden="true">
                {%- if product.featured_image != blank -%}
                  {%- render 'image',
                    image: product.featured_image,
                    class: 'tsd__preview-img',
                    width: 800,
                    height: 572,
                    crop: 'center'
                  -%}
                {%- else -%}
                  <div class="tsd__chrome">
                    <span class="tsd__dots"><i></i><i></i><i></i></span>
                    <span class="tsd__chrome-bar"></span>
                  </div>
                  <span class="tsd__rule"></span>
                  <div class="tsd__screen">
                    <span class="tsd__accent-bar"></span>
                    <span class="tsd__line tsd__line--1"></span>
                    <span class="tsd__line tsd__line--2"></span>
                  </div>
                {%- endif -%}
              </div>

              <div class="tsd__info">
                <div class="tsd__row">
                  <h3 class="tsd__name">{{ product.title | escape }}</h3>
                  <span class="tsd__price">{{ product.price | money }}</span>
                </div>
                {%- if product.type != blank -%}
                  <p class="tsd__category">{{ product.type | escape }}</p>
                {%- endif -%}
                {%- if show_tags and product.tags.size > 0 -%}
                  <div class="tsd__tags">
                    {%- for tag in product.tags limit: max_tags -%}
                      <span class="tsd__tag">{{ tag | escape }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <p class="tsd__empty">
            {{ 'theme_store_deck.empty' | t | default: 'Wähle eine Collection im Theme-Editor, um Themes anzuzeigen.' }}
          </p>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_heading != blank or section.settings.cta_button_label != blank -%}
        <aside class="tsd__cta">
          {%- if section.settings.cta_label != blank -%}
            <span class="tsd__cta-label">
              <span class="tsd__cta-dot" aria-hidden="true"></span>
              {{ section.settings.cta_label | escape }}
            </span>
          {%- endif -%}
          {%- if section.settings.cta_heading != blank -%}
            <h3 class="tsd__cta-heading">{{ section.settings.cta_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.cta_button_label != blank -%}
            <a class="tsd__cta-btn" href="{{ section.settings.cta_button_url | default: '#' }}">{{ section.settings.cta_button_label | escape }}</a>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</theme-store-deck>

<script src="{{ 'theme-store-deck.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Theme store deck",
  "tag": "section",
  "class": "shopify-section--theme-store-deck",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unsere Themes & Packs." },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted word", "info": "Word inside the heading that gets the accent style. Must match exactly.", "default": "Packs" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Performance-Themes und Section-Packs — sofort einsatzbereit." },
    { "type": "header", "content": "Themes (Shopify)" },
    { "type": "collection", "id": "collection", "label": "Themes collection", "info": "Each product becomes a card. Title, price, image, type (category) and tags are pulled from the product." },
    { "type": "range", "id": "products_to_show", "label": "Themes to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_tags", "label": "Show product tags", "default": true },
    { "type": "range", "id": "max_tags", "label": "Max tags per card", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "header", "content": "Card" },
    { "type": "color", "id": "card_background", "label": "Card background", "info": "Leave empty to use the section background." },
    { "type": "header", "content": "Store CTA (fixed)" },
    { "type": "text", "id": "cta_label", "label": "Eyebrow label", "default": "Theme Store" },
    { "type": "textarea", "id": "cta_heading", "label": "Heading", "default": "Alle Themes und Packs ansehen." },
    { "type": "text", "id": "cta_button_label", "label": "Button label", "default": "Zum Store" },
    { "type": "url", "id": "cta_button_url", "label": "Button link" },
    { "type": "color", "id": "cta_background", "label": "CTA background", "default": "#0f0f0f" },
    { "type": "color", "id": "cta_text", "label": "CTA text", "default": "#ffffff" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "Theme store deck", "category": "Theme store" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
