{% comment %}
  Theme Store Deck
  ----------------------------------------------------------------
  A horizontally scrollable deck of theme/pack cards that sit
  directly on the section background (no outer container card).
  Each card is an editorial wireframe preview (light or dark) with
  a name, price, category and tag pills, plus an optional dark
  "store" call-to-action card at the end.

  - Heading + optional highlighted accent word and subheading.
  - Theme cards are repeatable blocks; merchants add as many as
    they like.
  - The deck scrolls with the mouse (drag / wheel / trackpad) or
    with the prev/next arrows.
  - Cards lift on hover.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign heading = section.settings.heading
  assign highlight = section.settings.heading_highlight
  assign subheading = section.settings.subheading

  assign heading_html = heading | escape
  if highlight != blank and heading contains highlight
    assign hl_esc = highlight | escape
    assign accent_span = '<span class="tsd__heading-accent">' | append: hl_esc | append: '</span>'
    assign heading_html = heading_html | replace: hl_esc, accent_span
  endif
-%}

{{ 'section-theme-store-deck.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
    {%- endif -%}
    {%- if scheme.settings.text != blank -%}
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .tsd {
    --tsd-pad-top: {{ section.settings.padding_top }}px;
    --tsd-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<theme-store-deck
  class="tsd full-width color-scheme color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="theme-store-deck"
>
  <div class="tsd__inner">
    <header class="tsd__header">
      <div class="tsd__intro">
        {%- if heading != blank -%}
          <h2 class="tsd__heading">{{ heading_html }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tsd__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="tsd__nav">
        <button
          type="button"
          class="tsd__nav-btn"
          data-tsd-prev
          aria-label="{{ 'theme_store_deck.prev' | t | default: 'Vorheriges' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="tsd__nav-btn"
          data-tsd-next
          aria-label="{{ 'theme_store_deck.next' | t | default: 'Nächstes' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="tsd__track" data-tsd-track>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'theme' -%}
            {%- assign style = block.settings.preview_style | default: 'light' -%}
            <li class="tsd__item" {{ block.shopify_attributes }}>
              <a class="tsd__card tsd__card--theme tsd__card--{{ style }}" href="{{ block.settings.url | default: '#' }}">
                <div class="tsd__preview" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    {%- render 'image',
                      image: block.settings.image,
                      class: 'tsd__preview-img',
                      width: 800,
                      height: 572,
                      crop: 'center'
                    -%}
                  {%- else -%}
                    <div class="tsd__chrome">
                      <span class="tsd__dots"><i></i><i></i><i></i></span>
                      <span class="tsd__chrome-bar"></span>
                    </div>
                    <span class="tsd__rule"></span>
                    <div class="tsd__screen">
                      <span class="tsd__accent-bar"></span>
                      <span class="tsd__line tsd__line--1"></span>
                      <span class="tsd__line tsd__line--2"></span>
                    </div>
                  {%- endif -%}
                </div>

                <div class="tsd__info">
                  <div class="tsd__row">
                    <h3 class="tsd__name">{{ block.settings.title | escape }}</h3>
                    {%- if block.settings.price != blank -%}
                      <span class="tsd__price">{{ block.settings.price | escape }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.category != blank -%}
                    <p class="tsd__category">{{ block.settings.category | escape }}</p>
                  {%- endif -%}
                  {%- assign tags = block.settings.tags | split: ',' -%}
                  {%- if tags.size > 0 -%}
                    <div class="tsd__tags">
                      {%- for tag in tags -%}
                        {%- assign tag_clean = tag | strip -%}
                        {%- if tag_clean != blank -%}
                          <span class="tsd__tag">{{ tag_clean | escape }}</span>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- when 'cta' -%}
            <li class="tsd__item tsd__item--cta" {{ block.shopify_attributes }}>
              <a class="tsd__card tsd__card--cta" href="{{ block.settings.button_url | default: '#' }}">
                {%- if block.settings.label != blank -%}
                  <span class="tsd__cta-label">
                    <span class="tsd__cta-dot" aria-hidden="true"></span>
                    {{ block.settings.label | escape }}
                  </span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="tsd__cta-heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="tsd__cta-btn">{{ block.settings.button_label | escape }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="tsd__empty">
        {{ 'theme_store_deck.empty' | t | default: 'Füge Theme-Karten im Theme-Editor hinzu.' }}
      </p>
    {%- endif -%}
  </div>
</theme-store-deck>

<script src="{{ 'theme-store-deck.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Theme store deck",
  "tag": "section",
  "class": "shopify-section--theme-store-deck",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unsere Themes & Packs." },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted word", "info": "Word inside the heading that gets the accent style. Must match exactly.", "default": "Packs" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Performance-Themes und Section-Packs — sofort einsatzbereit." },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Theme card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Meridian" },
        { "type": "text", "id": "category", "label": "Category", "default": "Business Theme" },
        { "type": "text", "id": "price", "label": "Price", "info": "Free text — include the currency, e.g. 149 €.", "default": "149 €" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "select", "id": "preview_style", "label": "Preview style", "options": [
          { "value": "light", "label": "Light" },
          { "value": "dark", "label": "Dark" }
        ], "default": "light" },
        { "type": "image_picker", "id": "image", "label": "Preview image", "info": "Optional. Replaces the wireframe mock." },
        { "type": "text", "id": "tags", "label": "Tags", "info": "Comma-separated, e.g. Business, Cases.", "default": "Business, Cases" }
      ]
    },
    {
      "type": "cta",
      "name": "Store CTA card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Theme Store" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Alle Themes und Packs ansehen." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Zum Store" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Theme store deck",
      "category": "Theme store",
      "blocks": [
        { "type": "theme", "settings": { "title": "Meridian", "category": "Business Theme", "price": "149 €", "preview_style": "light", "tags": "Business, Cases" } },
        { "type": "theme", "settings": { "title": "Loom", "category": "Fashion Theme", "price": "109 €", "preview_style": "dark", "tags": "Fashion, Shop" } },
        { "type": "theme", "settings": { "title": "Blocks Kit", "category": "Section Pack", "price": "79 €", "preview_style": "light", "tags": "Sections, Editor" } },
        { "type": "cta", "settings": { "label": "Theme Store", "heading": "Alle Themes und Packs ansehen.", "button_label": "Zum Store" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
