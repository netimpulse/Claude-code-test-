{% comment %}
  Article — editorial blog post (SYS: light scheme, reading typography)
  ----------------------------------------------------------------
  Header in the reading column (category eyebrow, the page's only h1,
  subtitle, meta line), then the featured image as a photo with --r-lg
  (no overlay, no gradient). Body in .rte reading type (--text-body,
  line-height 1.7, max 68ch, h2/h3 in Bricolage, links in .text-link
  style), pull quotes on a --color-surface card, tags + share, editor
  blocks (newsletter/CTA, related posts) and native comments.

  Colours come from the colour scheme tokens (--color-*); quote_* only
  override the quote card when they are filled (empty = design system).
  Date: an empty date_format uses the locale-aware `format: 'date'`.
  overlay_opacity is kept for compatibility but no longer rendered
  (SYS: no overlays on photos).

  Optional per-article extras (set in the article's metafields):
    - article.metafields.custom.category       → category label override
    - article.metafields.custom.hero_subtitle  → small line under the title

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{{ 'section-article.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme

  assign category = ''
  if s.category_source == 'metafield'
    assign category = article.metafields.custom.category
  endif
  if category == blank and article.tags.size > 0
    assign category = article.tags.first
  endif
  if category == blank
    assign category = s.category_fallback
  endif

  assign hero_subtitle = article.metafields.custom.hero_subtitle

  assign date_iso = article.published_at | date: '%Y-%m-%d'
  if s.date_format != blank
    assign date_nice = article.published_at | date: s.date_format
  else
    assign date_nice = article.published_at | date: format: 'date'
  endif

  assign words = article.content | strip_html | split: ' ' | size
  assign read_min = words | divided_by: 200 | at_least: 1

  assign show_footer = false
  if s.show_share
    assign show_footer = true
  endif
  if s.show_tags and article.tags.size > 0
    assign show_footer = true
  endif

  assign fallback_newsletter_submit = 'blog.newsletter_submit' | t
  assign label_prev = 'blog.pagination_previous' | t
  assign label_next = 'blog.pagination_next' | t
-%}

{% style %}
  #shopify-section-{{ section.id }} .article {
    --art-pt: calc({{ s.padding_top }}px * var(--ui-scale, 1));
    --art-pb: calc({{ s.padding_bottom }}px * var(--ui-scale, 1));
    --art-content-w: calc({{ s.content_width }}px * var(--ui-scale, 1));
    --art-hero-h: calc({{ s.hero_height }}px * var(--ui-scale, 1));
    --art-radius: calc({{ s.media_radius }}px * var(--ui-scale, 1));
    {%- if s.quote_background != blank %}
    --art-quote-bg: {{ s.quote_background }};
    {%- endif -%}
    {%- if s.quote_text != blank %}
    --art-quote-text: {{ s.quote_text }};
    {%- endif %}
  }
{% endstyle %}

<article
  class="article article--align-{{ s.text_align }} full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ---------- Header + photo ---------- {%- endcomment -%}
  <header class="article__hero{% if article.image != blank %} article__hero--image{% else %} article__hero--text{% endif %}">
    <div class="article__hero-inner">
      {%- if s.show_category and category != blank -%}
        <p class="article__category eyebrow">{{ category | escape }}</p>
      {%- endif -%}
      <h1 class="article__hero-title">{{ article.title | escape }}</h1>
      {%- if hero_subtitle != blank -%}
        <p class="article__hero-subtitle">{{ hero_subtitle | escape }}</p>
      {%- endif -%}
      <p class="article__meta">
        {%- if s.show_author and article.author != blank -%}
          <span class="article__author">{{ article.author | escape }}</span>
          <span class="article__meta-sep" aria-hidden="true">&middot;</span>
        {%- endif -%}
        <time class="article__date" datetime="{{ date_iso }}">{{ date_nice }}</time>
        {%- if s.show_reading_time -%}
          <span class="article__meta-sep" aria-hidden="true">&middot;</span>
          <span class="article__readtime">{{ 'blog.read_time_html' | t: minutes: read_min }}</span>
        {%- endif -%}
      </p>
    </div>

    {%- if article.image != blank -%}
      <figure class="article__hero-media">
        {%- assign hero_alt = article.image.alt | default: article.title -%}
        {{
          article.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 1440px) 1328px, calc(100vw - 40px)',
            class: 'article__hero-img',
            alt: hero_alt
        }}
      </figure>
    {%- endif -%}
  </header>

  {%- comment -%} ---------- Body ---------- {%- endcomment -%}
  <div class="article__container">
    {%- if s.show_title_above_body -%}
      <h2 class="article__title">{{ article.title | escape }}</h2>
    {%- endif -%}

    <div class="article__body rte">
      {{ article.content }}
    </div>

    {%- if show_footer -%}
      <div class="article__footer">
        {%- if s.show_tags and article.tags.size > 0 -%}
          <div class="article__tags">
            <span class="article__tags-label label-caps">{{ 'blog.tagged' | t }}</span>
            <ul class="article__tag-list" role="list">
              {%- for tag in article.tags -%}
                <li><a class="article__tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if s.show_share -%}
          {%- assign share_url = shop.url | append: article.url | url_encode -%}
          {%- assign share_title = article.title | url_encode -%}
          <div class="article__share">
            <span class="article__share-label label-caps">{{ 'blog.share' | t }}</span>
            <a class="article__share-link" href="https://twitter.com/intent/tweet?text={{ share_title }}&url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_twitter' | t }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg>
            </a>
            <a class="article__share-link" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_facebook' | t }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.4H7.7V13h2.7v8h3.1Z"/></svg>
            </a>
            <a class="article__share-link" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_linkedin' | t }}">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.98 3.5a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2ZM3.2 9h3.6v12H3.2V9Zm5.9 0h3.4v1.6h.1c.5-.9 1.7-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5V21h-3.6v-6c0-1.4 0-3.3-2-3.3s-2.3 1.6-2.3 3.2V21H9.1V9Z"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Editor blocks (Newsletter/CTA, Related) ---------- {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="article__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'cta' -%}
            <div
              class="article-cta"
              {{ block.shopify_attributes }}
              {%- if block.settings.background != blank %} style="--art-cta-bg: {{ block.settings.background }};"{% endif -%}
            >
              <div class="article-cta__text-wrap">
                {%- if block.settings.heading != blank -%}
                  <h2 class="article-cta__heading">{%- render 'accent-heading', text: block.settings.heading -%}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="article-cta__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
              {%- if block.settings.mode == 'newsletter' -%}
                {%- form 'customer', class: 'article-cta__form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="article-cta__success" role="status">{{ 'blog.newsletter_success' | t }}</p>
                  {%- else -%}
                    {%- if form.errors -%}
                      <div class="article__notice article__notice--error" role="alert" id="NewsletterError-{{ block.id }}">
                        {{ form.errors | default_errors }}
                      </div>
                    {%- endif -%}
                    <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'blog.comment_form_email' | t }}</label>
                    <input
                      class="article__input"
                      type="email"
                      id="NewsletterEmail-{{ block.id }}"
                      name="contact[email]"
                      value="{{ form.email | escape }}"
                      placeholder="{{ 'blog.newsletter_placeholder' | t }}"
                      autocomplete="email"
                      spellcheck="false"
                      required
                      {%- if form.errors %} aria-invalid="true" aria-describedby="NewsletterError-{{ block.id }}"{% endif %}
                    >
                    {%- assign nl_label = block.settings.button_label | default: fallback_newsletter_submit -%}
                    <button type="submit" class="btn btn--primary article-cta__submit">
                      <span>{{ nl_label | escape }}</span>
                      <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                    </button>
                  {%- endif -%}
                {%- endform -%}
              {%- elsif block.settings.button_label != blank -%}
                <div class="article-cta__actions">
                  <a class="btn btn--primary article-cta__btn" href="{{ block.settings.button_url | default: routes.root_url }}">
                    <span>{{ block.settings.button_label | escape }}</span>
                    <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- when 'related' -%}
            {%- if blog.articles.size > 1 -%}
              {%- assign related_count = block.settings.count | default: 3 -%}
              {%- assign shown = 0 -%}
              <div class="article-related" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="article-related__heading">{%- render 'accent-heading', text: block.settings.heading -%}</h2>
                {%- endif -%}
                <ul class="article-related__grid" role="list">
                  {%- for art in blog.articles -%}
                    {%- if art.id == article.id -%}{%- continue -%}{%- endif -%}
                    {%- if shown >= related_count -%}{%- break -%}{%- endif -%}
                    {%- liquid
                      assign shown = shown | plus: 1
                      if s.date_format != blank
                        assign rel_date = art.published_at | date: s.date_format
                      else
                        assign rel_date = art.published_at | date: format: 'date'
                      endif
                    -%}
                    <li class="article-related__item">
                      <a class="article-related__card" href="{{ art.url }}">
                        {%- if block.settings.show_image -%}
                          <span class="article-related__media">
                            {%- if art.image != blank -%}
                              {%- assign rel_alt = art.image.alt | default: art.title -%}
                              {{
                                art.image
                                | image_url: width: 600
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '300, 400, 600',
                                  sizes: '(min-width: 861px) 30vw, 90vw',
                                  class: 'article-related__img',
                                  alt: rel_alt
                              }}
                            {%- else -%}
                              <span class="article-related__placeholder"></span>
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                        <span class="article-related__body">
                          <span class="article-related__title">{{ art.title | escape }}</span>
                          <time class="article-related__date" datetime="{{ art.published_at | date: '%Y-%m-%d' }}">{{ rel_date }}</time>
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Comments ---------- {%- endcomment -%}
  {%- if blog.comments_enabled? -%}
    <section class="article__comments article__comments--{{ s.comments_layout }}" id="comments" aria-labelledby="CommentsTitle-{{ section.id }}">
      <h2 class="article__comments-title" id="CommentsTitle-{{ section.id }}">
        {%- if article.comments_count > 0 -%}
          {{ 'blog.comments_with_count' | t: count: article.comments_count }}
        {%- else -%}
          {{ 'blog.comments' | t }}
        {%- endif -%}
      </h2>

      {%- if comment != blank and comment.status -%}
        {%- if comment.status == 'pending' or blog.moderated? -%}
          <p class="article__notice" role="status">{{ 'blog.comment_success_moderated' | t }}</p>
        {%- else -%}
          <p class="article__notice" role="status">{{ 'blog.comment_success' | t }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if article.comments_count > 0 -%}
        {%- paginate article.comments by 20 -%}
          <ol class="article__comment-list" role="list">
            {%- for comment in article.comments -%}
              {%- liquid
                assign c_initial = comment.author | strip | slice: 0, 1 | upcase
                if s.date_format != blank
                  assign c_date = comment.created_at | date: s.date_format
                else
                  assign c_date = comment.created_at | date: format: 'date'
                endif
              -%}
              <li class="article__comment" id="comment-{{ comment.id }}">
                <span class="article__comment-avatar" aria-hidden="true">{{ c_initial | default: '?' | escape }}</span>
                <div class="article__comment-bubble">
                  <p class="article__comment-head">
                    <span class="article__comment-author">{{ comment.author | escape }}</span>
                    <time class="article__comment-date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ c_date }}</time>
                  </p>
                  <div class="article__comment-body rte">{{ comment.content }}</div>
                </div>
              </li>
            {%- endfor -%}
          </ol>
          {%- if paginate.pages > 1 -%}
            <nav class="article__pagination" aria-label="{{ 'blog.comments_pagination' | t }}">
              {{ paginate | default_pagination: anchor: 'comments', previous: label_prev, next: label_next }}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}

      <div class="article__form-wrap">
        <h3 class="article__form-title">{{ 'blog.comment_form_title' | t }}</h3>
        {%- form 'new_comment', article, class: 'article__composer' -%}
          {%- liquid
            assign err_author = false
            assign err_email = false
            assign err_body = false
            if form.errors
              if form.errors contains 'author'
                assign err_author = true
              endif
              if form.errors contains 'email'
                assign err_email = true
              endif
              if form.errors contains 'body'
                assign err_body = true
              endif
            endif
          -%}
          {%- if form.errors -%}
            <div class="article__notice article__notice--error" role="alert" id="CommentErrors-{{ section.id }}">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div class="article__composer-meta">
            <div class="article__field">
              <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
              <input
                class="article__input"
                type="text"
                name="comment[author]"
                id="CommentAuthor-{{ section.id }}"
                value="{{ form.author | escape }}"
                autocomplete="name"
                required
                {%- if err_author %} aria-invalid="true" aria-describedby="CommentErrors-{{ section.id }}"{% endif %}
              >
            </div>
            <div class="article__field">
              <label for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
              <input
                class="article__input"
                type="email"
                name="comment[email]"
                id="CommentEmail-{{ section.id }}"
                value="{{ form.email | escape }}"
                placeholder="{{ 'blog.email_placeholder' | t }}"
                autocomplete="email"
                spellcheck="false"
                required
                aria-describedby="CommentEmailHint-{{ section.id }}{% if err_email %} CommentErrors-{{ section.id }}{% endif %}"
                {%- if err_email %} aria-invalid="true"{% endif %}
              >
              <p class="article__field-hint" id="CommentEmailHint-{{ section.id }}">{{ 'blog.comment_form_email_info' | t }}</p>
            </div>
          </div>
          <div class="article__field">
            <label for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
            <textarea
              class="article__input article__textarea"
              name="comment[body]"
              id="CommentBody-{{ section.id }}"
              rows="5"
              placeholder="{{ 'blog.comment_placeholder' | t }}"
              required
              {%- if err_body %} aria-invalid="true" aria-describedby="CommentErrors-{{ section.id }}"{% endif %}
            >{{ form.body | escape }}</textarea>
          </div>
          <div class="article__composer-actions">
            <button type="submit" class="btn btn--primary article__send">
              <span>{{ 'blog.comment_form_submit' | t }}</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </button>
            {%- if blog.moderated? -%}
              <p class="article__form-note">{{ 'blog.comment_moderated' | t }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "t:article.name",
  "tag": "section",
  "class": "shopify-section--article",
  "settings": [
    {
      "type": "header",
      "content": "t:article.hero_header"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:article.show_category_label",
      "default": true
    },
    {
      "type": "select",
      "id": "category_source",
      "label": "t:article.category_source_label",
      "options": [
        { "value": "tag", "label": "t:article.category_source_tag" },
        { "value": "metafield", "label": "t:article.category_source_metafield" }
      ],
      "default": "tag"
    },
    {
      "type": "text",
      "id": "category_fallback",
      "label": "t:article.category_fallback_label",
      "info": "t:article.category_fallback_info"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "t:article.hero_height_label",
      "min": 320,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:article.overlay_opacity_label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:article.text_align_label",
      "options": [
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "left", "label": "t:options.alignment.left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:article.media_radius_label",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:article.meta_header"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:article.show_author_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:article.show_reading_time_label",
      "default": false
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "t:article.date_format_label",
      "info": "t:article.date_format_info"
    },
    {
      "type": "checkbox",
      "id": "show_title_above_body",
      "label": "t:article.show_title_above_body_label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:article.footer_header"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:article.show_tags_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:article.show_share_label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:article.quote_header",
      "info": "t:article.quote_info"
    },
    {
      "type": "color",
      "id": "quote_background",
      "label": "t:article.quote_background_label"
    },
    {
      "type": "color",
      "id": "quote_text",
      "label": "t:article.quote_text_label"
    },
    {
      "type": "header",
      "content": "t:article.comments_header"
    },
    {
      "type": "select",
      "id": "comments_layout",
      "label": "t:article.comments_layout_label",
      "options": [
        { "value": "chat", "label": "t:article.comments_layout_chat" },
        { "value": "cards", "label": "t:article.comments_layout_cards" }
      ],
      "default": "chat"
    },
    {
      "type": "header",
      "content": "t:article.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:article.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:article.content_width_label",
      "min": 600,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:article.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:article.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "t:article.block_cta",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "t:article.cta_mode_label",
          "options": [
            { "value": "button", "label": "t:article.cta_mode_button" },
            { "value": "newsletter", "label": "t:article.cta_mode_newsletter" }
          ],
          "default": "newsletter"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:article.cta_heading_label",
          "default": "Bleib auf dem Laufenden"
        },
        {
          "type": "richtext",
