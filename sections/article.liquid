{% comment %}
  Article — editorial blog post
  ----------------------------------------------------------------
  Full-bleed hero (featured image + overlaid category & title), a
  readable rich-text body with styled pull-quotes, inline images and
  responsive video embeds, a tag/share footer and a native comments
  section (list + form). Mobile-first.

  Optional per-article extras (set in the article's metafields):
    - article.metafields.custom.category       → category label override
    - article.metafields.custom.hero_subtitle  → small line under the title

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{{ 'section-article.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign scheme = s.color_scheme

  assign has_image = false
  if article.image != blank
    assign has_image = true
  endif

  assign category = ''
  if s.category_source == 'metafield'
    assign category = article.metafields.custom.category
  endif
  if category == blank and article.tags.size > 0
    assign category = article.tags.first
  endif
  if category == blank
    assign category = s.category_fallback
  endif

  assign hero_subtitle = article.metafields.custom.hero_subtitle

  assign date_iso = article.published_at | date: '%Y-%m-%d'
  assign date_nice = article.published_at | date: s.date_format

  assign words = article.content | strip_html | split: ' ' | size
  assign read_min = words | divided_by: 200 | at_least: 1

  assign show_footer = false
  if s.show_share
    assign show_footer = true
  endif
  if s.show_tags and article.tags.size > 0
    assign show_footer = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --art-pt: {{ s.padding_top }}px;
    --art-pb: {{ s.padding_bottom }}px;
    --art-content-w: {{ s.content_width }}px;
    --art-hero-h: {{ s.hero_height }}px;
    --art-overlay: {{ s.overlay_opacity | divided_by: 100.0 }};
    --art-radius: {{ s.media_radius }}px;
    {%- if scheme.settings.background != blank -%}
      --art-bg: {{ scheme.settings.background }};
      --art-card: {{ scheme.settings.background_card | default: scheme.settings.background }};
      --art-text: {{ scheme.settings.text }};
      --art-muted: {{ scheme.settings.muted | default: scheme.settings.text }};
      --art-accent: {{ scheme.settings.accent | default: scheme.settings.text }};
      --art-line: {{ scheme.settings.text | color_modify: 'alpha', 0.12 }};
      --art-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.28 }};
      --art-link: {{ scheme.settings.links | default: scheme.settings.accent }};
    {%- endif -%}
    {%- if s.quote_background != blank -%}
      --art-quote-bg: {{ s.quote_background }};
    {%- endif -%}
    {%- if s.quote_text != blank -%}
      --art-quote-text: {{ s.quote_text }};
      --art-quote-mark: {{ s.quote_text | color_modify: 'alpha', 0.55 }};
    {%- endif -%}
  }
{% endstyle %}

<article class="article full-width color-{{ scheme.id }}" data-section-id="{{ section.id }}">
  {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
  {%- if has_image -%}
    <header class="article__hero article__hero--image" style="--art-align: {{ s.text_align }};">
      {%- assign hero_alt = article.image.alt | default: article.title -%}
      {{
        article.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'article__hero-img',
          alt: hero_alt
      }}
      <div class="article__hero-overlay" aria-hidden="true"></div>
      <div class="article__hero-inner">
        {%- if s.show_category and category != blank -%}
          <span class="article__category">{{ category | escape }}</span>
        {%- endif -%}
        <h1 class="article__hero-title">{{ article.title | escape }}</h1>
        {%- if hero_subtitle != blank -%}
          <p class="article__hero-subtitle">{{ hero_subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </header>
  {%- else -%}
    <header class="article__hero article__hero--text" style="--art-align: {{ s.text_align }};">
      <div class="article__hero-inner">
        {%- if s.show_category and category != blank -%}
          <span class="article__category">{{ category | escape }}</span>
        {%- endif -%}
        <h1 class="article__hero-title">{{ article.title | escape }}</h1>
        {%- if hero_subtitle != blank -%}
          <p class="article__hero-subtitle">{{ hero_subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </header>
  {%- endif -%}

  {%- comment -%} ---------- Body ---------- {%- endcomment -%}
  <div class="article__container">
    <div class="article__meta">
      {%- if s.show_author -%}
        <span class="article__author">{{ article.author }}</span>
        <span class="article__meta-sep" aria-hidden="true">&middot;</span>
      {%- endif -%}
      <time class="article__date" datetime="{{ date_iso }}">{{ date_nice }}</time>
      {%- if s.show_reading_time -%}
        <span class="article__meta-sep" aria-hidden="true">&middot;</span>
        <span class="article__readtime">{{ 'blog.read_time_html' | t: minutes: read_min }}</span>
      {%- endif -%}
    </div>

    {%- if s.show_title_above_body -%}
      <h2 class="article__title">{{ article.title | escape }}</h2>
    {%- endif -%}

    <div class="article__body rte">
      {{ article.content }}
    </div>

    {%- if show_footer -%}
      <div class="article__footer">
        {%- if s.show_tags and article.tags.size > 0 -%}
          <div class="article__tags">
            <span class="article__tags-label">{{ 'blog.tagged' | t }}</span>
            {%- for tag in article.tags -%}
              {%- assign tag_handle = tag | handleize -%}
              <a class="article__tag" href="{{ blog.url }}/tagged/{{ tag_handle }}">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if s.show_share -%}
          {%- assign share_url = shop.url | append: article.url | url_encode -%}
          {%- assign share_title = article.title | url_encode -%}
          <div class="article__share">
            <span class="article__share-label">{{ 'blog.share' | t }}</span>
            <a class="article__share-link" href="https://twitter.com/intent/tweet?text={{ share_title }}&url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_twitter' | t }}">X</a>
            <a class="article__share-link" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_facebook' | t }}">f</a>
            <a class="article__share-link" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'blog.share_linkedin' | t }}">in</a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Editor blocks (Newsletter/CTA, Related) ---------- {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="article__blocks">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'cta' -%}
            <div
              class="article-cta"
              {{ block.shopify_attributes }}
              {%- if block.settings.background != blank %} style="--art-cta-bg: {{ block.settings.background }};"{% endif -%}
            >
              {%- if block.settings.heading != blank -%}
                <h2 class="article-cta__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="article-cta__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.mode == 'newsletter' -%}
                {%- form 'customer', class: 'article-cta__form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="article-cta__success" role="status">{{ 'blog.newsletter_success' | t }}</p>
                  {%- else -%}
                    <label class="visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'blog.comment_form_email' | t }}</label>
                    <input
                      type="email"
                      id="NewsletterEmail-{{ block.id }}"
                      name="contact[email]"
                      value="{{ form.email }}"
                      placeholder="{{ 'blog.newsletter_placeholder' | t }}"
                      autocomplete="email"
                      required
                    >
                    {%- assign nl_label = block.settings.button_label | default: 'Subscribe' -%}
                    <button type="submit" class="article__btn">{{ nl_label | escape }}</button>
                  {%- endif -%}
                {%- endform -%}
              {%- elsif block.settings.button_label != blank -%}
                <a class="article__btn article-cta__btn" href="{{ block.settings.button_url | default: '#' }}">
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- when 'related' -%}
            {%- if blog.articles.size > 1 -%}
              {%- assign related_count = block.settings.count | default: 3 -%}
              {%- assign shown = 0 -%}
              <div class="article-related" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="article-related__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="article-related__grid">
                  {%- for art in blog.articles -%}
                    {%- if art.id == article.id -%}{%- continue -%}{%- endif -%}
                    {%- if shown >= related_count -%}{%- break -%}{%- endif -%}
                    {%- assign shown = shown | plus: 1 -%}
                    <a class="article-related__card" href="{{ art.url }}">
                      {%- if block.settings.show_image -%}
                        <div class="article-related__media">
                          {%- if art.image != blank -%}
                            {%- assign rel_alt = art.image.alt | default: art.title -%}
                            {{
                              art.image
                              | image_url: width: 600
                              | image_tag:
                                loading: 'lazy',
                                widths: '300, 400, 600',
                                sizes: '(min-width: 750px) 30vw, 90vw',
                                class: 'article-related__img',
                                alt: rel_alt
                            }}
                          {%- else -%}
                            <div class="article-related__placeholder"></div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      <span class="article-related__title">{{ art.title | escape }}</span>
                      <time class="article-related__date" datetime="{{ art.published_at | date: '%Y-%m-%d' }}">
                        {{- art.published_at | date: s.date_format -}}
                      </time>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Comments ---------- {%- endcomment -%}
  {%- if blog.comments_enabled? -%}
    <section class="article__comments" id="comments">
      <div class="article__comments-inner">
        <h2 class="article__comments-title">
          {%- if article.comments_count > 0 -%}
            {{ 'blog.comments_with_count' | t: count: article.comments_count }}
          {%- else -%}
            {{ 'blog.comments' | t }}
          {%- endif -%}
        </h2>

        {%- if comment != blank and comment.status -%}
          {%- if comment.status == 'pending' or blog.moderated? -%}
            <p class="article__notice article__notice--info" role="status">{{ 'blog.comment_success_moderated' | t }}</p>
          {%- else -%}
            <p class="article__notice article__notice--success" role="status">{{ 'blog.comment_success' | t }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if article.comments_count > 0 -%}
          {%- paginate article.comments by 20 -%}
            <ol class="article__comment-list" role="list">
              {%- for comment in article.comments -%}
                <li class="article__comment" id="comment-{{ comment.id }}">
                  <div class="article__comment-head">
                    <span class="article__comment-author">{{ comment.author | escape }}</span>
                    <time class="article__comment-date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{- comment.created_at | date: s.date_format -}}
                    </time>
                  </div>
                  <div class="article__comment-body rte">{{ comment.content }}</div>
                </li>
              {%- endfor -%}
            </ol>
            {%- if paginate.pages > 1 -%}
              <nav class="article__pagination" aria-label="{{ 'blog.comments' | t }}">
                {{ paginate | default_pagination: anchor: 'comments' }}
              </nav>
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}

        <div class="article__form-wrap">
          <h3 class="article__form-title">{{ 'blog.comment_form_title' | t }}</h3>
          {%- form 'new_comment', article -%}
            {%- if form.errors -%}
              <div class="article__notice article__notice--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="article__field-row">
              <div class="article__field">
                <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentAuthor-{{ section.id }}"
                  value="{{ form.author }}"
                  autocomplete="name"
                  required
                >
              </div>
              <div class="article__field">
                <label for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentEmail-{{ section.id }}"
                  value="{{ form.email }}"
                  autocomplete="email"
                  spellcheck="false"
                  required
                >
                <small class="article__field-hint">{{ 'blog.comment_form_email_info' | t }}</small>
              </div>
            </div>
            <div class="article__field">
              <label for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
              <textarea name="comment[body]" id="CommentBody-{{ section.id }}" rows="5" required>{{ form.body }}</textarea>
            </div>
            {%- if blog.moderated? -%}
              <p class="article__form-note">{{ 'blog.comment_moderated' | t }}</p>
            {%- endif -%}
            <button type="submit" class="article__btn">{{ 'blog.comment_form_submit' | t }}</button>
          {%- endform -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "t:article.name",
  "tag": "section",
  "class": "shopify-section--article",
  "settings": [
    {
      "type": "header",
      "content": "t:article.hero_header"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "t:article.show_category_label",
      "default": true
    },
    {
      "type": "select",
      "id": "category_source",
      "label": "t:article.category_source_label",
      "options": [
        { "value": "tag", "label": "t:article.category_source_tag" },
        { "value": "metafield", "label": "t:article.category_source_metafield" }
      ],
      "default": "tag"
    },
    {
      "type": "text",
      "id": "category_fallback",
      "label": "t:article.category_fallback_label",
      "info": "t:article.category_fallback_info"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "t:article.hero_height_label",
      "min": 320,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:article.overlay_opacity_label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:article.text_align_label",
      "options": [
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "left", "label": "t:options.alignment.left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "t:article.media_radius_label",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:article.meta_header"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:article.show_author_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:article.show_reading_time_label",
      "default": false
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "t:article.date_format_label",
      "info": "t:article.date_format_info",
      "default": "%b %d, %Y"
    },
    {
      "type": "checkbox",
      "id": "show_title_above_body",
      "label": "t:article.show_title_above_body_label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:article.footer_header"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:article.show_tags_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:article.show_share_label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:article.quote_header",
      "info": "t:article.quote_info"
    },
    {
      "type": "color",
      "id": "quote_background",
      "label": "t:article.quote_background_label",
      "default": "#ece4cf"
    },
    {
      "type": "color",
      "id": "quote_text",
      "label": "t:article.quote_text_label",
      "default": "#1f2328"
    },
    {
      "type": "header",
      "content": "t:article.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:article.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:article.content_width_label",
      "min": 600,
      "max": 1100,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:article.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:article.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "t:article.block_cta",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "t:article.cta_mode_label",
          "options": [
            { "value": "button", "label": "t:article.cta_mode_button" },
            { "value": "newsletter", "label": "t:article.cta_mode_newsletter" }
          ],
          "default": "newsletter"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:article.cta_heading_label",
          "default": "Bleib auf dem Laufenden"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:article.cta_text_label",
          "default": "<p>Erhalte neue Beiträge direkt in dein Postfach – kein Spam, jederzeit abbestellbar.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:article.cta_button_label_label",
          "default": "Abonnieren"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "t:article.cta_button_url_label",
          "info": "t:article.cta_button_url_info"
        },
        {
          "type": "color",
          "id": "background",
          "label": "t:article.cta_background_label"
        }
      ]
    },
    {
      "type": "related",
      "name": "t:article.block_related",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:article.related_heading_label",
          "default": "Mehr aus dem Blog"
        },
        {
          "type": "range",
          "id": "count",
          "label": "t:article.related_count_label",
          "min": 2,
          "max": 4,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "t:article.related_show_image_label",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}
