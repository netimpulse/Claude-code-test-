          "default": "seo"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:services_orbit.label_label",
          "info": "t:services_orbit.label_info",
          "default": "SEO"
        },
        {
          "type": "text",
          "id": "center_title",
          "label": "t:services_orbit.center_title_label",
          "info": "t:services_orbit.center_title_info"
        },
        {
          "type": "text",
          "id": "title",
