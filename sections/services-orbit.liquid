        },
        {
          "type": "url",
          "id": "primary_url",
          "label": "t:services_orbit.primary_url_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:services_orbit.name",
      "category": "t:general.section",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "seo",
            "label": "SEO",
            "center_title": "Suchmaschinenoptimierung",
            "title": "Gefunden werden, bevor andere sichtbar sind.",
            "benefit_1": "Keyword- und Seitenstruktur mit klarer Suchintention",
