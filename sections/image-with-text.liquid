{% comment %}
  Image with text (Leistungs-Unterseiten, Plan S6c)
  ----------------------------------------------------------------
  h2 (accent-heading, `*Wort*` = serif accent) + rich text beside a
  photo (--r-lg, no shadow) with an optional flat stat badge. The
  merchant chooses the image side; mobile stacks image first.
  Without an image the frame becomes a Tafel graphic: 5 % tinted
  surface, bars in --color-line and one accent bar in --color-accent.

  Colours come from the colour scheme tokens (--color-*). accent_color
  is optional (empty = --color-accent) and only tints the badge icon
  and the accent bar; the button is always `.btn .btn--primary`.
  Padding: min(setting, --section-y) – the setting acts as an upper bound.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign position = section.settings.image_position | default: 'right'
-%}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .image-with-text {
    {%- if accent != blank -%}
      {%- assign accent_brightness = accent | color_brightness -%}
      --iwt-accent: {{ accent }};
      --iwt-on-accent: {% if accent_brightness > 150 %}#0d0d0d{% else %}#fffdf8{% endif %};
    {%- endif -%}
    --iwt-padding-top: {{ section.settings.padding_top }}px;
    --iwt-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
{% endstyle %}

<section
  class="image-with-text full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="iwt-heading-{{ section.id }}"{% endif %}
>
  <div class="image-with-text__inner">
    <div class="image-with-text__grid image-with-text--image-{{ position }}">
      <div class="image-with-text__media">
        <div class="image-with-text__frame{% if section.settings.image == blank %} image-with-text__frame--graphic{% endif %}">
          {%- if section.settings.image != blank -%}
            {%- assign heading_plain = section.settings.heading | remove: '*' -%}
            {%- assign img_alt = section.settings.image.alt | default: heading_plain -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 901px) 48vw, 100vw',
                alt: img_alt,
                class: 'image-with-text__image'
            }}
          {%- else -%}
            {%- comment -%} Tafel graphic: decorative bar chart, one accent bar. {%- endcomment -%}
            <div class="image-with-text__graphic" aria-hidden="true">
              <div class="image-with-text__graphic-lines">
                <span class="image-with-text__graphic-line"></span>
                <span class="image-with-text__graphic-line image-with-text__graphic-line--short"></span>
              </div>
              <div class="image-with-text__graphic-bars">
                <span class="image-with-text__bar" style="--h: 34%"></span>
                <span class="image-with-text__bar" style="--h: 48%"></span>
                <span class="image-with-text__bar" style="--h: 42%"></span>
                <span class="image-with-text__bar" style="--h: 61%"></span>
                <span class="image-with-text__bar" style="--h: 72%"></span>
                <span class="image-with-text__bar image-with-text__bar--accent" style="--h: 92%"></span>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.show_badge -%}
            <div class="image-with-text__badge">
              <span class="image-with-text__badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                  <path d="M4 21V6l7-3v18"/><path d="M11 9h7v12"/><path d="M4 21h17"/>
                  <path d="M7 8v0M7 12v0M7 16v0M14.5 12v0M14.5 16v0"/>
                </svg>
              </span>
              <span class="image-with-text__badge-text">
                {%- if section.settings.badge_value != blank -%}
                  <span class="image-with-text__badge-value">{{ section.settings.badge_value | escape }}</span>
                {%- endif -%}
                {%- if section.settings.badge_label != blank -%}
                  <span class="image-with-text__badge-label">{{ section.settings.badge_label | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.heading != blank -%}
          <h2 id="iwt-heading-{{ section.id }}" class="image-with-text__heading">
            {%- render 'accent-heading', text: section.settings.heading -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="image-with-text__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <div class="image-with-text__actions">
            <a class="btn btn--primary image-with-text__btn" href="{{ section.settings.link_url | default: '#' }}">
              <span>{{ section.settings.link_label | escape }}</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:image_with_text.name",
  "tag": "section",
  "class": "shopify-section--image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:image_with_text.image_label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:image_with_text.image_position_label",
      "options": [
        { "value": "left", "label": "t:image_with_text.position_left" },
        { "value": "right", "label": "t:image_with_text.position_right" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "t:image_with_text.content_header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:image_with_text.heading_label",
      "default": "SEO at Scale Is a Structural Problem."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:image_with_text.body_label",
      "default": "<p>SEO at scale isn't a checklist. You're managing thousands of pages, legacy tech stacks, and competing priorities across teams and business units.</p><p>At this level, the problems are structural — crawl budget limits, keyword cannibalization, and years of technical debt. You need a partner who can execute <a href=\"#\">technical and content strategies</a> that produce durable results.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:image_with_text.link_label",
      "info": "t:image_with_text.link_info"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:image_with_text.link_url_label"
    },
    {
      "type": "header",
      "content": "t:image_with_text.badge_header"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:image_with_text.show_badge_label",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_value",
      "label": "t:image_with_text.badge_value_label",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:image_with_text.badge_label_label",
      "default": "Industries Served"
    },
    {
      "type": "header",
      "content": "t:image_with_text.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:image_with_text.color_scheme_label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:image_with_text.accent_color_label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:image_with_text.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:image_with_text.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:image_with_text.name",
      "category": "t:general.section"
    }
  ]
}
{% endschema %}
