{% comment %}
  About — Perspectives (Über uns, Plan S7a)
  ----------------------------------------------------------------
  h2 (accent-heading, `*Wort*` = serif accent) + optional intro, then a
  row of cards: one feature card on the black surface (class
  color-scheme-2) and the repeatable perspective cards (--r-lg, 1px
  --color-line, no shadow). Every card starts with a 4:5 portrait; if
  no photo is set, a calm monogram tile (SYS §6 Team empty state:
  black surface, initial in the accent serif, "Foto folgt") keeps the
  row aligned. Category tag sits on the portrait; name, role, text and
  up to five focus tags follow.

  Colours come from the colour scheme tokens (--color-*). feature_bg /
  feature_text / accent_color are optional overrides (empty = design
  system) and are only written when filled.
  Padding: min(setting, --section-y) – the setting acts as an upper bound.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign block_count = section.blocks.size
  assign total_cols = block_count | plus: 1
  # Desktop row holds at most four cards; a fifth wraps.
  if total_cols > 4
    assign total_cols = 4
  endif
-%}

{{ 'section-about-perspectives.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .about-perspectives {
    {%- if accent != blank %}--ap-accent: {{ accent }};{% endif %}
    --ap-padding-top: calc({{ section.settings.padding_top }}px * var(--ui-scale, 1));
    --ap-padding-bottom: calc({{ section.settings.padding_bottom }}px * var(--ui-scale, 1));
  }
  #shopify-section-{{ section.id }} .about-perspectives__feature {
    {%- if section.settings.feature_bg != blank %}--ap-feature-bg: {{ section.settings.feature_bg }};{% endif %}
    {%- if section.settings.feature_text != blank %}
      --ap-feature-text: {{ section.settings.feature_text }};
      --ap-feature-muted: {{ section.settings.feature_text | color_modify: 'alpha', 0.78 }};
    {%- endif %}
  }
  #shopify-section-{{ section.id }} .about-perspectives__grid {
    --ap-cols: {{ total_cols }};
  }
{% endstyle %}

<section
  class="about-perspectives full-width{% if scheme %} color-{{ scheme.id }}{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="ap-heading-{{ section.id }}"{% endif %}
>
  <div class="about-perspectives__inner">
    {%- if section.settings.heading != blank or section.settings.intro != blank and section.settings.show_intro -%}
      <div class="about-perspectives__head">
        {%- if section.settings.heading != blank -%}
          <h2 id="ap-heading-{{ section.id }}" class="about-perspectives__heading">
            {%- render 'accent-heading', text: section.settings.heading -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank and section.settings.show_intro -%}
          <p class="about-perspectives__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="about-perspectives__grid">
      <article class="about-perspectives__feature color-scheme-2">
        {%- if section.settings.card_kicker != blank -%}
          <p class="about-perspectives__feature-kicker label-caps">{{ section.settings.card_kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.card_heading != blank -%}
          <h3 class="about-perspectives__feature-heading">{{ section.settings.card_heading | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.card_text != blank -%}
          <p class="about-perspectives__feature-text">{{ section.settings.card_text | escape | newline_to_br }}</p>
        {%- endif -%}
      </article>

      {%- if block_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_photo = false
            if block.settings.photo != blank
              assign has_photo = true
            endif
            assign member_name = block.settings.name | strip
            assign initial = member_name | slice: 0, 1 | upcase
          -%}
          <article class="about-perspectives__card{% if has_photo %} about-perspectives__card--has-photo{% else %} about-perspectives__card--no-photo{% endif %}" {{ block.shopify_attributes }}>
            <div class="about-perspectives__media">
              {%- if has_photo -%}
                {%- assign photo_alt = block.settings.photo.alt | default: member_name -%}
                {{
                  block.settings.photo
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 600, 800',
                    sizes: '(min-width: 1101px) 22vw, (min-width: 681px) 45vw, 100vw',
                    alt: photo_alt,
                    class: 'about-perspectives__photo'
                }}
              {%- else -%}
                <div class="about-perspectives__monogram color-scheme-2" aria-hidden="true">
                  {%- if initial != blank -%}
                    <span class="about-perspectives__initial">{{ initial | escape }}</span>
                  {%- endif -%}
                  <span class="about-perspectives__pending label-caps">{{ 'about_perspectives.photo_pending' | t }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.category != blank -%}
                <span class="about-perspectives__category label-caps">{{ block.settings.category | escape }}</span>
              {%- endif -%}
            </div>

            <div class="about-perspectives__body">
              {%- if member_name != blank -%}
                <h3 class="about-perspectives__name">{{ member_name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.role != blank -%}
                <p class="about-perspectives__role">{{ block.settings.role | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="about-perspectives__text">{{ block.settings.text | escape | newline_to_br }}</p>
              {%- endif -%}

              {%- assign has_tags = false -%}
              {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank or block.settings.tag_3 != blank or block.settings.tag_4 != blank or block.settings.tag_5 != blank -%}
                {%- assign has_tags = true -%}
              {%- endif -%}

              {%- if has_tags -%}
                <div class="about-perspectives__tags-wrap">
                  {%- if section.settings.focus_label != blank -%}
                    <p class="about-perspectives__focus-label label-caps">{{ section.settings.focus_label | escape }}</p>
                  {%- endif -%}
                  <ul class="about-perspectives__tags" role="list">
                    {%- if block.settings.tag_1 != blank -%}<li class="about-perspectives__tag">{{ block.settings.tag_1 | escape }}</li>{%- endif -%}
                    {%- if block.settings.tag_2 != blank -%}<li class="about-perspectives__tag">{{ block.settings.tag_2 | escape }}</li>{%- endif -%}
                    {%- if block.settings.tag_3 != blank -%}<li class="about-perspectives__tag">{{ block.settings.tag_3 | escape }}</li>{%- endif -%}
                    {%- if block.settings.tag_4 != blank -%}<li class="about-perspectives__tag">{{ block.settings.tag_4 | escape }}</li>{%- endif -%}
                    {%- if block.settings.tag_5 != blank -%}<li class="about-perspectives__tag">{{ block.settings.tag_5 | escape }}</li>{%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- elsif request.design_mode -%}
        <p class="about-perspectives__placeholder">
          {{ 'about_perspectives.add_perspectives' | t }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:about_perspectives.name",
  "tag": "section",
  "class": "shopify-section--about-perspectives",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:about_perspectives.heading_label",
      "info": "Setze ein Wort in *Sternchen*, um es als Serif-Akzent hervorzuheben.",
      "default": "Drei Perspektiven, ein gemeinsamer Anspruch."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:about_perspectives.intro_label",
      "default": "NetImpulse ist bewusst klein aufgestellt. Dadurch bleiben Abstimmungen direkt, Entscheidungen klar und Strategie, Design und Umsetzung nah beieinander."
    },
    { "type": "checkbox", "id": "show_intro", "label": "Begleittext anzeigen", "default": true },
    {
      "type": "header",
      "content": "t:about_perspectives.feature_header"
    },
    {
      "type": "text",
      "id": "card_kicker",
      "label": "t:about_perspectives.card_kicker_label",
      "default": "Wer dahintersteht"
    },
    {
      "type": "textarea",
      "id": "card_heading",
      "label": "t:about_perspectives.card_heading_label",
      "default": "Keine anonyme Agenturstruktur"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "t:about_perspectives.card_text_label",
      "default": "Jeder Bereich hat eine klare Verantwortung. So entsteht ein digitaler Auftritt, bei dem Marketing, Gestaltung und Technik nicht getrennt voneinander gedacht werden."
    },
    {
      "type": "color",
      "id": "feature_bg",
      "label": "t:about_perspectives.feature_bg_label",
      "info": "Leer lassen: Die Karte nutzt die schwarze Fläche des Designsystems."
    },
    {
      "type": "color",
      "id": "feature_text",
      "label": "t:about_perspectives.feature_text_label",
      "info": "Leer lassen: Textfarben der schwarzen Fläche."
    },
    {
      "type": "header",
      "content": "t:about_perspectives.tags_header"
    },
    {
      "type": "text",
      "id": "focus_label",
      "label": "t:about_perspectives.focus_label_label",
      "default": "Fokusbereiche"
    },
    {
      "type": "header",
      "content": "t:about_perspectives.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:about_perspectives.color_scheme_label",
      "default": "scheme-sand"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:about_perspectives.accent_color_label",
      "info": "Farbe der Initiale ohne Foto. Leer lassen, um den Designsystem-Akzent zu verwenden."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:about_perspectives.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:about_perspectives.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "blocks": [
    {
      "type": "perspective",
      "name": "t:about_perspectives.block_perspective",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "t:about_perspectives.category_label",
          "default": "Strategie"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "t:about_perspectives.photo_label",
          "info": "t:about_perspectives.photo_info"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:about_perspectives.name_label",
          "default": "Niklas"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:about_perspectives.role_label",
          "default": "Online-Marketing & Shopify-Entwicklung"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:about_perspectives.text_label",
          "default": "Verbindet Performance-Marketing, SEO-Struktur und Shopify-Umsetzung. Der Fokus liegt darauf, digitale Auftritte nicht nur schön, sondern messbar und pflegbar zu machen."
        },
        {
          "type": "header",
          "content": "t:about_perspectives.tags_header"
        },
        {
          "type": "text",
          "id": "tag_1",
          "label": "t:about_perspectives.tag_label",
          "default": "SEO"
        },
        {
          "type": "text",
          "id": "tag_2",
          "label": "t:about_perspectives.tag_label",
          "default": "SEA"
        },
        {
          "type": "text",
          "id": "tag_3",
          "label": "t:about_perspectives.tag_label",
          "default": "Shopify"
        },
        {
          "type": "text",
          "id": "tag_4",
          "label": "t:about_perspectives.tag_label",
          "default": "Liquid"
        },
        {
          "type": "text",
          "id": "tag_5",
          "label": "t:about_perspectives.tag_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:about_perspectives.name",
      "category": "t:general.section",
      "blocks": [
        {
          "type": "perspective",
          "settings": {
            "category": "Strategie",
            "name": "Niklas",
            "role": "Online Marketing & Shopify Entwicklung",
            "text": "Verbindet Performance-Marketing, SEO-Struktur und Shopify-Umsetzung. Der Fokus liegt darauf, digitale Auftritte nicht nur schön, sondern messbar und pflegbar zu machen.",
            "tag_1": "SEO",
            "tag_2": "SEA",
            "tag_3": "Shopify",
            "tag_4": "Liquid"
          }
        },
        {
          "type": "perspective",
          "settings": {
            "category": "Design",
            "name": "Tom",
            "role": "Design, Konzept & digitale Auftritte",
