{% comment %}
  Theme Store Preview (design system, light surface between the service
  slabs and the team row)
  ----------------------------------------------------------------
  Head: eyebrow, h2 with one serif accent, short intro; round arrows on
  the right only when the themes overflow. Each theme is a "theme" block
  with a product picker (image, title, price via | money). Cards: flat,
  1px line, --r-lg, image area 4:3 with --r-lg − 4px; name in Bricolage
  500 + price, category muted, tags as pills. No shadows, no lift.
  Without a product image a flat monogram surface is shown.

  Empty product (deleted or not picked): hidden in the storefront, only
  the theme editor (request.design_mode) shows a subtle placeholder.

  The store "cta" block is a dark slab (--c-ink, text --c-surface) with
  the primary button in its dark variant (light teal). It sits outside
  the scroller and never moves; only the themes scroll (arrows, wheel,
  drag). Accent: "*word*" convention in the heading (accent-heading) or
  the legacy heading_highlight setting, both rendered as <em class="it">.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign heading = section.settings.heading
  assign highlight = section.settings.heading_highlight
  assign subheading = section.settings.subheading

  assign theme_count = 0
  assign has_cta = false
  for block in section.blocks
    if block.type == 'theme'
      if block.settings.product != blank or request.design_mode
        assign theme_count = theme_count | plus: 1
      endif
    elsif block.type == 'cta'
      assign has_cta = true
    endif
  endfor
-%}

{{ 'section-theme-store-preview.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} .tsp {
    --tsp-pad-top: {{ section.settings.padding_top }}px;
    --tsp-pad-bottom: {{ section.settings.padding_bottom }}px;
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
    {%- if section.settings.card_bg_light != blank %}--tsp-card-bg: {{ section.settings.card_bg_light }};{% endif %}
    {%- if section.settings.card_bg_dark != blank %}--tsp-preview-dark: {{ section.settings.card_bg_dark }};{% endif %}
    {%- if section.settings.card_border != blank %}--tsp-card-border: {{ section.settings.card_border }};{% endif %}
  }
{% endstyle %}

<section
  class="tsp full-width{% if scheme %} color-{{ scheme.id }}{% endif %}{% if has_cta %} tsp--has-cta{% endif %}{% if theme_count == 0 %} tsp--no-themes{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="theme-store-preview"
  {% if heading != blank %}aria-labelledby="tsp-heading-{{ section.id }}"{% endif %}
>
  <div class="tsp__inner">
    <header class="tsp__header">
      <div class="tsp__intro">
        {%- if section.settings.kicker != blank -%}
          <p class="tsp__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 id="tsp-heading-{{ section.id }}" class="tsp__heading">
            {%- if heading contains '*' -%}
              {%- render 'accent-heading', text: heading -%}
            {%- elsif highlight != blank and heading contains highlight -%}
              {%- liquid
                assign heading_esc = heading | escape
                assign hl_esc = highlight | escape
                assign hl_em = '<em class="it">' | append: hl_esc | append: '</em>'
                echo heading_esc | replace_first: hl_esc, hl_em
              -%}
            {%- else -%}
              {{- heading | escape -}}
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if subheading != blank and section.settings.show_intro -%}
          <p class="tsp__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if theme_count > 0 -%}
        <div class="tsp__nav">
          <button
            type="button"
            class="tsp__nav-btn"
            data-tsp-prev
            aria-label="{{ 'theme_store_preview.prev' | t }}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            type="button"
            class="tsp__nav-btn"
            data-tsp-next
            aria-label="{{ 'theme_store_preview.next' | t }}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </header>

    <div class="tsp__deck">
      {%- if theme_count > 0 -%}
        <ul class="tsp__track" data-tsp-track role="list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'theme' -%}{%- continue -%}{%- endif -%}
            {%- assign product = block.settings.product -%}
            {%- if product == blank -%}
              {%- if request.design_mode -%}
                <li class="tsp__item tsp__item--placeholder" {{ block.shopify_attributes }}>
                  <div class="tsp__card tsp__card--placeholder">
                    <div class="tsp__preview" aria-hidden="true"></div>
                    <div class="tsp__info">
                      <p class="tsp__name">{{ 'theme_store_preview.pick_product' | t }}</p>
                      <p class="tsp__category">{{ 'theme_store_preview.editor_only' | t }}</p>
                    </div>
                  </div>
                </li>
              {%- endif -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign style = block.settings.preview_style | default: 'light'
              assign category = block.settings.category
              if category == blank
                assign category = product.type
              endif
              assign tags_src = block.settings.tags
              if tags_src == blank
                assign tags_src = product.tags | join: ','
              endif
              assign tags = tags_src | split: ','
              assign monogram = product.title | strip | slice: 0, 1
            -%}
            <li class="tsp__item" {{ block.shopify_attributes }}>
              <a class="tsp__card tsp__card--theme tsp__card--{{ style }}" href="{{ product.url }}" draggable="false">
                <div class="tsp__preview" aria-hidden="true">
                  {%- if product.featured_image -%}
                    {{
                      product.featured_image
                      | image_url: width: 1200, height: 900, crop: 'center'
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200',
                        sizes: '(min-width: 1101px) 24vw, (min-width: 861px) 45vw, 84vw',
                        alt: '',
                        class: 'tsp__preview-img'
                    }}
                  {%- else -%}
                    <span class="tsp__monogram">{{ monogram | escape }}</span>
                  {%- endif -%}
                </div>

                <div class="tsp__info">
                  <div class="tsp__row">
                    <h3 class="tsp__name">{{ product.title | escape }}</h3>
                    <span class="tsp__price">{{ product.price | money }}</span>
                  </div>
                  {%- if category != blank -%}
                    <p class="tsp__category">{{ category | escape }}</p>
                  {%- endif -%}
                  {%- if tags.size > 0 -%}
                    <ul class="tsp__tags" role="list">
                      {%- for tag in tags -%}
                        {%- assign tag_clean = tag | strip -%}
                        {%- if tag_clean != blank -%}
                          <li class="tsp__tag">{{ tag_clean | escape }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="tsp__empty">{{ 'theme_store_preview.add_themes' | t }}</p>
      {%- endif -%}

      {%- comment -%} Fixed store CTA slab — lives outside the scroller. {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'cta' -%}
          {%- liquid
            assign cta_url = block.settings.button_url
            if cta_url == blank
              assign cta_url = pages['theme-store'].url
            endif
            if cta_url == blank
              assign cta_url = routes.all_products_collection_url
            endif
          -%}
          <div class="tsp__store" {{ block.shopify_attributes }}>
            <div class="tsp__card tsp__card--cta">
              {%- if block.settings.label != blank -%}
                <p class="tsp__cta-label eyebrow">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="tsp__cta-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="btn btn--primary tsp__cta-btn" href="{{ cta_url }}">
                  <span>{{ block.settings.button_label | escape }}</span>
                  <span class="btn__arrow" aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('[data-tsp-track]');
    var prev = root.querySelector('[data-tsp-prev]');
    var next = root.querySelector('[data-tsp-next]');
    if (!track) {
      root.classList.add('tsp--no-overflow');
      return;
    }
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function step() {
      var item = track.querySelector('.tsp__item');
      if (!item) return track.clientWidth * 0.8;
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return item.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 1;
      if (prev) prev.toggleAttribute('disabled', track.scrollLeft <= 0);
      if (next) next.toggleAttribute('disabled', track.scrollLeft >= max);
      root.classList.toggle('tsp--no-overflow', max <= 0);
    }

    if (prev) prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    if (next) next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    /* Mouse wheel -> horizontal scroll. */
    track.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 0) return;
      if ((track.scrollLeft <= 0 && e.deltaY < 0) || (track.scrollLeft >= max - 1 && e.deltaY > 0)) return;
      e.preventDefault();
      track.scrollLeft += e.deltaY;
    }, { passive: false });

    /* Drag to scroll with the mouse. Does NOT preventDefault on
       pointerdown so the underlying <a> still receives its click. We
       only switch into "dragging" mode (and suppress the click) once
       the pointer has actually moved past a small threshold. */
    var down = false, startX = 0, startLeft = 0, moved = false, dragging = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      down = true; moved = false; dragging = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
    });
    track.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (!dragging && Math.abs(dx) > 4) {
        dragging = true; moved = true;
        track.classList.add('is-dragging');
        try { track.setPointerCapture(e.pointerId); } catch (err) {}
      }
      if (dragging) {
        e.preventDefault();
        track.scrollLeft = startLeft - dx;
      }
    });
    function endDrag() {
      if (!down) return;
      down = false;
      if (dragging) {
        dragging = false;
        track.classList.remove('is-dragging');
      }
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('lostpointercapture', endDrag);
    track.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);

    update();
  })();
</script>

{% schema %}
{
  "name": "Theme store preview",
  "tag": "section",
  "class": "shopify-section--theme-store-preview",
  "max_blocks": 13,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Theme Store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap one word in asterisks for the serif accent, e.g. \"Unsere Themes & *Packs*.\"",
      "default": "Unsere Themes & Packs."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted word",
      "info": "Legacy: word inside the heading that gets the serif accent. Must match exactly. Ignored when the heading uses *asterisks*.",
      "default": "Packs"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Performance-Themes und Section-Packs — sofort einsatzbereit."
    },
    { "type": "checkbox", "id": "show_intro", "label": "Begleittext anzeigen", "default": true },
    { "type": "header", "content": "Card colors", "info": "Leer lassen, um die Farben des Designsystems zu verwenden." },
    { "type": "color", "id": "card_bg_light", "label": "Karte – Hintergrund" },
    { "type": "color", "id": "card_bg_dark", "label": "Dunkle Vorschaufläche (ohne Produktbild)" },
    { "type": "color", "id": "card_border", "label": "Kartenrand" },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Theme",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Theme product",
          "info": "The product's image, title and price are used. No image? A flat monogram surface is shown. No product? The card is hidden in the storefront."
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Optional. Falls back to the product type."
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags",
          "info": "Comma-separated. Optional — falls back to the product tags."
        },
        {
          "type": "select",
          "id": "preview_style",
          "label": "Mock preview style",
          "info": "Used only when the product has no image.",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Store CTA card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Theme Store" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Alle Themes und Packs ansehen." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Zum Store" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Theme store preview",
      "category": "Theme store",
      "blocks": [
        { "type": "theme", "settings": { "preview_style": "light", "category": "Business Theme", "tags": "Business, Cases" } },
        { "type": "theme", "settings": { "preview_style": "dark", "category": "Fashion Theme", "tags": "Fashion, Shop" } },
        { "type": "theme", "settings": { "preview_style": "light", "category": "Section Pack", "tags": "Sections, Editor" } },
        { "type": "cta", "settings": { "label": "Theme Store", "heading": "Alle Themes und Packs ansehen.", "button_label": "Zum Store" } }
      ]
    }
  ]
}
{% endschema %}
