{% comment %}
  Theme Store Preview
  ----------------------------------------------------------------
  A horizontally scrollable deck of theme cards that sit directly on
  the section background (no outer panel). Each theme is added
  individually as a "theme" block via a product picker — the
  product's image, title and price are used. When the product has no
  image, an editorial browser-window mock is shown instead. An
  optional dark "store" CTA card can be added at the end.

  - Heading + optional highlighted accent word and subheading.
  - Cards lift on hover.
  - The deck scrolls with the arrows, the mouse wheel, or by dragging.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign heading = section.settings.heading
  assign highlight = section.settings.heading_highlight
  assign subheading = section.settings.subheading

  assign heading_html = heading | escape
  if highlight != blank and heading contains highlight
    assign hl_esc = highlight | escape
    assign accent_span = '<span class="tsp__heading-accent">' | append: hl_esc | append: '</span>'
    assign heading_html = heading_html | replace: hl_esc, accent_span
  endif
-%}

{{ 'section-theme-store-preview.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
    {%- endif -%}
    {%- if scheme.settings.text != blank -%}
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .tsp {
    --tsp-pad-top: {{ section.settings.padding_top }}px;
    --tsp-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section
  class="tsp full-width color-scheme color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="theme-store-preview"
>
  <div class="tsp__inner">
    <header class="tsp__header">
      <div class="tsp__intro">
        {%- if heading != blank -%}
          <h2 class="tsp__heading">{{ heading_html }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tsp__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="tsp__nav">
        <button
          type="button"
          class="tsp__nav-btn"
          data-tsp-prev
          aria-label="{{ 'theme_store_preview.prev' | t | default: 'Vorheriges' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="tsp__nav-btn"
          data-tsp-next
          aria-label="{{ 'theme_store_preview.next' | t | default: 'Nächstes' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="tsp__track" data-tsp-track>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when 'theme' -%}
            {%- liquid
              assign product = block.settings.product
              assign style = block.settings.preview_style | default: 'light'
              assign category = block.settings.category
              if category == blank and product != blank
                assign category = product.type
              endif
              assign tags_src = block.settings.tags
              if tags_src == blank and product != blank
                assign tags_src = product.tags | join: ', '
              endif
              assign tags = tags_src | split: ','
            -%}
            <li class="tsp__item" {{ block.shopify_attributes }}>
              <a class="tsp__card tsp__card--theme tsp__card--{{ style }}" href="{{ product.url | default: '#' }}" draggable="false">
                <div class="tsp__preview" aria-hidden="true">
                  {%- if product != blank and product.featured_image -%}
                    {%- render 'image',
                      image: product.featured_image,
                      class: 'tsp__preview-img',
                      width: 800,
                      height: 572,
                      crop: 'center'
                    -%}
                  {%- else -%}
                    <div class="tsp__chrome">
                      <span class="tsp__dots"><i></i><i></i><i></i></span>
                      <span class="tsp__chrome-bar"></span>
                    </div>
                    <span class="tsp__rule"></span>
                    <div class="tsp__screen">
                      <span class="tsp__accent-bar"></span>
                      <span class="tsp__line tsp__line--1"></span>
                      <span class="tsp__line tsp__line--2"></span>
                    </div>
                  {%- endif -%}
                </div>

                <div class="tsp__info">
                  <div class="tsp__row">
                    <h3 class="tsp__name">
                      {%- if product != blank -%}
                        {{ product.title | escape }}
                      {%- else -%}
                        {{ 'theme_store_preview.pick_product' | t | default: 'Theme auswählen' }}
                      {%- endif -%}
                    </h3>
                    {%- if product != blank -%}
                      <span class="tsp__price">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>
                  {%- if category != blank -%}
                    <p class="tsp__category">{{ category | escape }}</p>
                  {%- endif -%}
                  {%- if tags.size > 0 -%}
                    <div class="tsp__tags">
                      {%- for tag in tags -%}
                        {%- assign tag_clean = tag | strip -%}
                        {%- if tag_clean != blank -%}
                          <span class="tsp__tag">{{ tag_clean | escape }}</span>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- when 'cta' -%}
            <li class="tsp__item tsp__item--cta" {{ block.shopify_attributes }}>
              <a class="tsp__card tsp__card--cta" href="{{ block.settings.button_url | default: '#' }}" draggable="false">
                {%- if block.settings.label != blank -%}
                  <span class="tsp__cta-label">
                    <span class="tsp__cta-dot" aria-hidden="true"></span>
                    {{ block.settings.label | escape }}
                  </span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="tsp__cta-heading">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="tsp__cta-btn">{{ block.settings.button_label | escape }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="tsp__empty">
        {{ 'theme_store_preview.add_themes' | t | default: 'Füge Theme-Karten im Editor hinzu und wähle pro Karte ein Produkt.' }}
      </p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('[data-tsp-track]');
    var prev = root.querySelector('[data-tsp-prev]');
    var next = root.querySelector('[data-tsp-next]');
    if (!track) {
      if (prev) prev.disabled = true;
      if (next) next.disabled = true;
      return;
    }

    function step() {
      var item = track.querySelector('.tsp__item');
      if (!item) return track.clientWidth * 0.8;
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return item.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 1;
      if (prev) prev.toggleAttribute('disabled', track.scrollLeft <= 0);
      if (next) next.toggleAttribute('disabled', track.scrollLeft >= max);
    }

    if (prev) prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    if (next) next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    /* Mouse wheel -> horizontal scroll. */
    track.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 0) return;
      if ((track.scrollLeft <= 0 && e.deltaY < 0) || (track.scrollLeft >= max - 1 && e.deltaY > 0)) return;
      e.preventDefault();
      track.scrollLeft += e.deltaY;
    }, { passive: false });

    /* Drag to scroll with the mouse. */
    var down = false, startX = 0, startLeft = 0, moved = false;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      down = true; moved = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add('is-dragging');
      e.preventDefault();
      try { track.setPointerCapture(e.pointerId); } catch (err) {}
    });
    track.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startLeft - dx;
    });
    function endDrag() {
      if (!down) return;
      down = false;
      track.classList.remove('is-dragging');
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('lostpointercapture', endDrag);
    /* Swallow the click that ends a drag so the card link doesn't fire. */
    track.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);

    update();
  })();
</script>

{% schema %}
{
  "name": "Theme store preview",
  "tag": "section",
  "class": "shopify-section--theme-store-preview",
  "max_blocks": 13,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unsere Themes & Packs."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted word",
      "info": "Word inside the heading that gets the italic accent style. Must match exactly.",
      "default": "Packs"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Performance-Themes und Section-Packs — sofort einsatzbereit."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Theme",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Theme product",
          "info": "The product's image, title and price are used. No image? An editorial mock is shown."
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Optional. Falls back to the product type."
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags",
          "info": "Comma-separated. Optional — falls back to the product tags."
        },
        {
          "type": "select",
          "id": "preview_style",
          "label": "Mock preview style",
          "info": "Used only when the product has no image.",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    },
    {
      "type": "cta",
      "name": "Store CTA card",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "Theme Store" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Alle Themes und Packs ansehen." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Zum Store" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Theme store preview",
      "category": "Theme store",
      "blocks": [
        { "type": "theme", "settings": { "preview_style": "light", "category": "Business Theme", "tags": "Business, Cases" } },
        { "type": "theme", "settings": { "preview_style": "dark", "category": "Fashion Theme", "tags": "Fashion, Shop" } },
        { "type": "theme", "settings": { "preview_style": "light", "category": "Section Pack", "tags": "Sections, Editor" } },
        { "type": "cta", "settings": { "label": "Theme Store", "heading": "Alle Themes und Packs ansehen.", "button_label": "Zum Store" } }
      ]
    }
  ]
}
{% endschema %}
