{% comment %}
  Landing Orbit — services on the prologue's continued dark canvas
  ----------------------------------------------------------------
  Variation of the orbit metaphor, built for the dark landing
  canvas. Nodes sit on a faint ring; active node lands at the
  bottom in front of a "lens" that holds the active title and
  description. Keyboard navigation + cross-fading detail panel.

  Same accent + canvas language as landing-prologue, so the
  page reads as one continuous experience.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign block_count = section.blocks.size
-%}

{{ 'section-landing-orbit.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .lo {
    --lo-pad-top: {{ section.settings.padding_top }}px;
    --lo-pad-bottom: {{ section.settings.padding_bottom }}px;
    --lo-accent: {{ accent }};
    --lo-accent-soft: {{ accent | color_modify: 'alpha', 0.16 }};
    --lo-accent-glow: {{ accent | color_modify: 'alpha', 0.4 }};
    {%- if scheme.settings.background != blank -%}
      --lo-bg: {{ scheme.settings.background }};
      --lo-text: {{ scheme.settings.text }};
      --lo-muted: {{ scheme.settings.text | color_modify: 'alpha', 0.5 }};
      --lo-soft: {{ scheme.settings.text | color_modify: 'alpha', 0.7 }};
      --lo-line: {{ scheme.settings.text | color_modify: 'alpha', 0.1 }};
      --lo-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.22 }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="lo full-width color-scheme color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="landing-orbit"
  {% if section.settings.heading != blank %}aria-labelledby="lo-heading-{{ section.id }}"{% endif %}
>
  <div class="lo__atmosphere" aria-hidden="true">
    <span class="lo__aurora"></span>
    <span class="lo__grid"></span>
  </div>

  <div class="lo__inner">
    <header class="lo__intro">
      {%- if section.settings.kicker != blank -%}
        <p class="lo__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 id="lo-heading-{{ section.id }}" class="lo__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="lo__intro-body">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if block_count > 0 -%}
      <landing-orbit class="lo__stage" data-total="{{ block_count }}">
        <div class="lo__orbit" data-orbit>
          <div class="lo__ring lo__ring--outer" aria-hidden="true"></div>
          <div class="lo__ring lo__ring--inner" aria-hidden="true"></div>

          <svg class="lo__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line class="lo__connector" data-connector x1="50" y1="50" x2="50" y2="100"></line>
          </svg>

          <div class="lo__lens" aria-hidden="true">
            <span class="lo__lens-ring"></span>
            <span class="lo__lens-core"></span>
          </div>

          <div class="lo__center" aria-live="polite">
            {%- if section.settings.center_eyebrow != blank -%}
              <span class="lo__center-eyebrow">{{ section.settings.center_eyebrow | escape }}</span>
            {%- endif -%}
            <span class="lo__center-title" data-center-title>
              {{ section.blocks[0].settings.title | escape }}
            </span>
          </div>

          {%- for block in section.blocks -%}
            {%- assign label = block.settings.label | default: block.settings.title -%}
            <button
              type="button"
              class="lo__node{% if forloop.first %} is-active{% endif %}"
              data-node
              data-index="{{ forloop.index0 }}"
              aria-label="{{ block.settings.title | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="lo__node-icon" aria-hidden="true">
                {%- render 'services-overview-icon', name: block.settings.icon -%}
              </span>
              <span class="lo__node-label">{{ label | escape }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="lo__details">
          {%- for block in section.blocks -%}
            <article
              class="lo__panel{% if forloop.first %} is-active{% endif %}"
              data-panel
              data-index="{{ forloop.index0 }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.description != blank -%}
                <div class="lo__panel-text">{{ block.settings.description }}</div>
              {%- endif -%}

              {%- assign has_benefits = false -%}
              {%- if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank -%}
                {%- assign has_benefits = true -%}
              {%- endif -%}

              {%- if has_benefits -%}
                <ul class="lo__benefits">
                  {%- if block.settings.benefit_1 != blank -%}<li>{{ block.settings.benefit_1 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_2 != blank -%}<li>{{ block.settings.benefit_2 | escape }}</li>{%- endif -%}
                  {%- if block.settings.benefit_3 != blank -%}<li>{{ block.settings.benefit_3 | escape }}</li>{%- endif -%}
                </ul>
              {%- endif -%}

              {%- assign primary_label = block.settings.primary_label | default: section.settings.primary_label -%}
              {%- assign primary_url = block.settings.primary_url | default: section.settings.primary_url -%}
              {%- if primary_label != blank -%}
                <div class="lo__panel-actions">
                  <a class="lo__panel-cta" href="{{ primary_url | default: '#' }}">
                    {{ primary_label | escape }}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>

        <p class="lo__sr-live" data-live aria-live="polite"></p>
      </landing-orbit>
    {%- else -%}
      <p class="lo__placeholder">
        {{ 'landing_orbit.add_services' | t | default: 'Add service blocks to fill the orbit.' }}
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'landing-orbit.js' | asset_url }}" defer="defer"></script>

{% schema %}
