{% comment %}
  Hero Float — combined hero section
  ----------------------------------------------------------------
  - Headline + sub-headline (kept compact)
  - Halftone logo: image_picker centered between pulsing radar rings
    (no dot grid — pure rings)
  - 3D cover-flow carousel: center card is locked, side cards rotate
    away with depth. Prev/Next buttons + keyboard arrows.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign halftone_image = section.settings.halftone_image
  assign show_halftone = section.settings.show_halftone
  assign show_pulse = section.settings.show_pulse
  assign card_height = section.settings.card_height
  assign card_step = section.settings.card_step
  assign card_rotate = section.settings.card_rotate
  assign lock_position = section.settings.lock_position
  assign auto_rotate = section.settings.auto_rotate
  assign auto_rotate_seconds = section.settings.auto_rotate_seconds

  assign card_blocks_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_blocks_count = card_blocks_count | plus: 1
    endif
  endfor
  assign initial_index = card_blocks_count | divided_by: 2
-%}

<section
  class="hero-float full-width color-{{ scheme.id }}{% if show_pulse %} hero-float--pulse{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="hero-float"
  data-hf-step="{{ card_step }}"
  data-hf-rotate="{{ card_rotate }}"
  data-hf-lock="{{ lock_position }}"
  data-hf-auto="{{ auto_rotate }}"
  data-hf-auto-seconds="{{ auto_rotate_seconds }}"
  data-hf-initial="{{ initial_index }}"
  style="
    --hf-pad-top: {{ section.settings.padding_top }}px;
    --hf-pad-bottom: {{ section.settings.padding_bottom }}px;
    --hf-card-height: {{ card_height }}px;
  "
>
  <div class="hero-float__inner">
    <header class="hero-float__intro">
      {%- if heading != blank -%}
        <h1 class="hero-float__heading">{{ heading }}</h1>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="hero-float__subheading">{{ subheading }}</p>
      {%- endif -%}
    </header>

    {%- if show_halftone -%}
      <div class="hero-float__halftone" aria-hidden="true">
        <span class="hero-float__halftone-ring"></span>
        <span class="hero-float__halftone-ring"></span>
        <span class="hero-float__halftone-ring"></span>
        {%- if halftone_image != blank -%}
          {%- capture logo_class -%}hero-float__halftone-logo{%- endcapture -%}
          {%- assign logo_alt = halftone_image.alt | default: '' | escape -%}
          {{ halftone_image | image_url: width: 320 | image_tag:
            alt: logo_alt,
            class: logo_class,
            widths: '80, 120, 160, 240, 320',
            sizes: '(min-width: 990px) 140px, 100px',
            loading: 'lazy'
          }}
        {%- else -%}
          <svg class="hero-float__halftone-logo hero-float__halftone-logo--placeholder" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="2"/>
            <circle cx="50" cy="50" r="14" fill="currentColor" opacity="0.18"/>
            <circle cx="50" cy="50" r="5" fill="currentColor"/>
          </svg>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_blocks_count > 0 -%}
      <div class="hero-float__carousel" data-hf-carousel>
        <button
          type="button"
          class="hero-float__nav hero-float__nav--prev"
          data-hf-prev
          aria-label="{{ 'hero_float.prev' | t | default: 'Previous slide' }}"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="hero-float__stage" data-hf-stage>
          <ul class="hero-float__deck" data-hf-deck>
            {%- for block in section.blocks -%}
              {%- if block.type == 'card' -%}
                <li
                  class="hero-float__card"
                  data-hf-card
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.image != blank -%}
                    {%- capture card_class -%}hero-float__card-img{%- endcapture -%}
                    {%- assign card_alt = block.settings.image.alt | default: '' | escape -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag:
                      alt: card_alt,
                      class: card_class,
                      widths: '320, 480, 640, 800',
                      sizes: 'auto',
                      loading: 'lazy'
                    }}
                  {%- else -%}
                    <div class="hero-float__card-placeholder" aria-hidden="true">
                      {{ 'product-1' | placeholder_svg_tag: 'hero-float__card-placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <button
          type="button"
          class="hero-float__nav hero-float__nav--next"
          data-hf-next
          aria-label="{{ 'hero_float.next' | t | default: 'Next slide' }}"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- else -%}
      <p class="hero-float__placeholder">
        {{ 'hero_float.add_cards' | t | default: 'Add card blocks in the theme editor to fill the carousel.' }}
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'hero-float.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .hero-float {
    position: relative;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    padding: var(--hf-pad-top, 64px) var(--page-margin, 20px) var(--hf-pad-bottom, 64px);
    overflow: hidden;
  }
  .hero-float *,
  .hero-float *::before,
  .hero-float *::after { box-sizing: border-box; }

  .hero-float__inner {
    max-width: var(--page-width, 90rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  /* --- Intro --- */
  .hero-float__intro {
    text-align: center;
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hero-float__heading {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .hero-float__subheading {
    margin: 0;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground, #1a1a1a) 70%, transparent);
  }

  /* --- Halftone logo with pulsing rings (no dots) --- */
  .hero-float__halftone {
    position: relative;
    width: clamp(140px, 16vw, 200px);
    height: clamp(140px, 16vw, 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground, #1a1a1a);
    margin-top: 0.25rem;
  }
  .hero-float__halftone-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0;
    pointer-events: none;
  }
  .hero-float--pulse .hero-float__halftone-ring {
    animation: hf-ring-ping 5s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
  }
  .hero-float--pulse .hero-float__halftone-ring:nth-child(2) { animation-delay: 1.6s; }
  .hero-float--pulse .hero-float__halftone-ring:nth-child(3) { animation-delay: 3.2s; }
  @keyframes hf-ring-ping {
    0%   { transform: scale(0.45); opacity: 0; }
    20%  { opacity: 0.22; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  .hero-float__halftone-logo {
    position: relative;
    z-index: 2;
    width: 60%;
    max-width: 130px;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .hero-float__halftone-logo--placeholder {
    color: color-mix(in srgb, var(--color-foreground, #1a1a1a) 55%, transparent);
  }

  /* --- Cover-flow carousel --- */
  .hero-float__carousel {
    position: relative;
    width: 100%;
    margin-top: 0.5rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-float__nav {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    border: 1px solid color-mix(in srgb, var(--color-foreground, #1a1a1a) 18%, transparent);
    border-radius: 999px;
    cursor: pointer;
    z-index: 5;
    flex-shrink: 0;
    transition: background-color .15s ease, transform .15s ease, opacity .15s ease;
  }
  .hero-float__nav:hover {
    background: color-mix(in srgb, var(--color-foreground, #1a1a1a) 6%, transparent);
  }
  .hero-float__nav:active { transform: scale(0.95); }
  .hero-float__nav[disabled] { opacity: 0.35; cursor: not-allowed; }

  .hero-float__stage {
    position: relative;
    width: 100%;
    height: calc(var(--hf-card-height, 320px) + 80px);
    perspective: 1400px;
    perspective-origin: 50% 55%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .hero-float__deck {
    position: relative;
    width: 100%;
    height: 100%;
    list-style: none;
    padding: 0;
    margin: 0;
    transform-style: preserve-3d;
  }

  .hero-float__card {
    position: absolute;
    top: 50%;
    left: 50%;
    height: var(--hf-card-height, 320px);
    width: auto;
    border-radius: 20px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-foreground, #1a1a1a) 4%, transparent);
    box-shadow:
      0 30px 60px -20px color-mix(in srgb, var(--color-foreground, #1a1a1a) 40%, transparent),
      0 12px 24px -10px color-mix(in srgb, var(--color-foreground, #1a1a1a) 22%, transparent);
    transform: translate(-50%, -50%) translate3d(0, 0, 0) rotateY(0deg);
    transform-origin: center center;
    transition: transform .65s cubic-bezier(0.2, 0.85, 0.3, 1),
                opacity .45s ease,
                filter .55s ease;
    will-change: transform, filter;
    backface-visibility: hidden;
  }
  .hero-float__card.is-active {
    z-index: 20;
  }

  .hero-float__card-img,
  .hero-float__card-placeholder {
    display: block;
    height: 100%;
    width: auto;
    object-fit: cover;
    pointer-events: none;
  }
  .hero-float__card-placeholder {
    width: calc(var(--hf-card-height, 320px) * 1.35);
    color: color-mix(in srgb, var(--color-foreground, #1a1a1a) 25%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-float__card-placeholder-svg {
    width: 55%;
    height: 55%;
  }

  .hero-float__placeholder {
    padding: 2rem;
    text-align: center;
    color: color-mix(in srgb, var(--color-foreground, #1a1a1a) 60%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-foreground, #1a1a1a) 20%, transparent);
    border-radius: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-float--pulse .hero-float__halftone-ring {
      animation: none !important;
    }
    .hero-float__card {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero float",
  "tag": "section",
  "class": "shopify-section--hero-float",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Designing world-class products in California"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "We help early-stage SaaS founders craft premium, investor-ready brands and product experiences."
    },
    {
      "type": "header",
      "content": "Halftone logo"
    },
    {
      "type": "checkbox",
      "id": "show_halftone",
      "label": "Show halftone logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "halftone_image",
      "label": "Logo image",
      "info": "PNG / SVG without text label. Sits centered between the pulsing rings."
    },
    {
      "type": "checkbox",
      "id": "show_pulse",
      "label": "Pulse animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Cover-flow carousel"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "min": 240,
      "max": 520,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "card_step",
      "label": "Spacing between cards",
      "info": "Horizontal distance between neighbouring cards in pixels.",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "card_rotate",
      "label": "Side card rotation",
      "info": "How much side cards tilt away from the active one (capped at 78° for far cards).",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "°",
      "default": 32
    },
    {
      "type": "range",
      "id": "lock_position",
      "label": "Lock position",
      "info": "Horizontal position of the active card within the carousel. 50 % = center; lower values push it left so more cards extend to the right.",
      "min": 15,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_rotate_seconds",
      "label": "Auto-rotate interval",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Tall mockups (phone) or wide ones (laptop) — cards keep a fixed height and let width follow the image's aspect ratio."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero float",
      "category": "Hero",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
