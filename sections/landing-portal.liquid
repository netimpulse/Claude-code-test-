{% comment %}
  Landing Portal — theme-store preview on the prologue canvas
  ----------------------------------------------------------------
  Continues the dark canvas + accent language of the prologue and
  orbit. Renders a heading + subheading and a horizontal scroll-
  snap carousel of theme cards with prev/next arrows. Cards have
  hover lift + accent glow. CTA at the bottom links to the full
  theme store.

  Top edge fades in from the previous section so the page reads
  as one continuous experience.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign source = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign heading = section.settings.heading
  assign highlight = section.settings.heading_highlight
  assign subheading = section.settings.subheading
  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url
  assign details_label = section.settings.details_label
  assign show_price = section.settings.show_price
  assign show_details = section.settings.show_details
  assign card_radius = section.settings.card_radius
  assign card_aspect = section.settings.card_aspect

  assign heading_html = heading
  if highlight != blank and heading contains highlight
    assign accent_span = '<span class="lpr__heading-accent">' | append: highlight | append: '</span>'
    assign heading_html = heading | replace: highlight, accent_span
  endif
-%}

{{ 'section-landing-portal.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    {%- if scheme.settings.background != blank -%}
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
    {%- endif -%}
  }
  #shopify-section-{{ section.id }} .lpr {
    --lpr-pad-top: {{ section.settings.padding_top }}px;
    --lpr-pad-bottom: {{ section.settings.padding_bottom }}px;
    --lpr-radius: {{ card_radius }}px;
    --lpr-card-aspect: {{ card_aspect }};
    --lpr-accent: {{ accent }};
    --lpr-accent-soft: {{ accent | color_modify: 'alpha', 0.16 }};
    --lpr-accent-glow: {{ accent | color_modify: 'alpha', 0.42 }};
    {%- if scheme.settings.background != blank -%}
      --lpr-bg: {{ scheme.settings.background }};
      --lpr-text: {{ scheme.settings.text }};
      --lpr-muted: {{ scheme.settings.text | color_modify: 'alpha', 0.5 }};
      --lpr-soft: {{ scheme.settings.text | color_modify: 'alpha', 0.7 }};
      --lpr-line: {{ scheme.settings.text | color_modify: 'alpha', 0.1 }};
      --lpr-line-strong: {{ scheme.settings.text | color_modify: 'alpha', 0.22 }};
    {%- endif -%}
  }
{% endstyle %}

<section
  class="lpr full-width color-scheme color-{{ scheme.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="landing-portal"
>
  <div class="lpr__atmosphere" aria-hidden="true">
    <span class="lpr__aurora"></span>
    <span class="lpr__grid"></span>
  </div>

  <div class="lpr__inner">
    <header class="lpr__header">
      <div class="lpr__intro">
        {%- if section.settings.kicker != blank -%}
          <p class="lpr__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="lpr__heading">{{ heading_html }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="lpr__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="lpr__nav" data-lpr-nav>
        <button
          type="button"
          class="lpr__nav-btn"
          data-lpr-prev
          aria-label="{{ 'landing_portal.prev' | t | default: 'Previous theme' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="lpr__nav-btn"
          data-lpr-next
          aria-label="{{ 'landing_portal.next' | t | default: 'Next theme' }}"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </header>

    {%- if source != blank and source.products.size > 0 -%}
      <ul class="lpr__track" data-lpr-track>
        {%- for product in source.products limit: products_to_show -%}
          <li class="lpr__card">
            <a class="lpr__card-link" href="{{ product.url }}">
              <div class="lpr__media">
                {%- if product.featured_image -%}
                  {%- render 'image',
                    image: product.featured_image,
                    class: 'lpr__media-img',
                    width: 640,
                    height: 480,
                    crop: 'center'
                  -%}
                {%- else -%}
                  <div class="lpr__media-placeholder" aria-hidden="true">
                    {{ 'product-1' | placeholder_svg_tag: 'lpr__placeholder-svg' }}
                  </div>
                {%- endif -%}
                <span class="lpr__scan" aria-hidden="true"></span>
              </div>
              <div class="lpr__body">
                <h3 class="lpr__title">{{ product.title | escape }}</h3>
                <div class="lpr__meta">
                  {%- if show_price -%}
                    <span class="lpr__price">{{ product.price | money }}</span>
                  {%- endif -%}
                  {%- if show_details -%}
                    <span class="lpr__details">
                      {{ details_label | default: 'Details' | escape }}
                      <span aria-hidden="true">→</span>
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="lpr__placeholder">
        {{ 'landing_portal.add_collection' | t | default: 'Pick a collection in the theme editor to preview themes here.' }}
      </p>
    {%- endif -%}

    {%- if cta_label != blank -%}
      <div class="lpr__footer">
        <a class="lpr__cta" href="{{ cta_url | default: '#' }}">
          <span>{{ cta_label | escape }}</span>
          <span class="lpr__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('[data-lpr-track]');
    var prev = root.querySelector('[data-lpr-prev]');
    var next = root.querySelector('[data-lpr-next]');
    if (!track || !prev || !next) return;

    function step() {
      var card = track.querySelector('.lpr__card');
      if (!card) return track.clientWidth * 0.8;
      var styles = window.getComputedStyle(track);
      var gap = parseFloat(styles.columnGap || styles.gap || 0) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 1;
      prev.toggleAttribute('disabled', track.scrollLeft <= 0);
      next.toggleAttribute('disabled', track.scrollLeft >= max);
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Landing portal",
  "tag": "section",
  "class": "shopify-section--landing-portal",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "03 · Theme-Store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium-Themes, direkt aus dem Atelier."
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted word",
      "info": "Word inside the heading that gets the italic accent style. Must match exactly.",
      "default": "Atelier"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Eine Auswahl unserer Themes — getestet im Studio, gebaut für echte Conversion."
    },
    {
      "type": "header",
      "content": "Source"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Themes collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Themes to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show details link",
      "default": true
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Details link label",
      "default": "Details"
    },
    {
      "type": "select",
      "id": "card_aspect",
      "label": "Card image aspect",
      "options": [
        { "value": "16 / 10", "label": "Wide (16:10)" },
        { "value": "4 / 3", "label": "Standard (4:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Zum Theme-Store"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#9ccfd0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Landing portal",
      "category": "Theme store"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
