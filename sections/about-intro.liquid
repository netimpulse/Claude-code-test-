{% comment %}
  About — Intro (Über uns, Plan S7a)
  ----------------------------------------------------------------
  Opening section of the About page and therefore its only h1:
  eyebrow + h1 (accent-heading, `*Wort*` = serif accent) + rich text
  body + optional primary button. With a photo the layout is 7/5
  columns (photo 4:5, --r-lg); without a photo the section drops the
  image column and becomes an editorial layout (headline on top, body
  offset to the right under a hairline) – no grey placeholder. In the
  theme editor a subtle hint explains where the photo would go.

  Colours come from the colour scheme tokens (--color-*). accent_color
  is optional (empty = scheme accent) and only tints the eyebrow dot.
  Padding: min(setting, --section-y) – the setting acts as an upper bound.
{% endcomment %}

{%- liquid
  assign scheme = section.settings.color_scheme
  assign accent = section.settings.accent_color
  assign has_photo = false
  if section.settings.photo != blank
    assign has_photo = true
  endif
  assign has_chips = false
  if section.settings.chip_1_value != blank or section.settings.chip_2_value != blank
    assign has_chips = true
  endif
-%}

{{ 'section-about-intro.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --fs-heading: {{ section.settings.heading_scale | default: 100 | divided_by: 100.0 }};
    --fs-text: {{ section.settings.text_scale | default: 100 | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .about-intro {
    {%- if accent != blank %}--ai-accent: {{ accent }};{% endif %}
    --ai-padding-top: {{ section.settings.padding_top }}px;
    --ai-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section
  class="about-intro full-width{% if scheme %} color-{{ scheme.id }}{% endif %}{% if has_photo %} about-intro--media{% else %} about-intro--text-only{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.heading != blank %}aria-labelledby="ai-heading-{{ section.id }}"{% endif %}
>
  <div class="about-intro__inner">
    <div class="about-intro__grid">
      <div class="about-intro__head">
        {%- if section.settings.kicker != blank -%}
          <p class="about-intro__kicker eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 id="ai-heading-{{ section.id }}" class="about-intro__heading">
            {%- render 'accent-heading', text: section.settings.heading -%}
          </h1>
        {%- endif -%}
      </div>

      <div class="about-intro__content">
        {%- if section.settings.body != blank -%}
          <div class="about-intro__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="about-intro__actions">
            <a class="btn btn--primary about-intro__btn" href="{{ section.settings.cta_url | default: '#' }}">
              <span>{{ section.settings.cta_label | escape }}</span>
              <span class="btn__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if has_photo or has_chips or request.design_mode -%}
        <div class="about-intro__media">
          {%- if has_photo -%}
            <div class="about-intro__frame">
              {%- assign heading_plain = section.settings.heading | remove: '*' -%}
              {%- assign photo_alt = section.settings.photo.alt | default: heading_plain -%}
              {{
                section.settings.photo
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 861px) 40vw, 100vw',
                  alt: photo_alt,
                  class: 'about-intro__image'
              }}
            </div>
          {%- elsif request.design_mode -%}
            <p class="about-intro__editor-hint">{{ 'about_intro.editor_photo_hint' | t }}</p>
          {%- endif -%}

          {%- if has_chips -%}
            <ul class="about-intro__chips" role="list">
              {%- if section.settings.chip_1_value != blank -%}
                <li class="about-intro__chip">
                  <span class="about-intro__chip-value">{{ section.settings.chip_1_value | escape }}</span>
                  {%- if section.settings.chip_1_label != blank -%}
                    <span class="about-intro__chip-label">{{ section.settings.chip_1_label | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
              {%- if section.settings.chip_2_value != blank -%}
                <li class="about-intro__chip">
                  <span class="about-intro__chip-value">{{ section.settings.chip_2_value | escape }}</span>
                  {%- if section.settings.chip_2_label != blank -%}
                    <span class="about-intro__chip-label">{{ section.settings.chip_2_label | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:about_intro.name",
  "tag": "section",
  "class": "shopify-section--about-intro",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:about_intro.kicker_label",
      "default": "Über uns"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:about_intro.heading_label",
      "info": "Setze ein Wort in *Sternchen*, um es als Serif-Akzent hervorzuheben. Diese Überschrift ist das h1 der Seite.",
      "default": "Wir bauen digitale Strukturen, die im Alltag halten."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:about_intro.body_label",
      "default": "<p>NetImpulse verbindet Strategie, Design, SEO/SEA und Shopify-Entwicklung in einem Team. Wir arbeiten direkt mit den Menschen, die unsere Arbeit verantworten – und liefern Ergebnisse, die nicht nur gut aussehen, sondern messbar wirken.</p>"
    },
    {
      "type": "header",
      "content": "t:about_intro.cta_header"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:about_intro.cta_label_label",
      "default": "Projekt anfragen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:about_intro.cta_url_label"
    },
    {
      "type": "header",
      "content": "t:about_intro.media_header"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "t:about_intro.photo_label",
      "info": "Ohne Bild erscheint die Section ohne Bildspalte (Text-Layout)."
    },
    {
      "type": "text",
      "id": "chip_1_value",
      "label": "t:about_intro.chip_value_label",
      "default": "Seit 2019"
    },
    {
      "type": "text",
      "id": "chip_1_label",
      "label": "t:about_intro.chip_label_label",
      "default": "im Markt"
    },
    {
      "type": "text",
      "id": "chip_2_value",
      "label": "t:about_intro.chip_value_label",
      "default": "120+"
    },
    {
      "type": "text",
      "id": "chip_2_label",
      "label": "t:about_intro.chip_label_label",
      "default": "Projekte"
    },
    {
      "type": "header",
      "content": "t:about_intro.appearance_header"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:about_intro.color_scheme_label",
      "default": "scheme-sand"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:about_intro.accent_color_label",
      "info": "Farbe des Punkts vor dem Kicker. Leer lassen, um den Akzent des Color Schemes zu verwenden."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:about_intro.padding_top_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:about_intro.padding_bottom_label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:about_intro.name",
      "category": "t:general.section"
    }
  ]
}
{% endschema %}
